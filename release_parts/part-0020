    return { added };
  }

  function rpcmRollbackDesiredPending(room,before,attempted) {
    const live=room.pending;
    if(!before||!attempted||!live||String(live.messageId)!==String(attempted.messageId))return false;
    const merged=rpcmKeepLateEdits(attempted,live,before);
    const actual=live.lastVerifiedItems;
    if(Array.isArray(actual)){
      stampVerifiedPendingSnapshot(merged,actual,live.lastVerifiedContextBlock||'');
      merged.verified=JSON.stringify(activePendingItems(merged))===JSON.stringify(actual);
      if(!merged.verified)merged.verifiedAt=null;
    }
    room.pending=merged;savePendingBackup(room.chatId,merged);return true;
  }

  function rpcmCarrierItemsSignature(items) {
    // Match the fitter's group layout and chronological log ordering.
    // Preserve user order within base/lore groups, nested arrays, exact text and counters.
    const stable=value=>Array.isArray(value)?value.map(stable):Object.prototype.toString.call(value)==='[object Object]'?
      Object.fromEntries(Object.keys(value).sort().map(key=>[key,stable(value[key])])):value;
    const all=items||[],isLog=item=>item?.sourceSlotId==='logSummary'||item?.group==='log-auto'||item?.slotId==='logSummary';
    const fittedOrder=[...all.filter(item=>!isLog(item)&&item?.group!=='lore'),
      ...all.filter(item=>!isLog(item)&&item?.group==='lore'),
      ...all.filter(isLog).sort((a,b)=>Number(a.logIndex||0)-Number(b.logIndex||0))];
    return JSON.stringify(fittedOrder.map(stable));
