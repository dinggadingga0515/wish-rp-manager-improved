  function normalizeStoryLogReviews(room) {
    if (!room || typeof room !== 'object') return [];
    const log = (room.slots || []).find(slot => slot.id === 'logSummary');
    const blocks = parseDatedLogBlocks(String(log?.content || ''));
    const old = Array.isArray(room.storyLogReviews) ? room.storyLogReviews.filter(item => item && typeof item === 'object') : [];
    const byKey = new Map(old.map(item => [String(item.blockKey || ''), item]));
    const calendarBuckets=new Map();
    for(const item of old){const key=JSON.stringify([String(item.calendarDateKey||''),String(item.timelineKey||'')]);if(!calendarBuckets.has(key))calendarBuckets.set(key,[]);calendarBuckets.get(key).push(item);}
    const usedIds = new Set();
    const next = [];
    for (const block of blocks) {
      let meta = byKey.get(String(block.key));
      if (!meta) {
        const candidates = (calendarBuckets.get(JSON.stringify([String(block.calendarDateKey||''),String(block.timelineKey||'')]))||[]).filter(item=>!usedIds.has(String(item.logId)));
        if (candidates.length === 1) meta = candidates[0];
      }
      const fingerprint = storyLogFingerprint(block);
      const changed = !!meta && String(meta.fingerprint || '') !== fingerprint;
      let logId = String(meta?.logId || '');
      if (!/^log_[A-Za-z0-9_-]+$/.test(logId) || usedIds.has(logId)) logId = makeStoryLogId();
      usedIds.add(logId);
      next.push({
        logId,
        blockKey:String(block.key),
        calendarDateKey:String(block.calendarDateKey || ''),
        timelineKey:String(block.timelineKey || ''),
        fingerprint,
        version:Math.max(1, Number(meta?.version || 1) + (changed ? 1 : 0)),
        reviewedVersion:Math.max(0, Number(meta?.reviewedVersion || 0)),
        createdAt:String(meta?.createdAt || nowIso()),
        updatedAt:changed ? nowIso() : String(meta?.updatedAt || meta?.createdAt || nowIso()),
      });
    }
    room.storyLogReviews = next;
    room.storyLogReviewRevisionV1 = true;
    const existingStoryGuide = String(room.storyTimelineGuide || '');
    // Only missing or fingerprint-matched official bodies move to the current builtin.
    // A user-edited body remains unchanged even when its title names an older version.
    const builtInStoryGuideHashes = new Set(['kqpc9i', '1qc4n6u', 'mlc1go']);
    const exactLegacyBuiltIn = !existingStoryGuide || builtInStoryGuideHashes.has(simpleHash(existingStoryGuide)) ||
      existingStoryGuide === STORY_TIMELINE_GUIDE_V15 || existingStoryGuide === LEGACY_CANONICAL_GUIDES.timeline ||
      existingStoryGuide === PREVIOUS_CANONICAL_GUIDES_V01456.timeline || existingStoryGuide === canonicalGuideText('timeline');
    if (exactLegacyBuiltIn) {
      room.storyTimelineGuide = canonicalGuideText('timeline');
      room.storyTimelineGuideSource = 'builtin-v1.7.2';
    } else {
      room.storyTimelineGuide = existingStoryGuide;
      room.storyTimelineGuideSource = 'custom';
    }
    room.storyTimelineGuideRevisionV15 = true;
    if (!room.storyTimelinePendingReview || typeof room.storyTimelinePendingReview !== 'object') room.storyTimelinePendingReview = null;
    room.storyTimelineLastReviewedMessageId = String(room.storyTimelineLastReviewedMessageId || '');
    room.storyTimelineLastReviewedAt = String(room.storyTimelineLastReviewedAt || '');
    if (!room.storyTimelineReviewSettings || typeof room.storyTimelineReviewSettings !== 'object') room.storyTimelineReviewSettings = {};
    room.storyTimelineReviewSettings = {
      threshold:[30,50,100].includes(Number(room.storyTimelineReviewSettings.threshold)) ? Number(room.storyTimelineReviewSettings.threshold) : Math.max(1, Number(room.storyTimelineReviewSettings.threshold) || 50),
      menuBadge:room.storyTimelineReviewSettings.menuBadge !== false,
      topNotice:room.storyTimelineReviewSettings.topNotice !== false,
      popup:!!room.storyTimelineReviewSettings.popup,
      dateIndicator:room.storyTimelineReviewSettings.dateIndicator !== false,
      monthlyFold:room.storyTimelineReviewSettings.monthlyFold !== false,
      monthlyFoldMin:Math.max(2, Math.min(100, Number(room.storyTimelineReviewSettings.monthlyFoldMin) || 8)),
    };
    if (!Array.isArray(room.storyTimelineLastDiff)) room.storyTimelineLastDiff = [];
    if (!room.storyTimelineBackup || typeof room.storyTimelineBackup !== 'object' || !Array.isArray(room.storyTimelineBackup.cards)) room.storyTimelineBackup = null;
    if (!room.storyTimelineApiDraft || typeof room.storyTimelineApiDraft !== 'object') room.storyTimelineApiDraft = null;
    room.storyTimelineApiHistory = (Array.isArray(room.storyTimelineApiHistory) ? room.storyTimelineApiHistory : []).filter(item => item && typeof item === 'object').slice(0, 10);
    room.storyTimelineAuditHistory = (Array.isArray(room.storyTimelineAuditHistory) ? room.storyTimelineAuditHistory : []).filter(item => item && typeof item === 'object').slice(0, 50);
    if (!room.storyTimelineManualRun || typeof room.storyTimelineManualRun !== 'object') room.storyTimelineManualRun = null;
    room.storyTimelineCarryoverTurnKeys = (Array.isArray(room.storyTimelineCarryoverTurnKeys) ? room.storyTimelineCarryoverTurnKeys : []).map(String).slice(-40);
    const nextByKey=new Map();for(const item of next)if(!nextByKey.has(item.blockKey))nextByKey.set(item.blockKey,item);
    return blocks.map(block => {
      const meta = nextByKey.get(String(block.key));
      const status = !meta?.reviewedVersion ? 'new' : Number(meta.reviewedVersion) < Number(meta.version) ? 'modified' : 'reviewed';
      return { block, meta, status };
    });
  }

