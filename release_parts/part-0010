    // UI-only windowing: the complete vm.facts is still available to memory search,
    // source verification, editing, and injection; only DOM construction is paged.
    const readerWindowed = !selected && pane === 'knowledge';
    const factPageSize = 18;
    const factPageCount = Math.max(1,Math.ceil(vm.facts.length/factPageSize));
    const factPage = Math.max(0,Math.min(factPageCount-1, Number(state.personCoreFactPage)||0));
    state.personCoreFactPage = factPage;
