  async function aiMemorySyncPending(room,area) {
    if(!room.pending)return;
    if(area==='personInfo')return rebuildPendingKnowledgeItem(room);
    if(area==='timeline')return rebuildPendingStoryTimelineItem(room,'ai-memory-timeline');
    if(area==='logSummary')return rebuildPendingLogItems(room,'ai-memory-log');
    const pendingBefore=rpcmRoomClone(room.pending);
    if(area==='lore'){
      const previous=clonePendingItems(room.pending.items);
      refreshPendingLoreItems(room);const attemptedPending=rpcmRoomClone(room.pending);
      try{return await syncPendingCarrier(room,'ai-memory-lore');}
      catch(error){if(rpcmRollbackDesiredPending(room,pendingBefore,attemptedPending))await saveRoom(room).catch(()=>{});throw error;}
    }
    const previous=structuredClone(room.pending);
    const slots=new Map((room.slots||[]).map(slot=>[String(slot.id),slot]));
    for(const field of ['items','quickRemovedItems'])if(Array.isArray(room.pending[field]))room.pending[field]=room.pending[field].map(item=>{
      const slot=slots.get(String(item.slotId||''));
      if(!slot || (area==='currentState'?slot.id!=='currentState':slot.group!=='item'))return item;
      return {...item,title:slot.title,content:String(slot.content||'').trim()};
    });
    savePendingBackup(room.chatId,room.pending);
    const attemptedPending=rpcmRoomClone(room.pending);
    try{return await syncPendingCarrier(room,`ai-memory-${area}`);}
    catch(error){if(rpcmRollbackDesiredPending(room,pendingBefore,attemptedPending))await saveRoom(room).catch(()=>{});throw error;}
  }

  async function aiMemoryUndo(room,area) {
    const config=aiMemoryConfig(room),index=config.undo.map(entry=>entry.area).lastIndexOf(area);
    if(index<0)throw new Error('이 항목에 되돌릴 AI 적용 기록이 없습니다.');
    const entry=config.undo[index];
    if(aiMemoryAreaSnapshot(room,area)!==JSON.stringify(entry.after))throw new Error('AI apply was followed by a manual edit. Undo is blocked to protect it.');
    if(!confirm(`${AI_MEMORY_AREAS[area].label}의 직전 AI 적용 내용과 AI 기준점을 되돌릴까요? 현재 저장본의 이후 수동 편집은 덮어쓸 수 있습니다.`))return;
    const undoBase=JSON.stringify(room);
    const stored=await readManualStoredRoom(room);
    if(JSON.stringify(stored)!==JSON.stringify(room))throw new Error('저장본이 바뀌었습니다. 다시 열어 확인해 주세요.');
    const candidate=structuredClone(room),slots=candidate.slots||[],previous=structuredClone(entry.previous);
    if(area==='currentState'){const i=slots.findIndex(slot=>slot.id==='currentState');if(i>=0&&previous)slots[i]=previous;}
    else if(area==='importantItems')candidate.slots=slots.filter(slot=>slot.group!=='item').concat(previous||[]);
    else if(area==='logSummary'){
      const i=slots.findIndex(slot=>slot.id==='logSummary');if(i>=0&&previous?.slot)slots[i]=previous.slot;
      candidate.autoLogPinnedKeys=previous?.pinned||[];candidate.manualLogSelectedKeys=previous?.selected||[];
    }else if(area==='personInfo'){candidate.knowledgeCards=previous?.knowledge||[];candidate.personStateRecords=previous?.records||[];}
    else if(area==='lore')candidate.lorePacks=previous||[];
    else if(area==='timeline'){candidate.storyTimelineCards=previous?.cards||[];candidate.storyTimelineLastReviewedMessageId=previous?.reviewed||'';}
    const target=aiMemoryConfig(candidate).areas[area];target.cursor=entry.cursor;target.baseline=entry.baseline;target.appliedAt=entry.appliedAt;target.lastAppliedStart=entry.lastAppliedStart;target.lastAppliedEnd=entry.lastAppliedEnd;target.lastAttemptKey=entry.lastAttemptKey||'';target.failedEnd='';candidate.aiMemorySourceAnchors||={};if(entry.sourceAnchor)candidate.aiMemorySourceAnchors[area]=structuredClone(entry.sourceAnchor);else delete candidate.aiMemorySourceAnchors[area];target.status='되돌림';target.draft=null;
    candidate.aiMemoryAutomation.undo.splice(index,1);candidate.updatedAt=nowIso();
    await stampVerifiedResult(candidate,AI_MEMORY_AREAS[area].manual,'ai-memory-undo');
    const writeStartedAt=nowIso();
    await new Promise((resolve,reject)=>{const tx=state.db.transaction(APP.storeName,'readwrite'),store=tx.objectStore(APP.storeName),request=store.get(room.chatId);request.onsuccess=()=>{if(JSON.stringify(request.result||null)!==JSON.stringify(stored)||JSON.stringify(room)!==undoBase){traceRoomWrite(candidate,'ai-memory-undo:'+area,'stale-rejected',room._rpcmRevision,request.result?._rpcmRevision,'',{startedAt:writeStartedAt,before:request.result||{}});tx.abort();return;}candidate._rpcmRevision=Number(request.result?._rpcmRevision||0)+1;store.put(candidate);};request.onerror=()=>tx.abort();tx.oncomplete=()=>{traceRoomWrite(candidate,'ai-memory-undo:'+area,'committed',room._rpcmRevision,candidate._rpcmRevision,'',{startedAt:writeStartedAt,before:stored});resolve();};tx.onabort=()=>reject(new Error('저장본 변경 또는 IndexedDB 실패 · 되돌리지 않았습니다.'));});
    const verifiedUndo=await readManualStoredRoom(room);
    if(!verifiedUndo||aiMemoryAreaSnapshot(verifiedUndo,area)!==aiMemoryAreaSnapshot(candidate,area))throw new Error('되돌린 결과를 IndexedDB에서 확인하지 못했습니다.');
    const finalizedUndo=await finalizeStoredResultReceipts(room,verifiedUndo,[AI_MEMORY_AREAS[area].manual],'ai-memory-undo:'+area);
    const lateEdits=JSON.stringify(room)!==undoBase;rpcmReplaceRoomObject(room,rpcmKeepLateEdits(JSON.parse(undoBase),room,finalizedUndo));rpcmRememberRoomBaseline(finalizedUndo);if(lateEdits)await saveRoom(room,'ai-memory-undo-late-edits');if(room.pending){try{const result=await aiMemorySyncPending(room,area);if(result?.suspended||room.pending?.reanchorRetry)notify('로컬 되돌리기 완료 · 현재 주입 반영 대기','warn');}catch(error){notify(`로컬 되돌리기 완료 · 현재 주입 반영 대기: ${error.message}`,'warn');}}
  }

  function bindAiMemoryPreferences(overlay,room) {
    const config=aiMemoryConfig(room);
    const policyControls=[overlay.querySelector('[data-ai-memory-global]'),
      ...overlay.querySelectorAll('[data-ai-memory-enable]'),
      ...overlay.querySelectorAll('[data-ai-memory-auto-apply]'),
      ...overlay.querySelectorAll('[data-ai-memory-interval]')].filter(Boolean);
    const policySaves=bindAiMemoryPreferences.policySaves ||= new Set(),policyKey=String(room.chatId);
    if(policySaves.has(policyKey))policyControls.forEach(input=>input.disabled=true);
    const savePolicyControl=async work=>{
      if(policySaves.has(policyKey))return;
      policySaves.add(policyKey);const disabled=new Map(policyControls.map(input=>[input,input.disabled]));
      policyControls.forEach(input=>input.disabled=true);
      try{await work();}
      finally{
        const current=aiMemoryConfig(room);
        for(const input of policyControls){
          if(input.dataset?.aiMemoryEnable)input.checked=current.areas[input.dataset.aiMemoryEnable].enabled;
          else if(input.dataset?.aiMemoryAutoApply)input.checked=current.areas[input.dataset.aiMemoryAutoApply].autoApply;
          else if(input.dataset?.aiMemoryInterval)input.value=String(current.areas[input.dataset.aiMemoryInterval].interval);
          else input.checked=current.enabled;
          input.disabled=disabled.get(input);
        }
        policySaves.delete(policyKey);
        try{renderModalIfOpen();}
        catch(error){notify('설정 화면 갱신 실패: '+error.message+' · 저장된 설정을 다시 확인해 주세요.','error');}
      }
    };
    overlay.querySelector('[data-ai-memory-global]')?.addEventListener('change',event=>savePolicyControl(async()=>{
      const input=event.currentTarget,config=aiMemoryConfig(room),previous=config.enabled,revision=config.applyRevision;input.disabled=true;let saved=false;
      config.enabled=input.checked;config.applyRevision++;
      try{await saveRoom(room);saved=true;}
      catch(error){config.enabled=previous;config.applyRevision=revision;input.checked=previous;notify('자동 생성 설정 저장 실패: '+error.message,'error');}
      finally{if(input.isConnected)input.disabled=false;}
      if(saved&&config.enabled)void aiMemoryPoll(room,true);
    }));
    overlay.querySelectorAll('[data-ai-memory-enable]').forEach(input=>input.addEventListener('change',()=>savePolicyControl(()=>aiMemorySetEnabled(room,input.dataset.aiMemoryEnable,input.checked,input))));
    overlay.querySelectorAll('[data-ai-memory-auto-apply]').forEach(input=>input.addEventListener('change',()=>savePolicyControl(async()=>{
      const row=aiMemoryConfig(room).areas[input.dataset.aiMemoryAutoApply],previous=row.autoApply;let saved=false;
      row.autoApply=input.checked;row.applyRevision++;
      try{await saveRoom(room);saved=true;}
      catch(error){row.autoApply=previous;input.checked=previous;notify(error.message,'error');}
      if(saved)notify(row.autoApply?'이후 생성되는 유효한 AI 결과는 자동 반영합니다. 기존 초안은 검토 후 적용해 주세요.':'수동 검토 모드 · 기존 초안과 기준점은 유지합니다.','success');
    })));
    overlay.querySelectorAll('[data-ai-memory-interval]').forEach(input=>input.addEventListener('change',()=>savePolicyControl(async()=>{
      const area=input.dataset.aiMemoryInterval,row=aiMemoryConfig(room).areas[area],value=Number(input.value),previous=row.interval;
      if(!Number.isInteger(value)||value<1||value>100){input.value=String(previous);notify('주기는 1~100 완료 턴으로 지정해 주세요.','warn');return;}
      row.interval=value;
      try{await saveRoom(room);}
      catch(error){row.interval=previous;input.value=String(previous);notify('자동 정리 주기 저장 실패: '+error.message,'error');}
    })));
    overlay.querySelectorAll('[data-ai-memory-run]').forEach(button=>button.addEventListener('click',async()=>{button.disabled=true;try{const area=button.dataset.aiMemoryRun,row=aiMemoryConfig(room).areas[area];if(row.draft&&!confirm('기존 미적용 초안을 버리고 새로 생성할까요?'))return;await aiMemoryGenerate(room,area,{force:true,replaceDraft:true});}catch(error){notify(`AI 기억정리 실패: ${error.message}`,'error',6500);}finally{if(button.isConnected)button.disabled=false;}}));
    overlay.querySelectorAll('[data-ai-memory-review]').forEach(button=>button.addEventListener('click',()=>aiMemoryReviewDialog(room,button.dataset.aiMemoryReview)));
    overlay.querySelectorAll('[data-ai-memory-undo]').forEach(button=>button.addEventListener('click',async()=>{try{await aiMemoryUndo(room,button.dataset.aiMemoryUndo);renderModalIfOpen();notify('AI 적용 내용과 해당 항목 기준점을 함께 되돌렸습니다.','success');}catch(error){notify(`되돌리기 실패: ${error.message}`,'error');}}));
    overlay.querySelectorAll('[data-ai-memory-now]').forEach(button=>button.addEventListener('click',async()=>{
