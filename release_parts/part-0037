        .rpcm-ai-context-situation,
        .rpcm-ai-context-raw,
        .rpcm-guide-panel,
        .rpcm-read-card,
        .rpcm-read-card>summary,
        .rpcm-person-advanced,
        .rpcm-global-status,
        .rpcm-carrier-card
      ){
        border-color:var(--wish-deep-line)!important;
      }
      #rpcm-modal :is(
        .rpcm-main-help-panel,
        .rpcm-header-search-pop,
        .rpcm-guide-panel,
        .rpcm-read-card,
        .rpcm-read-card>summary
      ){
        color:var(--wish-deep-fg)!important;
      }

      /* v0.14.67 · Brown is an accent surface, not a default content surface.
         Restore ordinary content cards to the normal light theme. */

      /* 1) Usage breakdown: stronger text, softer separators. */
      #rpcm-modal .rpcm-summary-capacity-detail{
        color:var(--wish-fg-2)!important;
        opacity:1!important;
      }
      #rpcm-modal .rpcm-breakdown{
        border-color:var(--wish-line)!important;
      }
      #rpcm-modal .rpcm-breakdown-chip{
        border-color:var(--wish-line)!important;
        color:var(--wish-fg-2)!important;
        opacity:1!important;
      }
      #rpcm-modal .rpcm-breakdown-chip strong{
        color:var(--wish-fg)!important;
        opacity:1!important;
      }
      #rpcm-modal .rpcm-breakdown-chip>span:last-child{
        opacity:1!important;
      }
      #rpcm-modal .rpcm-summary-detail{
        border-top-color:var(--wish-line)!important;
      }

      /* 2) Saved current-state/read cards: light borders, never brown outlines. */
      #rpcm-modal .rpcm-read-card{
        border:0!important;
        background:var(--wish-card)!important;
        color:var(--wish-fg)!important;
        box-shadow:var(--wish-shadow)!important;
      }
      #rpcm-modal .rpcm-read-card>summary{
        border:0!important;
        background:var(--wish-card-2)!important;
        color:var(--wish-fg)!important;
      }
      #rpcm-modal .rpcm-read-card>summary:hover{
        background:var(--wish-accent-soft)!important;
      }
      #rpcm-modal .rpcm-read-card-body{
        border-top-color:var(--wish-line-2)!important;
        background:var(--wish-card)!important;
        color:var(--wish-fg-2)!important;
      }
      #rpcm-modal .rpcm-read-card>summary strong{
        color:var(--wish-fg)!important;
      }
      #rpcm-modal .rpcm-read-card>summary small,
      #rpcm-modal .rpcm-read-copy,
      #rpcm-modal .rpcm-read-chevron{
        color:var(--wish-muted)!important;
      }

      /* 3) Date-log controls are ordinary settings panels in light mode. */
      #rpcm-modal #rpcm-section-basic .rpcm-log-auto-panel,
      #rpcm-modal #rpcm-section-basic>.rpcm-log-help{
        border-color:var(--wish-line)!important;
        background:var(--wish-card-2)!important;
        color:var(--wish-fg-2)!important;
        box-shadow:none!important;
      }
      #rpcm-modal #rpcm-section-basic .rpcm-log-auto-panel label,
      #rpcm-modal #rpcm-section-basic>.rpcm-log-help{
        color:var(--wish-fg-2)!important;
      }
      #rpcm-modal #rpcm-section-basic>.rpcm-log-help b{
        color:var(--wish-accent-strong)!important;
      }

      /* 4) Person detail is a reading surface, not a dark accent block. */
      #rpcm-modal .rpcm-profile-toolbar{
        border-color:var(--wish-line)!important;
        background:var(--wish-card-2)!important;
        color:var(--wish-fg)!important;
        box-shadow:none!important;
      }
      #rpcm-modal .rpcm-profile-toolbar strong{
        color:var(--wish-fg)!important;
      }
      #rpcm-modal .rpcm-profile-toolbar span,
      #rpcm-modal .rpcm-profile-toolbar label{
        color:var(--wish-fg-2)!important;
      }
      #rpcm-modal .rpcm-profile-toolbar input:not([type=checkbox]){
        border-color:var(--wish-line)!important;
        background:var(--wish-card)!important;
        color:var(--wish-fg)!important;
      }

      #rpcm-modal .rpcm-profile-body{
        border-top-color:var(--wish-line-2)!important;
        background:var(--wish-card)!important;
      }
      #rpcm-modal .rpcm-profile-body>section{
        border-color:var(--wish-line)!important;
        background:var(--wish-card-2)!important;
        color:var(--wish-fg)!important;
      }
      #rpcm-modal .rpcm-profile-body h3{
        color:var(--wish-fg)!important;
      }
      #rpcm-modal .rpcm-profile-record{
        border-top-color:var(--wish-line-2)!important;
      }
      #rpcm-modal .rpcm-profile-record>p{
        color:var(--wish-fg-2)!important;
      }
      #rpcm-modal .rpcm-profile-record>p b,
      #rpcm-modal .rpcm-profile-status{
        color:var(--wish-accent-strong)!important;
      }

      #rpcm-modal .rpcm-profile-knowledge-row{
        border-color:var(--wish-line)!important;
        background:var(--wish-card)!important;
        color:var(--wish-fg)!important;
      }
      #rpcm-modal .rpcm-profile-knowledge-row>p{
        color:var(--wish-fg-2)!important;
      }
      #rpcm-modal .rpcm-profile-record-foot{
        color:var(--wish-muted)!important;
      }
      #rpcm-modal .rpcm-profile-record-foot button{
        border-color:var(--wish-line)!important;
        background:var(--wish-card)!important;
        color:var(--wish-fg-2)!important;
      }
      #rpcm-modal .rpcm-profile-record-foot button:hover{
        border-color:var(--wish-accent-line)!important;
        background:var(--wish-accent-soft)!important;
        color:var(--wish-accent-strong)!important;
      }
      #rpcm-modal .rpcm-profile-record-foot details summary,
      #rpcm-modal .rpcm-profile-more>summary{
        color:var(--wish-accent-strong)!important;
      }

      /* Keep brown only for intentionally dark accents:
         header menu, AI result cards, guide-migration notice, and similar explicit accents. */

      /* v0.14.68 · Light mode: brown only where it is truly an accent.
         Normal reading/setting surfaces return to soft pink/white. */

      /* 1) Capacity state badge: "여유" gets a soft green background. */
      #rpcm-modal .rpcm-summary-status{
        border:1px solid transparent!important;
        background:var(--wish-card-2)!important;
      }
      #rpcm-modal .rpcm-summary-status.ok{
        border-color:color-mix(in srgb,var(--wish-success) 34%,var(--wish-line))!important;
        background:color-mix(in srgb,var(--wish-card) 82%,var(--wish-success) 18%)!important;
        color:var(--wish-success)!important;
      }
      #rpcm-modal .rpcm-summary-status.warn{
        border-color:color-mix(in srgb,var(--wish-warning) 38%,var(--wish-line))!important;
        background:color-mix(in srgb,var(--wish-card) 84%,var(--wish-warning) 16%)!important;
      }
      #rpcm-modal .rpcm-summary-status.bad{
        border-color:color-mix(in srgb,var(--wish-danger) 38%,var(--wish-line))!important;
        background:color-mix(in srgb,var(--wish-card) 84%,var(--wish-danger) 16%)!important;
      }

      /* 2) Date log: settings/help panels are soft pink, not brown. */
      #rpcm-modal #rpcm-section-basic .rpcm-auto-panel,
      #rpcm-modal #rpcm-section-basic .rpcm-log-help,
      #rpcm-modal #rpcm-section-basic .rpcm-fixed-note{
        border-color:var(--wish-line)!important;
        background:var(--wish-accent-soft)!important;
        color:var(--wish-fg-2)!important;
        box-shadow:none!important;
      }
      #rpcm-modal #rpcm-section-basic .rpcm-log-help b,
      #rpcm-modal #rpcm-section-basic .rpcm-auto-panel b{
        color:var(--wish-accent-strong)!important;
      }

      /* 3) Timeline: restore a clean light reading surface.
         v0.14.66's brown conversion must not style timeline cards or controls. */
      #rpcm-modal .rpcm-timeline-section,
      #rpcm-modal .rpcm-inline-story-list{
        color:var(--wish-fg)!important;
      }
      #rpcm-modal .rpcm-inline-story-toolbar{
        color:var(--wish-fg-2)!important;
      }
      #rpcm-modal .rpcm-inline-story-diff,
      #rpcm-modal .rpcm-inline-story-settings,
      #rpcm-modal .rpcm-ai-usage-inline,
      #rpcm-modal .rpcm-inline-story-date-nav{
        border-color:var(--wish-line)!important;
        background:var(--wish-accent-soft)!important;
        color:var(--wish-fg-2)!important;
        box-shadow:none!important;
      }
      #rpcm-modal .rpcm-inline-story-settings input[type=number]{
        border-color:var(--wish-line)!important;
        background:var(--wish-card)!important;
        color:var(--wish-fg)!important;
      }
      #rpcm-modal .rpcm-inline-story-date-nav button,
      #rpcm-modal .rpcm-inline-story-guide button,
      #rpcm-modal .rpcm-inline-story-edit button{
        border-color:var(--wish-line)!important;
        background:var(--wish-card)!important;
        color:var(--wish-fg-2)!important;
      }
      #rpcm-modal .rpcm-inline-story-date-nav button:hover,
      #rpcm-modal .rpcm-inline-story-guide button:hover,
      #rpcm-modal .rpcm-inline-story-edit button:hover{
        border-color:var(--wish-accent-line)!important;
        background:var(--wish-accent-soft)!important;
        color:var(--wish-accent-strong)!important;
      }
      #rpcm-modal .rpcm-inline-story-month{
        border-color:var(--wish-line)!important;
        background:var(--wish-card)!important;
      }
      #rpcm-modal .rpcm-inline-story-month>summary{
        color:var(--wish-accent-strong)!important;
        background:var(--wish-card-2)!important;
      }
      #rpcm-modal .rpcm-inline-story-card{
        border-color:var(--wish-line)!important;
        background:var(--wish-card)!important;
        color:var(--wish-fg)!important;
        box-shadow:none!important;
      }
      #rpcm-modal .rpcm-inline-story-top strong{
        color:var(--wish-fg)!important;
      }
      #rpcm-modal .rpcm-inline-story-top span,
      #rpcm-modal .rpcm-inline-story-read small{
        color:var(--wish-muted)!important;
      }
      #rpcm-modal .rpcm-inline-story-read{
        color:var(--wish-fg-2)!important;
      }

      /* 4) Character auto-selection panel: soft pink. */
      #rpcm-modal #rpcm-section-character>.rpcm-auto-panel{
        border-color:var(--wish-line)!important;
        background:var(--wish-accent-soft)!important;
        color:var(--wish-fg-2)!important;
        box-shadow:none!important;
      }
      #rpcm-modal #rpcm-section-character>.rpcm-auto-panel label,
      #rpcm-modal #rpcm-section-character>.rpcm-auto-panel .rpcm-auto-note{
        color:var(--wish-fg-2)!important;
      }
      #rpcm-modal #rpcm-section-character>.rpcm-auto-panel .rpcm-auto-note b{
        color:var(--wish-accent-strong)!important;
      }
      #rpcm-modal #rpcm-section-character>.rpcm-auto-panel select{
        border-color:var(--wish-line)!important;
        background:var(--wish-card)!important;
        color:var(--wish-fg)!important;
      }

      /* 5) 기타·OOC folders: remove brown bands and use soft pink. */
      #rpcm-modal #rpcm-section-extra .rpcm-extra-folder{
        border-color:var(--wish-line)!important;
        background:var(--wish-accent-soft)!important;
        box-shadow:none!important;
      }
      #rpcm-modal #rpcm-section-extra .rpcm-extra-folder>summary{
        border-bottom-color:var(--wish-line-2)!important;
        background:var(--wish-card-2)!important;
        color:var(--wish-fg)!important;
      }
      #rpcm-modal #rpcm-section-extra .rpcm-extra-folder>summary strong{
        color:var(--wish-fg)!important;
      }
      #rpcm-modal #rpcm-section-extra .rpcm-extra-folder>summary span,
      #rpcm-modal #rpcm-section-extra .rpcm-extra-folder>summary:after{
        color:var(--wish-muted)!important;
      }
      #rpcm-modal #rpcm-section-extra .rpcm-extra-folder-body{
        border-color:var(--wish-line)!important;
        background:var(--wish-accent-soft)!important;
      }
      #rpcm-modal #rpcm-section-extra .rpcm-extra-folder-body>.rpcm-slot{
        border-color:var(--wish-line)!important;
        background:var(--wish-card)!important;
      }
      #rpcm-modal #rpcm-section-extra .rpcm-extra-folder-body>.rpcm-slot>summary{
        background:var(--wish-card)!important;
        color:var(--wish-fg)!important;
      }
      #rpcm-modal #rpcm-section-extra .rpcm-extra-category-field{
        border-color:var(--wish-line)!important;
        background:var(--wish-card-2)!important;
        color:var(--wish-fg-2)!important;
      }
      #rpcm-modal #rpcm-section-extra .rpcm-extra-category-input{
        border-color:var(--wish-line)!important;
        background:var(--wish-card)!important;
        color:var(--wish-fg)!important;
      }

      /* 6) Person detail: remove brown accents from the auto-inject switch/avatar. */
      #rpcm-modal .rpcm-profile-switch{
        border-color:var(--wish-accent-line)!important;
        background:var(--wish-accent-soft)!important;
        color:var(--wish-accent-strong)!important;
        box-shadow:none!important;
      }
      #rpcm-modal .rpcm-profile-switch:hover{
        background:var(--wish-accent-soft-2)!important;
      }
      #rpcm-modal .rpcm-profile-avatar{
        border-color:var(--wish-accent-line)!important;
        background:var(--wish-accent-soft-2)!important;
        color:var(--wish-accent-strong)!important;
      }
      #rpcm-modal .rpcm-profile>summary{
        border-bottom-color:var(--wish-line-2)!important;
        background:var(--wish-card)!important;
        color:var(--wish-fg)!important;
      }
      #rpcm-modal .rpcm-profile-identity strong{
        color:var(--wish-fg)!important;
      }
      #rpcm-modal .rpcm-profile-identity small,
      #rpcm-modal .rpcm-profile-headline,
      #rpcm-modal .rpcm-profile-count{
        color:var(--wish-muted)!important;
      }

      /* v0.14.69 · Header readability + remove brown from the ellipsis menu. */
      #rpcm-modal .rpcm-header .rpcm-title{
        color:var(--wish-fg)!important;
        font-weight:700!important;
        opacity:1!important;
      }
      #rpcm-modal .rpcm-header .rpcm-sub{
        color:var(--wish-fg-2)!important;
        font-weight:550!important;
        opacity:1!important;
      }

      #rpcm-modal .rpcm-header-menu>summary{
        border-color:var(--wish-line)!important;
        background:var(--wish-card)!important;
        color:var(--wish-fg-2)!important;
        box-shadow:none!important;
      }
      #rpcm-modal .rpcm-header-menu>summary:hover,
      #rpcm-modal .rpcm-header-menu[open]>summary{
        border-color:var(--wish-accent-line)!important;
        background:var(--wish-accent-soft)!important;
        color:var(--wish-accent-strong)!important;
      }
