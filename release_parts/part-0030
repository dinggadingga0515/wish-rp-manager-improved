    if(JSON.stringify(room)!==preview.baseSnapshot||JSON.stringify(await readManualStoredRoom(room))!==preview.storedSnapshot)throw new Error('미리보기 이후 데이터가 바뀌었습니다. 다시 확인해 주세요.');
