  function loadAiSummarySettings() {
    const defaults = {
      provider:'gemini',
      models:Object.fromEntries(AI_SUMMARY_PROVIDERS.map(id => [id, AI_SUMMARY_PROVIDER_DEFAULTS[id].model])),
      openaiBaseUrl:'',
      vertexLocation:'global',
      vertexProjectId:'',
      turnCount:30,
      preferUnprocessed:true,
      targets:{ logSummary:true, currentState:true },
      featureModels:{
        summary:{ provider:'gemini', model:AI_SUMMARY_PROVIDER_DEFAULTS.gemini.model },
        timeline:{ provider:'gemini', model:AI_SUMMARY_PROVIDER_DEFAULTS.gemini.model },
        context:{ provider:'gemini', model:AI_SUMMARY_PROVIDER_DEFAULTS.gemini.model },
        itemFolder:{ provider:'gemini', model:AI_SUMMARY_PROVIDER_DEFAULTS.gemini.model },
        utility:{ provider:'gemini', model:AI_SUMMARY_PROVIDER_DEFAULTS.gemini.model },
      },
      featureStatus:{},
    };
    try {
      let raw='';
      try { raw=localStorage.getItem(AI_SUMMARY_SETTINGS_KEY)||''; } catch (_) {}
      if(!raw){try{raw=String(GM_getValue(AI_SUMMARY_SETTINGS_KEY,'')||'');}catch(_){}}
      const saved = JSON.parse(raw || 'null');
      if (!saved || typeof saved !== 'object') return defaults;
      const provider = AI_SUMMARY_PROVIDERS.includes(saved.provider) ? saved.provider : defaults.provider;
      const models = { ...defaults.models, ...(saved.models && typeof saved.models === 'object' ? saved.models : {}) };
      const legacyModel = String(models[provider] || AI_SUMMARY_PROVIDER_DEFAULTS[provider]?.model || '');
      const normalizeFeature = feature => {
        const raw = saved.featureModels?.[feature];
        const featureProvider = AI_SUMMARY_PROVIDERS.includes(raw?.provider) ? raw.provider : provider;
        return { provider:featureProvider, model:String(raw?.model || models[featureProvider] || legacyModel) };
      };
      return {
        provider,
        models,
        openaiBaseUrl:String(saved.openaiBaseUrl || ''),
        vertexLocation:String(saved.vertexLocation || 'global'),
        vertexProjectId:String(saved.vertexProjectId || ''),
        turnCount:Number(saved.turnCount) === 0 ? 0 : Math.max(1, Math.min(100, Number(saved.turnCount) || 30)),
        preferUnprocessed:saved.preferUnprocessed !== false,
        targets:{
          logSummary:saved.targets?.logSummary !== false,
          currentState:saved.targets?.currentState !== false,
        },
        featureModels:{ summary:normalizeFeature('summary'), timeline:normalizeFeature('timeline'), context:normalizeFeature('context'), itemFolder:normalizeFeature('itemFolder'), utility:normalizeFeature('utility') },
        featureStatus:saved.featureStatus && typeof saved.featureStatus === 'object' ? saved.featureStatus : {},
      };
    } catch (_) { return defaults; }
  }

  function saveAiSummarySettings(settings) {
    const next = loadAiSummarySettings();
    Object.assign(next, settings || {});
    if (settings?.models) next.models = { ...next.models, ...settings.models };
    if (settings?.targets) next.targets = { ...next.targets, ...settings.targets };
    if (settings?.featureModels) next.featureModels = { ...next.featureModels, ...settings.featureModels };
    if (settings?.featureStatus) next.featureStatus = { ...next.featureStatus, ...settings.featureStatus };
    next.provider = AI_SUMMARY_PROVIDERS.includes(next.provider) ? next.provider : 'gemini';
    next.turnCount = Number(next.turnCount) === 0 ? 0 : Math.max(1, Math.min(100, Number(next.turnCount) || 30));
    const serialized=JSON.stringify(next);
    let localError=null;
    try { localStorage.setItem(AI_SUMMARY_SETTINGS_KEY, serialized); }
    catch (error) { localError=error; }
    try { GM_setValue(AI_SUMMARY_SETTINGS_KEY, serialized); }
    catch (gmError) { if(localError) throw new Error(`AI 설정 저장 실패: 브라우저 저장공간과 확장 저장공간을 모두 사용할 수 없습니다. ${localError?.message||localError}; ${gmError?.message||gmError}`); }
    return next;
  }

  function aiFeatureSettings(settings, feature) {
    const base = settings || loadAiSummarySettings();
    const selected = base.featureModels?.[feature] || { provider:base.provider, model:base.models?.[base.provider] };
    const provider = AI_SUMMARY_PROVIDERS.includes(selected.provider) ? selected.provider : base.provider;
    return { ...base, provider, models:{ ...base.models, [provider]:String(selected.model || base.models?.[provider] || AI_SUMMARY_PROVIDER_DEFAULTS[provider]?.model || '') } };
  }

  // 저장된 성공/오류 상태는 그때 실제로 사용한 provider+model과 현재 선택이 같을 때만 유효합니다.
  // 모델을 바꿨는데 과거 오류가 계속 빨갛게 남는 stale status를 방지합니다.
  function aiFeatureCurrentStatus(settings, feature, providerOverride = '', modelOverride = '') {
    const base = settings || loadAiSummarySettings();
    const cfg = aiFeatureSettings(base, feature);
    const provider = String(providerOverride || cfg.provider || '');
    const model = String(modelOverride || cfg.models?.[provider] || '');
    const status = base.featureStatus?.[feature];
    if (!status || typeof status !== 'object') return null;
    return String(status.provider || '') === provider && String(status.model || '') === model ? status : null;
  }

  function aiFeatureStatusLabel(feature) {
    return feature === 'semanticIndex' ? '의미 검색 준비' : feature === 'semanticQuery' ? '의미 검색 query' : feature === 'longTermManualFirst' ? '장기기억 1차 수동' : feature === 'longTermAutoFirst' ? '장기기억 1차 자동' : feature === 'longTermSecond' ? '장기기억 2차' : feature === 'longTermNative' ? 'native 장기기억 정리' : feature === 'timeline' ? '연속성 타임라인' : feature === 'context' ? 'AI 맥락 검토' : feature === 'itemFolder' ? '중요 물품 폴더 정리' : feature === 'utility' ? 'AI 어시스턴트' : feature === 'responseRefiner' ? '응답교정' : 'AI 요약';
  }

  function rpcmAiNonFailureState(error){
    const code=String(error?.code||'');
    return code==='RPCM_USER_ABORT'?'cancelled':code==='RPCM_HISTORY_STALE'?'stale':'';
  }
  function classifyAiFailure(error) {
    const neutral=rpcmAiNonFailureState(error);
    if(neutral)return {category:neutral==='cancelled'?'사용자가 취소함':'방·분기 변경으로 중단',detail:String(error?.message||'')};
    const detail = String(error?.message || error || '알 수 없는 오류');
    const lower = detail.toLowerCase();
    const status=rpcmNetStatus(error),service=error?.diagnostic?.service||'',code=String(error?.code||'');
    if(service==='crack-read')return {category:'대화 조회 실패'+(status?' · '+status:''),detail};
    if(service==='crack-write')return {category:'대화 저장 실패'+(status?' · '+status:''),detail};
    if(service==='embedding')return {category:'의미검색 실패'+(status?' · '+status:''),detail};
    const firebase=error?.diagnostic?.transport==='firebase-sdk'||error?.provider==='firebase';
    if(firebase&&(!status||status===403)&&(/api-not-enabled/i.test(code+' '+String(error?.providerCode||''))||/requires the Firebase AI API/i.test(detail)))return {category:'Firebase AI Logic 미활성화',detail:detail+'\nFirebase Config의 프로젝트를 확인하고 Firebase 콘솔 → AI Services → AI Logic에서 필요한 API의 시작 설정을 확인해 주세요.'};
    if(status===401||status===403)return {category:'API 인증 실패',detail};
    if(status===429)return {category:error?.permanentQuota?'API 할당량·결제 한도':'API 요청량 제한',detail};
    if(status>=500||/\b503\b/.test(detail))return {category:'AI 서비스 일시 장애',detail};
    if(['AI_OUTPUT_LIMIT','AI_MAX_TOKENS'].includes(code))return {category:'출력 한도 초과',detail};
    if(code==='AI_RESPONSE_INCOMPLETE')return {category:'AI 응답 미완료',detail};
    if(code==='AI_RESPONSE_BLOCKED')return {category:'AI 제공자 응답 거절',detail};
    if(code==='AI_EMPTY_RESPONSE')return {category:'AI 빈 응답',detail};
    if(['AI_REQUEST_TIMEOUT','AI_DEADLINE'].includes(code))return {category:'AI 응답 대기 시간 초과',detail};
    if(['RPCM_USER_ABORT','RPCM_HISTORY_STALE'].includes(code))return {category:'AI 작업 중단',detail};
    let category = '기타 오류';
    if (/quotaexceedederror|storage quota|dom exception.*quota|the quota has been exceeded/.test(lower)) category = '브라우저 저장공간 오류';
    else if (/app.?check|firebaseappcheck|attestation|recaptcha enterprise/.test(lower)) category = 'Firebase App Check 인증';
    else if (/429|resource exhausted|rate.?limit|api quota|requests per|tokens per/.test(lower)) category = 'API 사용량 제한';
    else if (/firebase|api.?key|설정 코드|configuration/.test(lower)) category = 'Firebase 설정 오류';
    else if (/network|fetch|연결|timeout|timed out|cors/.test(lower)) category = '네트워크 오류';
    else if (/model|not found|unsupported|지원하지/.test(lower)) category = '모델 사용 불가';
    else if (/max_tokens|finish.?reason.*length|출력 한도|출력이? .*끊|응답이? .*끊|incomplete/.test(lower)) category = '출력 한도 초과';
    else if (/token|too large|maximum|입력 한도|context length/.test(lower)) category = '입력 한도 초과';
    else if (/json|response format|응답 형식/.test(lower)) category = '응답 형식 오류';
    else if (/parse|파싱/.test(lower)) category = '응답 파싱 실패';
    else if (/401|403|unauthorized|forbidden|인증/.test(lower)) category = 'API 연결 실패';
    else if (/api|호출|generation|generate/.test(lower)) category = '모델 호출 실패';
    return { category, detail };
  }

  function setAiFeatureStatus(feature, stateName, provider, model, message = '', detail = '', extra = {}) {
    const settings = aiFeatureSettings(loadAiSummarySettings(), 'summary');
    settings.featureStatus = {
      ...(settings.featureStatus || {}),
      [feature]:{ ...(settings.featureStatus?.[feature]?.lastRun ? { lastRun:settings.featureStatus[feature].lastRun } : {}), state:stateName, provider:String(provider || ''), model:String(model || ''), message:wrpmFullBackupV2.redactDiagnostic(message), detail:wrpmFullBackupV2.redactDiagnostic(detail), checkedAt:nowIso(), ...(extra && typeof extra === 'object' ? extra : {}) },
    };
    saveAiSummarySettings(settings);
    if (feature === 'summary') syncAiSummaryStatusInOpenManager();
    return settings.featureStatus[feature];
  }

  function syncAiSummaryStatusInOpenManager() {
    const settings=loadAiSummarySettings();
    const selected=aiFeatureSettings(settings,'summary');
    const status=aiFeatureCurrentStatus(settings,'summary');
    const isOk=status?.state==='ok', isError=status?.state==='error';
    const label=isOk?'정상':isError?'오류':'확인 전';
    const nodes=[document.querySelector('#rpcm-ai-api-summary .rpcm-ai-chip'),document.querySelector('#rpcm-ai-summary-status')?.closest('article')?.querySelector('.rpcm-ai-chip-row .rpcm-ai-chip')].filter(Boolean);
    for (const node of nodes) {
      node.classList.remove('is-ok','is-error','is-idle');
      node.classList.add(isOk?'is-ok':isError?'is-error':'is-idle');
      node.textContent=`● ${label}`;
      rpcmClearErrorHelp(node);
      if (isError) rpcmSetErrorHelp(node,status.detail||status.message||'AI 요약 오류',status.message||'기타 오류');
    }
    const card=document.querySelector('#rpcm-ai-summary-status');
    if (card && state.currentRoom) {
      const strong=card.querySelector('strong');
      if (strong) strong.textContent=state.currentRoom.aiSummaryDraft?.createdAt?new Date(state.currentRoom.aiSummaryDraft.createdAt).toLocaleString('ko-KR'):'없음';
    }
  }

  function loadAiSummaryUsage() {
    try {
      const saved = JSON.parse(localStorage.getItem(AI_SUMMARY_USAGE_KEY) || 'null');
      if (saved && typeof saved === 'object') return {
        ...saved,
        calls:Math.max(0, Number(saved.calls) || 0),
        inputTokens:Math.max(0, Number(saved.inputTokens) || 0),
        outputTokens:Math.max(0, Number(saved.outputTokens) || 0),
        estimatedCostUsd:Math.max(0, Number(saved.estimatedCostUsd) || 0),
        pricedCalls:Math.max(0, Number(saved.pricedCalls) || 0),
      };
    } catch (_) {}
    return { calls:0, inputTokens:0, outputTokens:0, estimatedCostUsd:0, pricedCalls:0, last:null };
  }

  function defaultAiPricing(provider, model) {
    const providerId = String(provider || '').toLowerCase();
    const google = ['gemini','firebase','vertex'].includes(providerId);
    const name = String(model || '').trim().toLowerCase();
    if (providerId === 'openai') {
      if (/^gpt-6-astra(?:$|-)/.test(name)) {
        return { inputPerMillion:10.00, outputPerMillion:50.00, source:'OpenAI 공식 기본 단가' };
      }
      if (/^gpt-5\.6-terra(?:$|-)/.test(name)) {
        return { inputPerMillion:2.00, outputPerMillion:12.00, source:'OpenAI 공식 기본 단가' };
      }
      if (/^gpt-5\.6-luna(?:$|-)/.test(name)) {
        return { inputPerMillion:0.20, outputPerMillion:1.20, source:'OpenAI 공식 기본 단가' };
      }
      if (/^(?:gpt-5\.6|gpt-5\.6-sol)(?:$|-)/.test(name)) {
        return { inputPerMillion:4.00, outputPerMillion:20.00, source:'OpenAI 공식 기본 단가' };
      }
    }
    if (google && /^gemini-3\.8-flash(?:$|-)/.test(name)) {
      return { inputPerMillion:0.75, outputPerMillion:3.75, source:'Google 공식 Standard 단가 · 2026-12-31까지' };
    }
    if (google && /^gemini-3\.7-flash(?:$|-)/.test(name)) {
      return { inputPerMillion:0.75, outputPerMillion:3.75, source:'Google 공식 global 단가 · 2026-12-31까지' };
    }
    if (google && /^gemini-3\.5-flash-lite(?:$|-)/.test(name)) {
      return { inputPerMillion:0.30, outputPerMillion:2.50, source:'Google 공식 global 단가' };
    }
    if (google && /^gemini-3\.5-flash(?:$|-)/.test(name)) {
      return { inputPerMillion:1.50, outputPerMillion:9.00, source:'Google 공식 global 단가' };
    }
    if (google && /^gemini-3\.1-flash-lite(?:$|-)/.test(name)) {
      return { inputPerMillion:0.25, outputPerMillion:1.50, source:'Google 공식 global 단가' };
    }
    if (google && /^gemini-3\.1-pro-preview(?:$|-)/.test(name)) {
      return { inputPerMillion:2.00, outputPerMillion:12.00, source:'Google 공식 global 단가 · 입력 20만 토큰 이하' };
    }
    if (google && /^gemini-2\.5-flash-lite(?:$|-)/.test(name)) {
      return { inputPerMillion:0.10, outputPerMillion:0.40, source:'Google 공식 기본 단가' };
    }
    if (google && /^gemini-2\.5-flash(?:$|-)/.test(name) && !/(?:image|tts|native-audio)/.test(name)) {
      return { inputPerMillion:0.30, outputPerMillion:2.50, source:'Google 공식 기본 단가' };
    }
    if (google && /^gemini-2\.5-pro(?:$|-)/.test(name)) {
      return { inputPerMillion:1.25, outputPerMillion:10.00, source:'Google 공식 기본 단가 · 입력 20만 토큰 이하' };
    }
    return { inputPerMillion:null, outputPerMillion:null, source:'자동 단가 정보 없음' };
  }

  function isOfficialOpenAiBaseUrl(value) {
    try {
      const url = new URL(String(value || '').trim());
      return url.hostname.toLowerCase() === 'api.openai.com';
    } catch (_) {
      return false;
    }
  }

  function getAiPricing(settings, provider, model) {
    const providerId=String(provider||'').toLowerCase(),modelId=String(model||'').trim().toLowerCase();
    if(['gemini','firebase','vertex'].includes(providerId)&&modelId==='gemini-4-argon'){
      const standard=Date.now()>=Date.UTC(2026,11,1),nonGlobal=providerId==='vertex'&&String(settings?.vertexLocation||'global').trim().toLowerCase()!=='global',factor=nonGlobal?1.1:1;
      return {inputPerMillion:(standard?4:2)*factor,outputPerMillion:(standard?20:10)*factor,source:`Google 공식 ${nonGlobal?'non-global':'global'} Argon 단가 · ${standard?'2026-12-01 이후':'2026-11-30까지'}`};
    }
    if (providerId === 'openai' && !isOfficialOpenAiBaseUrl(settings?.openaiBaseUrl)) {
      return { inputPerMillion:null, outputPerMillion:null, source:'OpenAI 호환 API · 단가 직접 확인 필요' };
    }
    return defaultAiPricing(provider, model);
  }

  function estimateAiCostUsd(usage = {}, pricing = {}) {
    if (pricing.inputPerMillion == null || pricing.inputPerMillion === '' || pricing.outputPerMillion == null || pricing.outputPerMillion === '') return null;
    const inputRate = Number(pricing.inputPerMillion);
    const outputRate = Number(pricing.outputPerMillion);
    if (!Number.isFinite(inputRate) || inputRate < 0 || !Number.isFinite(outputRate) || outputRate < 0) return null;
    const inputTokens = Math.max(0, Number(usage.inputTokens) || 0);
    const outputTokens = Math.max(0, Number(usage.outputTokens) || 0);
    return (inputTokens * inputRate + outputTokens * outputRate) / 1000000;
  }

  function formatAiCostUsd(value) {
    const amount = Number(value);
    if (!Number.isFinite(amount) || amount < 0) return '단가 미설정';
    if (amount > 0 && amount < 0.0001) return '$0.0001 미만';
    if (amount < 0.01) return `$${amount.toFixed(4)}`;
    if (amount < 1) return `$${amount.toFixed(3)}`;
    return `$${amount.toFixed(2)}`;
  }

  function emptyRoomAiFeatureUsage() {
    return { calls:0, inputTokens:0, outputTokens:0, costUsd:0, estimatedCalls:0, unpricedCalls:0 };
  }

  function normalizeRoomAiUsage(room) {
    if (!room || typeof room !== 'object') return { version:1, features:{ summary:emptyRoomAiFeatureUsage(), timeline:emptyRoomAiFeatureUsage(), context:emptyRoomAiFeatureUsage(), itemFolder:emptyRoomAiFeatureUsage(), utility:emptyRoomAiFeatureUsage(), responseRefiner:emptyRoomAiFeatureUsage(), longTermManualFirst:emptyRoomAiFeatureUsage(), longTermAutoFirst:emptyRoomAiFeatureUsage(), longTermSecond:emptyRoomAiFeatureUsage(), longTermNative:emptyRoomAiFeatureUsage() }, history:[] };
    const hasStoredUsage = !!(room.aiApiUsage && typeof room.aiApiUsage === 'object');
    const source = hasStoredUsage ? room.aiApiUsage : {};
    const sourceFeatures = source.features && typeof source.features === 'object' ? source.features : {};
    const features = {};
    for (const feature of ['summary','timeline','context','itemFolder','utility','responseRefiner','longTermManualFirst','longTermAutoFirst','longTermSecond','longTermNative','semanticIndex','semanticQuery']) {
      const saved = sourceFeatures[feature] && typeof sourceFeatures[feature] === 'object' ? sourceFeatures[feature] : {};
      features[feature] = {
        calls:Math.max(0, Number(saved.calls) || 0),
        inputTokens:Math.max(0, Number(saved.inputTokens) || 0),
        outputTokens:Math.max(0, Number(saved.outputTokens) || 0),
        costUsd:Math.max(0, Number(saved.costUsd) || 0),
        estimatedCalls:Math.max(0, Number(saved.estimatedCalls) || 0),
        unpricedCalls:Math.max(0, Number(saved.unpricedCalls) || 0),
      };
    }
    let history = (Array.isArray(source.history) ? source.history : []).filter(item => item && typeof item === 'object').slice(0, AI_ROOM_USAGE_HISTORY_LIMIT).map(item => ({
      id:String(item.id || ''), at:String(item.at || ''), feature:['summary','timeline','context','itemFolder','utility','responseRefiner','longTermManualFirst','longTermAutoFirst','longTermSecond','longTermNative','semanticIndex','semanticQuery'].includes(item.feature) ? item.feature : 'summary',
      provider:String(item.provider || ''), model:String(item.model || ''), inputTokens:Math.max(0, Number(item.inputTokens) || 0), outputTokens:Math.max(0, Number(item.outputTokens) || 0),
      costUsd:item.costUsd == null || !Number.isFinite(Number(item.costUsd)) ? null : Math.max(0, Number(item.costUsd)), estimated:!!item.estimated, callCount:Math.max(1, Number(item.callCount) || 1),
    }));
    // v0.12.42 이전에 방 안의 생성 이력에 남은 실제 usage 토큰·당시 비용을 1회만 복원합니다.
    // 방을 구분할 수 없는 기존 브라우저 전체 누적값은 섞지 않습니다.
    if (!hasStoredUsage) {
      const legacyRuns = [
        ...(Array.isArray(room.aiSummaryHistory) ? room.aiSummaryHistory : []).map(item => ({ feature:'summary', item })),
        ...(Array.isArray(room.storyTimelineApiHistory) ? room.storyTimelineApiHistory : []).map(item => ({ feature:'timeline', item })),
      ];
      for (const [legacyIndex, legacy] of legacyRuns.entries()) {
        const saved = legacy.item?.usage && typeof legacy.item.usage === 'object' ? legacy.item.usage : {};
        const calls = Math.max(0, Number(saved.calls) || 0);
        if (!calls) continue;
        const inputTokens = Math.max(0, Number(saved.inputTokens) || 0);
        const outputTokens = Math.max(0, Number(saved.outputTokens) || 0);
        const unpricedCalls = Math.max(0, Math.min(calls, Number(saved.unpricedCalls) || 0));
        const storedCost = Number(saved.estimatedCostUsd);
        const costUsd = Number.isFinite(storedCost) && unpricedCalls < calls ? Math.max(0, storedCost) : null;
        const estimated = inputTokens <= 0 || outputTokens <= 0;
        const aggregate = features[legacy.feature];
        aggregate.calls += calls;
        aggregate.inputTokens += inputTokens;
        aggregate.outputTokens += outputTokens;
        if (costUsd != null) aggregate.costUsd += costUsd;
        aggregate.unpricedCalls += unpricedCalls;
        if (estimated) aggregate.estimatedCalls += calls;
        history.push({
          id:`LEGACY_${legacy.feature}_${legacy.item?.id || legacyIndex}`,
          at:String(legacy.item?.createdAt || legacy.item?.appliedAt || ''), feature:legacy.feature,
          provider:String(legacy.item?.provider || ''), model:String(legacy.item?.model || ''),
          inputTokens, outputTokens, costUsd, estimated, callCount:calls,
        });
      }
      history.sort((a, b) => String(b.at || '').localeCompare(String(a.at || '')));
      history = history.slice(0, AI_ROOM_USAGE_HISTORY_LIMIT);
    }
    room.aiApiUsage = { version:1, features, history, legacyImported:true };
    return room.aiApiUsage;
  }

  function roomAiUsageTotals(room) {
    const usage = normalizeRoomAiUsage(room);
    return Object.values(usage.features).reduce((total, item) => {
      total.calls += item.calls;
      total.inputTokens += item.inputTokens;
      total.outputTokens += item.outputTokens;
      total.costUsd += item.costUsd;
      total.estimatedCalls += item.estimatedCalls;
      total.unpricedCalls += item.unpricedCalls;
      return total;
    }, emptyRoomAiFeatureUsage());
  }

  function recordRoomAiUsage(room, feature, provider, model, usage = {}, pricing = {}, source = {}) {
    if (!room || typeof room !== 'object') return null;
    const normalizedFeature = ['summary','timeline','context','itemFolder','utility','responseRefiner','longTermManualFirst','longTermAutoFirst','longTermSecond','longTermNative','semanticIndex','semanticQuery'].includes(feature) ? feature : 'summary';
    const reportedInput = Math.max(0, Number(usage.inputTokens) || 0);
    const reportedOutput = Math.max(0, Number(usage.outputTokens) || 0);
    const inputEstimated = reportedInput <= 0;
    const embedding=['semanticIndex','semanticQuery'].includes(normalizedFeature);
    const outputEstimated = !embedding && reportedOutput <= 0;
    const inputTokens = inputEstimated ? Math.max(1, Math.ceil((String(source.systemInstruction || '').length + String(source.prompt || '').length) / 3)) : reportedInput;
    const outputTokens = embedding ? 0 : outputEstimated ? Math.max(1, Math.ceil(String(source.text || '').length / 3)) : reportedOutput;
    const estimated = inputEstimated || outputEstimated;
    const costUsd = estimateAiCostUsd({ inputTokens, outputTokens }, pricing);
    const state = normalizeRoomAiUsage(room);
    const aggregate = state.features[normalizedFeature];
    aggregate.calls += 1;
    aggregate.inputTokens += inputTokens;
    aggregate.outputTokens += outputTokens;
    if (costUsd == null) aggregate.unpricedCalls += 1;
    else aggregate.costUsd += costUsd;
    if (estimated) aggregate.estimatedCalls += 1;
    const entry = {
      id:`API_${Date.now().toString(36)}${Math.random().toString(36).slice(2,7)}`,
      at:nowIso(), feature:normalizedFeature, provider:String(provider || ''), model:String(model || ''),
      inputTokens, outputTokens, costUsd, estimated, callCount:1,
    };
    state.history.unshift(entry);
    state.history = state.history.slice(0, AI_ROOM_USAGE_HISTORY_LIMIT);
    return entry;
  }

  function renderRoomAiUsageHtml(room) {
    const usage = normalizeRoomAiUsage(room);
    const total = roomAiUsageTotals(room);
    const featureHtml = ['summary','timeline','context','itemFolder','utility','responseRefiner','longTermManualFirst','longTermAutoFirst','longTermSecond','longTermNative','semanticIndex','semanticQuery'].map(feature => {
      const item = usage.features[feature];
      const estimated = item.estimatedCalls ? ' · 예상 토큰 포함' : '';
      const unpriced = item.unpricedCalls ? ` · 비용 미산정 ${formatCount(item.unpricedCalls)}회` : '';
      const cost = item.calls && item.unpricedCalls >= item.calls ? '가격 정보 없음' : formatAiCostUsd(item.costUsd);
      return `<div class="rpcm-api-usage-row"><strong>${esc(aiFeatureStatusLabel(feature))}</strong><span>호출 ${formatCount(item.calls)}회 · 입력 ${formatCount(item.inputTokens)} tokens · 출력 ${formatCount(item.outputTokens)} tokens</span><b>누적${item.estimatedCalls ? ' 예상' : ''} ${cost}${estimated}${unpriced}</b></div>`;
    }).join('');
    const historyHtml = usage.history.length ? usage.history.map(entry => {
      let when = entry.at || '';
      try { when = entry.at ? new Date(entry.at).toLocaleString('ko-KR') : ''; } catch (_) {}
      const cost = entry.costUsd == null ? '가격 정보 없음' : formatAiCostUsd(entry.costUsd);
      return `<div class="rpcm-api-usage-call"><span>${esc(when)}</span><strong>${esc(aiFeatureStatusLabel(entry.feature))}</strong><span>${esc(entry.model || entry.provider || '모델 미상')}</span><span>호출 ${formatCount(entry.callCount || 1)}회 · 입력 ${formatCount(entry.inputTokens)} · 출력 ${formatCount(entry.outputTokens)} tokens</span><b>${entry.estimated ? '예상 ' : ''}${cost}</b></div>`;
    }).join('') : '<div class="rpcm-api-usage-empty">이 방에서 기록된 API 호출이 아직 없습니다.</div>';
    const totalNote = `${total.estimatedCalls ? ` · 예상 토큰 포함 ${formatCount(total.estimatedCalls)}회` : ''}${total.unpricedCalls ? ` · 비용 미산정 ${formatCount(total.unpricedCalls)}회` : ''}`;
    const totalCost = total.calls && total.unpricedCalls >= total.calls ? '가격 정보 없음' : formatAiCostUsd(total.costUsd);
    return `<section class="rpcm-ai-card rpcm-api-room-usage"><h3>[이 방의 API 사용량]</h3><div class="rpcm-api-usage-list">${featureHtml}</div><div class="rpcm-api-usage-total"><span>총 호출 ${formatCount(total.calls)}회<br>입력 ${formatCount(total.inputTokens)} / 출력 ${formatCount(total.outputTokens)} tokens</span><strong>총 누적${total.estimatedCalls ? ' 예상' : ''} 비용 ${totalCost}</strong><small>${totalNote.replace(/^ · /, '')}</small></div><details class="rpcm-api-usage-details"><summary>비용 상세 보기 <span>${formatCount(usage.history.length)}건</span></summary><div>${historyHtml}</div></details></section>`;
  }

  function renderAiRoomUsageCompact(room) {
    const total = roomAiUsageTotals(room);
    const cost = total.unpricedCalls
      ? (total.unpricedCalls >= total.calls ? '가격 정보 없음' : `${formatAiCostUsd(total.costUsd)} · 일부 가격 정보 없음`)
      : formatAiCostUsd(total.costUsd);
    return `<div class="rpcm-ai-usage-compact"><span>이번 방 <b>${formatCount(total.calls)}회</b></span><span>입력 <b>${formatCount(total.inputTokens)}</b></span><span>출력 <b>${formatCount(total.outputTokens)}</b></span><span>총 <b>${formatCount(total.inputTokens + total.outputTokens)} tokens</b></span><span>예상 비용 <b>${esc(cost)}</b></span><details id="rpcm-ai-usage-details"><summary>사용량 자세히</summary>${renderRoomAiUsageHtml(room)}</details></div>`;
  }

  function refreshAiRoomUsageUi(room) {
    if (!room || state.currentRoom !== room) return;
    const usage = state.modal?.querySelector('#rpcm-section-ai .rpcm-ai-usage-compact');
    if (!usage) return;
    const expanded = !!usage.querySelector('#rpcm-ai-usage-details[open]');
    usage.outerHTML = renderAiRoomUsageCompact(room);
    const details = state.modal?.querySelector('#rpcm-ai-usage-details');
    if (details) details.open = expanded;
  }

  function saveAiSummaryUsage(provider, model, usage = {}, pricing = {}) {
    const state = loadAiSummaryUsage();
    const inputTokens = Math.max(0, Number(usage.inputTokens) || 0);
    const outputTokens = Math.max(0, Number(usage.outputTokens) || 0);
    const estimatedCostUsd = estimateAiCostUsd({ inputTokens, outputTokens }, pricing);
    state.calls = Math.max(0, Number(state.calls) || 0) + 1;
    state.inputTokens = Math.max(0, Number(state.inputTokens) || 0) + inputTokens;
    state.outputTokens = Math.max(0, Number(state.outputTokens) || 0) + outputTokens;
    if (estimatedCostUsd != null) {
      state.estimatedCostUsd = Math.max(0, Number(state.estimatedCostUsd) || 0) + estimatedCostUsd;
      state.pricedCalls = Math.max(0, Number(state.pricedCalls) || 0) + 1;
    }
    state.last = { provider, model, inputTokens, outputTokens, estimatedCostUsd, pricing, at:nowIso() };
    try { localStorage.setItem(AI_SUMMARY_USAGE_KEY, JSON.stringify(state)); } catch (_) {}
    return { state, estimatedCostUsd };
  }

