  function aiSecretKey(provider) {
    return `${AI_SECRET_PREFIX}${String(provider || '')}`;
  }

  function readAiSecret(provider) {
    try {
      const stored=GM_getValue(aiSecretKey(provider),'');
      if(provider!=='openai')return String(stored||'');
      if(stored?.version!==2||typeof stored.value!=='string')return '';
      return stored.endpoint===rpcmAiCredentialEndpoint(loadAiSummarySettings())?stored.value:'';
    }catch(_){return '';}
  }

  function writeAiSecret(provider,value) {
    const secret=String(value||'');
    try{
      const stored=provider==='openai'&&secret?{version:2,value:secret,endpoint:rpcmAiCredentialEndpoint(loadAiSummarySettings())}:secret;
      if(secret)GM_setValue(aiSecretKey(provider),stored);else GM_deleteValue(aiSecretKey(provider));
      return true;
    }catch(_){return false;}
  }
  function writeAiSecretChecked(provider,value) {
    const secret=String(value||'');
    if(!writeAiSecret(provider,secret)||readAiSecret(provider)!==secret)throw new Error(`${provider} API 인증정보를 저장하지 못했습니다. 브라우저 확장 저장공간을 확인해 주세요.`);
    return true;
  }
  function rpcmAiCredentialEndpoint(settings){return normalizeOpenAiEndpoint(settings?.openaiBaseUrl);}
  function rpcmBindLegacyOpenAiCredential(){
    const stored=GM_getValue(aiSecretKey('openai'),'');
    if(typeof stored!=='string'||!stored)return;
    try{const endpoint=rpcmAiCredentialEndpoint(loadAiSummarySettings());GM_setValue(aiSecretKey('openai'),{version:2,value:stored,endpoint});}
    catch(_){/* Preserve the unbound value; explicit entry is required before use. */}
