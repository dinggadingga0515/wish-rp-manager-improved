  function maintenanceRecommendations(room, items, capacity, precomputed = null) {
    const immediate = [], updates = [], capacityItems = [];
    const push = (list, title, reason, view, detail = '', task = '', item = null) => list.push({ title, reason, view, detail, task, item });
    const duplicateLogs = (precomputed?.duplicateGroups ?? duplicateLogDateGroups(room)).length;
    const duplicateItems = (precomputed?.duplicateItemGroups ?? duplicateImportantItemGroups(room)).length;
    const conflicts = precomputed?.knowledgeConflictCount ?? knowledgeConflicts(room).size;
    const loreBudget = precomputed?.loreBudget ?? loreBudgetInfoFor(room);
    const loreOmitted = Math.max(0, Number(loreBudget?.candidates || 0) - Number(loreBudget?.included || 0));
