      const old=entry.id?[...(room.knowledgeCards||[]),...(room.personStateRecords||[])].find(card=>String(card.id)===entry.id):personRecordMatch(structuredClone(room),entry);
      return old?String(old.id):'';
    }).filter(Boolean));
