        refreshPaletteDots();
      };
    }
    const intensitySlider = backdrop.querySelector('[data-rpcm-surface-intensity]');
    const intensityLabel = backdrop.querySelector('[data-rpcm-intensity-value]');
    if (intensitySlider) intensitySlider.oninput = () => {
      if (!loadRpcmSurfaceTheme()) saveRpcmSurfaceTheme(normalizeRpcmAccentHex(state.quickSurfaceDraftHex) || rpcmCurrentSurfaceForPicker());
      const shade = saveRpcmSurfaceIntensity(intensitySlider.value);
      if (intensityLabel) intensityLabel.textContent = `${shade}%`;
      refreshPaletteDots();
    };

    const saveCurrentPalette = kind => {
      const label = kind === 'accent' ? '강조색' : '배경색·농담';
      const name = prompt(`${label} 저장 이름 (최대 32자)`, '')?.trim().slice(0,32);
      if (!name) return;
      const presets = loadRpcmPalettePresets(kind);
      const existing = presets.findIndex(row => row.name === name);
      if (existing >= 0 && !confirm(`같은 이름의 ${label} 저장색을 덮어쓸까요?`)) return;
      // Capture a concrete color value, including when the user has never set a custom one.
      const hex = kind === 'accent'
        ? (normalizeRpcmAccentHex(state.quickThemeDraftHex) || loadRpcmAccentTheme() || rpcmCurrentAccentForPicker())
        : (normalizeRpcmAccentHex(state.quickSurfaceDraftHex) || loadRpcmSurfaceTheme() || rpcmCurrentSurfaceForPicker());
      const row = kind === 'accent' ? {name,hex} : {name,hex,intensity:loadRpcmSurfaceIntensity()};
      if (!normalizeRpcmAccentHex(row.hex)) { notify('현재 색상값을 확인할 수 없습니다.','error'); return; }
      if (existing >= 0) presets[existing] = row;
      else {
        if (presets.length >= 12) { notify(`${label}은 최대 12개까지 저장할 수 있습니다.`, 'warn'); return; }
        presets.push(row);
      }
      if (!saveRpcmPalettePresets(kind,presets)) { notify(`${label} 저장에 실패했습니다.`, 'error'); return; }
      refreshPaletteDots(true);
      notify(`${label}을 저장했습니다.`, 'success',2000);
    };
    const deletePalette = (kind,index) => {
      const presets = loadRpcmPalettePresets(kind);
      if (!Number.isInteger(index) || !presets[index]) return;
      if (!confirm(`저장된 ${kind === 'accent' ? '강조색' : '배경색·농담'} '${presets[index].name}'을 삭제할까요?`)) return;
      presets.splice(index,1);
      if (!saveRpcmPalettePresets(kind,presets)) { notify('저장색 삭제에 실패했습니다.','error'); return; }
      refreshPaletteDots(true);
    };
    for (const details of pickers) {
      const grid = details.querySelector('[data-rpcm-palette-grid]');
      if (grid) {
        // Event delegation keeps handlers stable when the swatch grid is replaced.
        grid.onclick = event => {
          if (grid.dataset.suppressClick === '1') { grid.dataset.suppressClick = ''; return; }
          if (event.target.closest('[data-rpcm-palette-save]')) { saveCurrentPalette(String(details.dataset.rpcmThemePicker || 'accent')); return; }
          const dot = event.target.closest('[data-rpcm-palette-swatch]');
          if (!dot || !grid.contains(dot)) return;
          const index = Number(dot.dataset.rpcmPaletteSwatch);
          const preset = loadRpcmPalettePresets(String(details.dataset.rpcmThemePicker || 'accent'))[index];
          if (!preset) return;
          applyRpcmPalettePreset(String(details.dataset.rpcmThemePicker || 'accent'),preset);
          if (intensitySlider) intensitySlider.value = String(loadRpcmSurfaceIntensity());
          if (intensityLabel) intensityLabel.textContent = `${loadRpcmSurfaceIntensity()}%`;
          refreshAllPickers();
          // Keep the picker open, show the applied color code immediately.
        };
        grid.oncontextmenu = event => {
          const dot = event.target.closest('[data-rpcm-palette-swatch]');
          if (!dot) return;
          event.preventDefault();
          deletePalette(String(details.dataset.rpcmThemePicker || 'accent'),Number(dot.dataset.rpcmPaletteSwatch));
        };
        // Saved palette deletion is exclusively available through swatch right-click.
      }
      const resetAll = details.querySelector('[data-rpcm-palette-reset]');
      if (resetAll) resetAll.onclick = () => {
        if (!confirm('현재 강조색·배경색·농담을 기본값으로 돌릴까요? 저장된 이름별 팔레트는 유지됩니다.')) return;
        saveRpcmAccentTheme(''); saveRpcmSurfaceTheme(''); saveRpcmSurfaceIntensity(24); state.quickThemeDraftHex=''; state.quickSurfaceDraftHex='';
        if (intensitySlider) intensitySlider.value = '24';
        if (intensityLabel) intensityLabel.textContent = '24%';
        refreshAllPickers();
      };
    }
  }

  function renderQuickInjectionPanel() {
    const backdrop = state.quickPanel;
    if (!backdrop?.isConnected) return;
    // 체크 반영 등으로 팔레트 DOM이 교체되기 직전이면 마지막 드래그 미리보기를 먼저 확정합니다.
    if (state.quickThemeDraftHex) {
      saveRpcmAccentTheme(state.quickThemeDraftHex);
      state.quickThemeDraftHex = '';
    }
    if (state.quickSurfaceDraftHex) {
      saveRpcmSurfaceTheme(state.quickSurfaceDraftHex);
      state.quickSurfaceDraftHex = '';
    }
    const savedPaletteScrollTop = backdrop.querySelector('[data-rpcm-theme-stack]')?.scrollTop || 0;
    const room = state.currentRoom;
    const pending = room?.pending;
    const managedRows = pending ? quickManageItems(pending) : [];
    const availableRows = pending ? quickUninjectedSlotRows(room, pending) : [];
    const liveByKey = new Map();
    // 제거된 캐릭터/OOC는 quickManageItems와 quickUninjectedSlotRows 양쪽에 잡힐 수 있습니다.
    // 이 경우 available 정보가 있는 쪽을 최종 행으로 사용해 안내 문구를 유지합니다.
    for (const row of managedRows) if (row?.key) liveByKey.set(row.key, row);
    for (const row of availableRows) if (row?.key) liveByKey.set(row.key, row);

    const activeLiveKeys = new Set(managedRows.filter(row => row.active).map(row => row.key));
    const inactiveLiveKeys = new Set(availableRows.map(row => row.key));
    const effectiveSectionFor = row => {
      const key = String(row?.key || '');
      const queued = key && state.quickDesired.has(key) ? state.quickDesired.get(key) : null;
      if (queued === true) return 'active';
      if (queued === false) {
        const group = String(row?.item?.group || '');
        return ['character','extra'].includes(group) ? 'inactive' : 'removed';
      }
      if (activeLiveKeys.has(key)) return 'active';
      if (inactiveLiveKeys.has(key)) return 'inactive';
      return 'removed';
    };

    // 새로 연 시점의 그룹 배치를 스냅샷으로 고정합니다.
    // 이후 서버 반영으로 실제 active 상태가 바뀌어도 이 창을 닫기 전에는 행 위치를 옮기지 않습니다.
    if (!pending) {
      state.quickPanelLayout = null;
    } else {
      const roomId = String(room?.chatId || '');
      if (!state.quickPanelLayout || state.quickPanelLayout.roomId !== roomId) {
        const layout = { roomId, inactive:[], active:[], removed:[] };
        const seen = new Set();
        const sourceRows = [
          ...availableRows,
          ...managedRows.filter(row => row.active),
          ...managedRows.filter(row => !row.active),
        ];
        for (const row of sourceRows) {
          if (!row?.key || seen.has(row.key)) continue;
          seen.add(row.key);
          layout[effectiveSectionFor(row)].push(row.key);
        }
        state.quickPanelLayout = layout;
      } else {
        // 자동 갱신 등으로 이 창을 연 뒤 완전히 새로운 항목이 생긴 경우에만 현재 상태 그룹 끝에 추가합니다.
        // 이미 보이던 항목은 체크 상태가 바뀌어도 기존 그룹 위치를 그대로 유지합니다.
        const known = new Set([
          ...state.quickPanelLayout.inactive,
          ...state.quickPanelLayout.active,
          ...state.quickPanelLayout.removed,
        ]);
        for (const row of liveByKey.values()) {
          if (!row?.key || known.has(row.key)) continue;
          state.quickPanelLayout[effectiveSectionFor(row)].push(row.key);
          known.add(row.key);
        }
      }
    }

    const layout = state.quickPanelLayout;
    const rowsFromLayout = name => layout
      ? (layout[name] || []).map(key => liveByKey.get(key)).filter(Boolean)
      : [];
    const inactive = pending ? rowsFromLayout('inactive') : [];
    const active = pending ? rowsFromLayout('active') : [];
    const removed = pending ? rowsFromLayout('removed') : [];
    const actualActive = managedRows.filter(row => row.active);
    const stats = statsForItems(actualActive.map(row => row.item));
    const capacity = carrierCapacityForUi(room, stats.block, buildContextBlockFromItems(actualActive.map(row => row.item)));
    const monitor = quickMonitorStatus(room);
    const rowHtml = (row, index) => {
      const item = row.item;
      const category = itemCategory(item);
      const queued = state.quickDesired.has(row.key) ? state.quickDesired.get(row.key) : row.active;
      const meta = row.available
        ? `${formatCount(String(item.content || '').length)}자 · ${row.sessionRemoved ? '이번 주입에서 제외됨 · 체크하면 다시 추가' : '현재 미주입 · 체크하면 이번 주입에만 추가'} · ${esc(remainingLabelForItem(item))}`
        : `${formatCount(String(item.content || '').length)}자 · ${esc(remainingLabelForItem(item))}${itemReason(item) ? ` · ${esc(itemReason(item))}` : ''}${relatedLogEvidence(item) ? ` · ${esc(relatedLogEvidence(item))}` : ''}`;
      return `<label data-key="quick-${esc(row.key)}" class="rpcm-quick-row${queued ? '' : ' is-off'}">
        <input type="checkbox" data-rpcm-quick-index="${index}" ${queued ? 'checked' : ''} ${state.quickApplying ? 'disabled' : ''}>
        <span class="rpcm-quick-badge tone-${categoryTone(category)}">${esc(category)}</span>
        <span class="rpcm-quick-copy"><strong>${esc(item.title || category)}</strong><small>${meta}</small></span>
      </label>`;
    };
    const sectionOpen = state.quickSectionOpen || (state.quickSectionOpen = { inactive:false, active:true });
    const sectionHtml = (name, title, rowsForSection, startIndex, openByDefault, muted = false) => {
      const open = sectionOpen[name] == null ? openByDefault : !!sectionOpen[name];
      return `<details class="rpcm-quick-group${muted ? ' is-muted' : ''}" data-rpcm-quick-section="${name}" ${open ? 'open' : ''}><summary class="rpcm-quick-group-title${muted ? ' is-muted' : ''}"><span class="rpcm-quick-group-main"><b>${esc(title)}</b><em>${rowsForSection.length}</em></span><span class="rpcm-quick-group-action">${open ? '접기' : '펴기'}</span></summary><div class="rpcm-quick-group-body">${rowsForSection.length ? rowsForSection.map((row, offset) => rowHtml(row, startIndex + offset)).join('') : '<div class="rpcm-quick-empty is-compact">해당 항목이 없습니다.</div>'}</div></details>`;
    };
    const ordered = [...inactive, ...active, ...removed];
    rpcmPatchHtml(backdrop, `<div class="rpcm-quick-shade" data-key="shade"></div><aside class="rpcm-quick-panel" data-key="panel" role="dialog" aria-modal="true" aria-label="Quick Monitor">
      <div class="rpcm-quick-head">${quickMonitorRing(monitor)}<div><strong>Quick Monitor</strong><span>${monitor.label} · ${actualActive.length}개 · ${formatCount(monitor.used)} / 50,000자 · ${monitor.percent}%${capacity.byteKnown && pending ? ` · ${rpcmCarrierWireState.utf16 ? 'UTF-8/UTF-16LE' : 'UTF-8'} 요청 ${formatCount(capacity.payloadBytes)} / ${formatCount(capacity.byteLimit)}B` : ''}</span></div><button type="button" class="rpcm-quick-close" aria-label="닫기" data-rpcm-close="icon">✕</button></div>
      <div class="rpcm-monitor-summary"><span class="rpcm-monitor-state${monitor.warning ? ' is-warning' : ''}">${monitor.label}</span><span class="rpcm-monitor-issues">확인할 일 ${monitor.warningCount}</span>${monitor.capacityNear ? '<span class="rpcm-monitor-issues">정리 권장</span>' : ''}<div class="rpcm-monitor-categories">${quickMonitorCategories(monitor.items)}</div></div>
      <div class="rpcm-quick-note">${pending ? '미주입 캐릭터·OOC는 체크하면 현재 주입에만 추가됩니다. 주입 중 항목의 체크를 끄면 현재 주입에서만 빠집니다. 체크 변경은 즉시 반영되지만 항목 위치는 이 창을 닫을 때까지 고정되며, 다시 열면 변경된 주입 상태에 맞춰 이동합니다. 저장된 원문과 다음 주입의 기본 선택은 바뀌지 않습니다.' : '현재 주입은 꺼져 있습니다. 전체 RP Manager에서 자료집을 포함한 다음 주입 구성을 확인할 수 있습니다.'}${room?._logBudgetInfo?.omitted ? ` · 로그 ${room._logBudgetInfo.omitted}개 용량 제외${room._logBudgetInfo.omittedTitles?.length ? `: ${esc(room._logBudgetInfo.omittedTitles.join(', '))}` : ''}` : ''}${loreBudgetInfoFor(room)?.candidates > loreBudgetInfoFor(room)?.included ? ` · 자료집 ${loreBudgetInfoFor(room).candidates - loreBudgetInfoFor(room).included}개 용량 제외${loreBudgetInfoFor(room)?.omittedTitles?.length ? `: ${esc(loreBudgetInfoFor(room).omittedTitles.join(', '))}` : ''}` : ''}</div>
      <div class="rpcm-quick-list" data-key="list">
        ${pending ? sectionHtml('inactive', '미주입 항목', inactive, 0, false, true) : ''}
        ${sectionHtml('active', '주입 중', active, inactive.length, true, false)}
        ${removed.length ? `<div class="rpcm-quick-group-title is-muted">이번 주입에서 끈 항목 ${removed.length}</div>${removed.map((row, index) => rowHtml(row, inactive.length + active.length + index)).join('')}` : ''}
      </div>
      ${quickThemePickerHtml()}
      <div class="rpcm-quick-foot"><span>${state.quickApplying ? '서버에 반영 중…' : state.quickDesired.size ? '변경 사항을 곧 반영합니다…' : pending ? '여러 항목을 연달아 바꾸면 한 번에 반영됩니다.' : '주입 시작 전 구성을 확인하세요.'}</span><button type="button" class="rpcm-btn secondary rpcm-quick-open-full">전체 RP Manager</button>${pending ? '<button type="button" class="rpcm-btn warn rpcm-quick-disarm">주입 해제</button>' : '<button type="button" class="rpcm-btn primary rpcm-quick-arm">주입 시작</button>'}<button type="button" class="rpcm-btn secondary rpcm-quick-done" aria-label="닫기" data-rpcm-close="text">닫기</button></div>
    </aside>`);

    backdrop.querySelector('.rpcm-quick-shade').onclick = () => closeQuickInjectionPanel();
    backdrop.querySelector('.rpcm-quick-close').onclick = () => closeQuickInjectionPanel();
    backdrop.querySelector('.rpcm-quick-done').onclick = () => closeQuickInjectionPanel();
    if (backdrop.querySelector('.rpcm-quick-arm')) backdrop.querySelector('.rpcm-quick-arm').onclick = async event => { event.currentTarget.disabled = true; try { await armInjection(room); renderQuickInjectionPanel(); updateFab(); } catch (error) { notify(`주입 시작 실패: ${error.message}`, 'error'); event.currentTarget.disabled = false; } };
    if (backdrop.querySelector('.rpcm-quick-disarm')) backdrop.querySelector('.rpcm-quick-disarm').onclick = async event => {
      event.currentTarget.disabled = true;
      clearTimeout(state.quickApplyTimer); state.quickApplyTimer = null; state.quickDesired.clear();
      try { await restorePending(room, 'manual'); renderQuickInjectionPanel(); updateFab(); }
      catch (error) { notify(`주입 해제 실패: ${error.message}`, 'error'); if (event.currentTarget.isConnected) event.currentTarget.disabled = false; }
    };

    backdrop.querySelector('.rpcm-quick-open-full').onclick = async () => {
      if (state.quickDesired.size) {
        clearTimeout(state.quickApplyTimer);
        state.quickApplyTimer = null;
        await applyQueuedQuickChanges();
      }
      closeQuickInjectionPanel();
      await openModal();
    };
    backdrop.querySelectorAll('[data-rpcm-quick-section]').forEach(details => {
      details.ontoggle = () => {
        const name = String(details.dataset.rpcmQuickSection || '');
        if (name) state.quickSectionOpen[name] = !!details.open;
        const action = details.querySelector('.rpcm-quick-group-action');
        if (action) action.textContent = details.open ? '접기' : '펴기';
      };
    });
    bindQuickThemePicker(backdrop);
    const paletteStack = backdrop.querySelector('[data-rpcm-theme-stack]');
    if (paletteStack) paletteStack.scrollTop = savedPaletteScrollTop;
    backdrop.querySelectorAll('[data-rpcm-quick-index]').forEach(input => {
      input.onchange = () => {
        const row = ordered[Number(input.dataset.rpcmQuickIndex)];
        if (!row) return;
        input.closest('.rpcm-quick-row')?.classList.toggle('is-off', !input.checked);
        queueQuickItemToggle(row.key, input.checked);
        const note = backdrop.querySelector('.rpcm-quick-foot>span');
        if (note) note.textContent = '변경 사항을 곧 반영합니다…';
      };
    });
  }

  // 버튼을 누르는 동안 필요한 방 초기화를 시작합니다. 현재 방이 준비돼 있으면
  // 여는 순간 메타 API를 다시 기다리지 않고 같은 메모리 상태를 사용합니다.
  function prepareManagerOpenRoom(chatId) {
    const roomKey = getRoomScopeKey(chatId);
    if (state.currentChatId === roomKey && state.currentRoom?.chatId === roomKey) return state.currentRoom;
    if (state.managerOpenRoomScope === roomKey && state.managerOpenRoomPromise) return state.managerOpenRoomPromise;
    state.managerOpenRoomScope = roomKey;
    const pending = ensureCurrentRoom(chatId).then(() => {
      if (getRoomScopeKey(getChatIdFromPath()) !== roomKey || state.currentRoom?.chatId !== roomKey) {
        throw new Error('채팅방이 바뀌었습니다. 현재 방에서 다시 열어 주세요.');
      }
      return state.currentRoom;
    }).finally(() => {
      if (state.managerOpenRoomPromise === pending) {
        state.managerOpenRoomPromise = null;
        state.managerOpenRoomScope = '';
      }
    });
    state.managerOpenRoomPromise = pending;
    return pending;
  }

  async function openQuickInjectionPanel() {
    const chatId = getChatIdFromPath();
    if (!chatId) {
      notify('채팅방 화면에서만 사용할 수 있습니다.', 'warn');
      return;
    }
    const roomReady = prepareManagerOpenRoom(chatId);
    if (roomReady?.then) await roomReady;
    manualRestoreDrafts(state.currentRoom);
    if (state.modal) closeModal();
    closeQuickInjectionPanel();
    // 새로 열 때는 미주입 목록을 기본 접힘, 현재 주입 목록을 기본 펼침으로 시작합니다.
    state.quickSectionOpen = { inactive:false, active:true };
    state.quickThemePickerOpen = false;
    state.quickSurfacePickerOpen = false;
    state.quickThemeDraftHex = '';
    state.quickSurfaceDraftHex = '';
    const backdrop = document.createElement('div');
    backdrop.id = 'rpcm-quick-backdrop';
    document.body.appendChild(backdrop);
    state.quickPanel = backdrop;
    backdrop.addEventListener('keydown', event => {
      if (event.key === 'Escape') closeQuickInjectionPanel();
    });
    renderQuickInjectionPanel();
    backdrop.querySelector('.rpcm-quick-close')?.focus();
    updateFab();
  }

  // v0.14.94: pseudo-element 원형 채움 진행률을 브라우저별 transform 표현 차이에도 안전하게 읽습니다.
  function rpcmMonitorFillProgress(trigger, pressedAt, holdMs) {
    const fallback=Math.max(0,Math.min(1,(performance.now()-pressedAt)/Math.max(1,holdMs)));
    try {
      const transform=getComputedStyle(trigger,'::before').transform;
      if(!transform||transform==='none')return fallback;
      const Matrix=globalThis.DOMMatrixReadOnly||globalThis.WebKitCSSMatrix;
      if(typeof Matrix==='function'){
        const matrix=new Matrix(transform),scale=Math.hypot(Number(matrix.a??matrix.m11??0),Number(matrix.b??matrix.m12??0));
        if(Number.isFinite(scale)&&scale>=0)return Math.max(0,Math.min(1,scale));
      }
      const match=transform.match(/^matrix\(([^)]+)\)$/);
      if(match){const scale=Math.abs(Number(match[1].split(',')[0]));if(Number.isFinite(scale))return Math.max(0,Math.min(1,scale));}
    } catch (_) {}
    return fallback;
  }

  // The monitor lives in the stable header action row; composer controls are never used as anchors.
  function rpcmBindMonitorPress(trigger) {
    let holdTimer=0, openTimer=0, resetTimer=0, fired=false, pointerId=null, pressRoomId='', pressedAt=0, startX=0, startY=0;
    const tapMs=360, holdMs=540;
    const warmRoom=()=>{const chatId=getChatIdFromPath();if(chatId){const ready=prepareManagerOpenRoom(chatId);if(ready?.then)ready.catch(()=>{});}};
    const releasePointer=()=>{
      const id=pointerId;pointerId=null;
      try{if(id!=null&&trigger.hasPointerCapture(id))trigger.releasePointerCapture(id);}catch(_){}
    };
    const clear=(completed=false)=>{
      clearTimeout(holdTimer);holdTimer=0;clearTimeout(openTimer);openTimer=0;
      clearTimeout(resetTimer);resetTimer=0;trigger.classList.remove('is-holding','is-hold-complete');
      releasePointer();trigger.rpcmPressRoomId='';trigger.style.removeProperty('--rpcm-fill-start');
      if(completed){trigger.classList.add('is-hold-complete');resetTimer=setTimeout(()=>trigger.classList.remove('is-hold-complete'),180);}
    };
    const valid=()=>trigger.isConnected&&!trigger.disabled&&pressRoomId===String(state.currentChatId||'');
    const cancel=()=>{fired=true;clear();};trigger.rpcmCancelHold=cancel;
    const finishQuick=()=>{
      if(!valid()){cancel();return;}clear(true);
      if(state.quickPanel)closeQuickInjectionPanel();else openQuickInjectionPanel().catch(error=>notify(error.message,'error'));
    };
    trigger.oncontextmenu=event=>event.preventDefault();
    document.addEventListener('visibilitychange',()=>{if(document.hidden)cancel();});
    trigger.onpointerdown=event=>{
      if(trigger.disabled||event.isPrimary===false||(event.button!==undefined&&event.button!==0)||openTimer)return;
      event.preventDefault();event.stopPropagation();clear();fired=false;pointerId=event.pointerId;pressRoomId=String(state.currentChatId||'');trigger.rpcmPressRoomId=pressRoomId;pressedAt=performance.now();startX=event.clientX;startY=event.clientY;
      trigger.style.setProperty('--rpcm-hold-ms',`${holdMs}ms`);
      trigger.classList.add('is-holding');warmRoom();
      try{trigger.setPointerCapture(pointerId);}catch(_){}
      holdTimer=setTimeout(()=>{
        if(!valid()){cancel();return;}fired=true;clear(true);
        try{navigator.vibrate?.(12);}catch(_){}
        closeQuickInjectionPanel();openModal().catch(error=>notify(error.message,'error'));
      },holdMs);
    };
    trigger.onpointermove=event=>{if(pointerId===event.pointerId&&Math.hypot(event.clientX-startX,event.clientY-startY)>14)cancel();};
    trigger.onpointercancel=cancel;
    trigger.onlostpointercapture=()=>{if(pointerId!==null&&holdTimer&&!fired)cancel();};
    trigger.onpointerup=event=>{
      if(pointerId===null||pointerId!==event.pointerId)return;
      event.stopPropagation();const tapped=!fired;clearTimeout(holdTimer);holdTimer=0;releasePointer();fired=true;
      if(tapped){
        const elapsed=performance.now()-pressedAt;
        const remaining=Math.max(0,tapMs-elapsed);
        // 길게 누르기 진행률을 유지하고, 손을 떼면 남은 채우기만 짧게 마칩니다.
        const progress=rpcmMonitorFillProgress(trigger,pressedAt,holdMs);
        trigger.classList.remove('is-holding');
        trigger.style.setProperty('--rpcm-fill-start',String(progress));
        trigger.style.setProperty('--rpcm-hold-ms',`${remaining}ms`);
        void trigger.offsetWidth;
        trigger.classList.add('is-holding');
        if(!remaining)finishQuick();
        else openTimer=setTimeout(()=>{openTimer=0;finishQuick();},remaining);
      }else clear();
    };
    trigger.onclick=event=>{
      if(event.detail!==0||trigger.disabled||openTimer||pointerId!==null)return;
      clear();pressRoomId=String(state.currentChatId||'');trigger.rpcmPressRoomId=pressRoomId;
      trigger.style.setProperty('--rpcm-hold-ms','360ms');trigger.classList.add('is-holding');warmRoom();
      openTimer=setTimeout(()=>{openTimer=0;finishQuick();},360);
    };
  }
