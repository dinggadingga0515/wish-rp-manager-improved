  }

  async function setRpcmCarrierEncoding(_room,enabled){
    if(state.carrierEncodingSettingBusy||state.fullBackupRestoreBusy||state.fullBackupRestoreNeedsReload||wrpmFullBackupV2.isBusy())throw new Error('다른 설정·백업·복원 작업이 끝난 뒤 변경해 주세요.');
    if(rpcmCarrierWireState.activeWrites||state.pendingCarrierSyncQueues?.size)throw new Error('주입·교정 전송이 끝난 뒤 인코딩을 변경해 주세요.');
    const next={version:1,encoding:enabled?'utf-16le':'utf-8',changeId:crypto.randomUUID()};
    state.carrierEncodingSettingBusy=true;
    try{
      try{await GM_setValue('RPCM_carrier_encoding_global_v1',next);}
      catch(error){if(GM_getValue('RPCM_carrier_encoding_global_v1',null)?.changeId!==next.changeId)throw error;}
      const stored=GM_getValue('RPCM_carrier_encoding_global_v1',null);
      if(stored?.changeId!==next.changeId||stored.encoding!==next.encoding)throw new Error('다른 탭에서 설정이 바뀌었습니다. 현재 전역 선택을 확인해 주세요.');
      // Room records, active injections and server messages are never rewritten here.
      if(enabled){try{localStorage.removeItem(RPCM_CARRIER_UTF16_REFUSED_KEY);}catch(_){}rpcmCarrierWireState.utf16=true;rpcmCarrierWireState.reason='';}
      return stored.encoding;
    }finally{state.carrierEncodingSettingBusy=false;}
  }

  function rpcmCarrierWire(message,room=state.currentRoom) {
    const json=JSON.stringify({message:String(message||'')}),utf8Bytes=utf8ByteLength(json),utf16Bytes=json.length*2;
    const selectedEncoding=rpcmCarrierEncoding(room),encoding=selectedEncoding==='utf-16le'&&rpcmCarrierWireState.utf16?'utf-16le':'utf-8';
    return {json,utf8Bytes,bytes:encoding==='utf-16le'?utf16Bytes:utf8Bytes,encoding,selectedEncoding};
  }

  function rpcmUtf16leBlob(json) {
    const bytes = new Uint8Array(json.length * 2);
    for (let index=0; index<json.length; index++) {
      const unit=json.charCodeAt(index); bytes[index*2]=unit & 255; bytes[index*2+1]=unit >>> 8;
    }
    return new Blob([bytes], {type:'application/json;charset=utf-16le'});
  }

  function rpcmDetectionOwners(items) {
    const owners = new Map();
    for (const item of items || []) {
      const owner = normalizedRecallTerm(item?.title);
      if (!owner) continue;
      for (const term of characterDetectionTerms(item)) {
        const key = normalizedRecallTerm(term);
        if (!owners.has(key)) owners.set(key,new Set());
        owners.get(key).add(owner);
      }
    }
    return owners;
  }

  function rpcmPreparePersonScan(room) {
    // A synchronous snapshot only. Nothing survives an await or goes into the DB.
    const scan = {cards:normalizeKnowledgeCards(room), records:normalizePersonStateRecords(room)};
    scan.player = currentPersonPlayerName(room,scan);
    scan.conflicts = knowledgeConflicts(room,scan.cards);
    scan.bundles = personInformationBundles(room,scan);
    scan.slots = new Map();
    const characters = (room.slots || []).filter(slot => slot.group === 'character');
    const termSlots = new Map();
    for (const slot of characters) {
      const title=String(slot.title || '').trim();
      if (!scan.slots.has(title)) scan.slots.set(title,slot);
      for (const term of characterDetectionTerms(slot)) {
        const key=normalizedRecallTerm(term);
        if (!termSlots.has(key)) termSlots.set(key,new Set()); termSlots.get(key).add(slot);
      }
    }
    const matches = new Map(), identities = new Map();
    for (const bundle of scan.bundles) {
      const exact = scan.slots.get(bundle.name);
      const candidates = exact ? [exact] : [...(termSlots.get(normalizedRecallTerm(bundle.name)) || [])];
      if (candidates.length !== 1) continue;
      const slot=candidates[0]; matches.set(bundle.name,slot);
      if (!identities.has(slot)) identities.set(slot,new Set()); identities.get(slot).add(bundle.name);
    }
    for (const [name,slot] of matches) {
      // One slot representing multiple independent person names is not an identity merge.
      if (identities.get(slot).size > 1 && String(slot.title || '').trim() !== name) continue;
      scan.slots.set(name,{...slot,title:name,aliases:[...characterAutomaticTerms(slot),...(Array.isArray(slot.aliases) ? slot.aliases : [])]});
    }
    const ownerItems = characters.map(slot => {
      const names=identities.get(slot);
      if (names?.size !== 1) return slot;
      return scan.slots.get([...names][0]) || slot;
    });
    scan.owners = rpcmDetectionOwners([...ownerItems,...scan.bundles.map(bundle => ({title:bundle.name}))]);
    return scan;
  }

  function rpcmCausalRecallLinks(index, query, characters) {
    // Explicit non-person alias equivalence, never an inferred causal event or rewritten log.
    const allowed = new Set(['object','event','location']);
    const groups = (index.explicitAliasGroups || []).filter(group => group.every(term => !characters.has(term))
      && group.some(term => allowed.has(index.categories.get(term))));
    const owners = new Map();
    groups.forEach((group,i) => group.forEach(term => {
      if (!owners.has(term)) owners.set(term,new Set()); owners.get(term).add(i);
    }));
    const links = [], seen=new Set();
    for (const group of groups) {
      const anchor = group.find(term => term.length >= 3 && owners.get(term)?.size === 1 && aliasAppears(query.primary,term));
      if (!anchor) continue;
      for (const term of group) {
        if (term.length < 3 || owners.get(term)?.size !== 1 || aliasAppears(query.primary,term) || seen.has(term)) continue;
        seen.add(term); links.push({anchor,term});
        if (links.length >= 12) return links;
      }
    }
    return links;
  }


  function carrierRequestMetrics(nextText,room=state.currentRoom) {
    const message = String(nextText || '');
    const wire = rpcmCarrierWire(message,room);
    return { chars:message.length, messageBytes:utf8ByteLength(message),
      payloadBytes:wire.bytes, utf8PayloadBytes:wire.utf8Bytes, encoding:wire.encoding };
  }

  function carrierRequestWithinLimits(room, nextText, limits = null) {
    const metrics = carrierRequestMetrics(nextText,room),maxChars=Number(room?.maxChars)||APP.defaultMaxChars;
    const byteLimit=Math.min(APP.safeCarrierPayloadBytes,Number.isFinite(Number(limits?.byteBudget))?Math.max(0,Number(limits.byteBudget)):APP.safeCarrierPayloadBytes);
    return metrics.chars <= maxChars && metrics.payloadBytes <= byteLimit;
  }

  function assertCarrierRequestWithinLimits(room, nextText, prefix = 'carrier 총 길이', limits = null) {
    const metrics = carrierRequestMetrics(nextText,room);
    const maxChars = Number(room?.maxChars) || APP.defaultMaxChars;
    const byteLimit=Math.min(APP.safeCarrierPayloadBytes,Number.isFinite(Number(limits?.byteBudget))?Math.max(0,Number(limits.byteBudget)):APP.safeCarrierPayloadBytes);
    if (metrics.chars > maxChars) throw new Error(`${prefix}가 ${formatCount(metrics.chars)}자입니다. 설정 한도 ${formatCount(maxChars)}자를 넘습니다.`);
    if (metrics.payloadBytes > byteLimit) {
      throw new Error(`${prefix}의 ${metrics.encoding.toUpperCase()} 요청 크기가 ${formatCount(metrics.payloadBytes)}바이트입니다. 서버 안전선 ${formatCount(byteLimit)}바이트를 넘습니다. 날짜로그를 모두 제외해도 초과하므로 현재상태·타임라인·캐릭터·중요 물품·기타 중 일부를 줄이거나 주입 해제해 주세요.`);
    }
    return metrics;
  }

  function carrierOriginalCharsForUi(room) {
    if (room?.pending) {
      const chars = Number(room.pending.originalChars);
      return Number.isFinite(chars) && chars >= 0 ? chars : null;
    }
    const preview = state.carrierCapacityPreview;
    if (!preview || String(preview.roomId || '') !== String(room?.chatId || '') || preview.loading || preview.error) return null;
    const chars = Number(preview.originalChars);
    return Number.isFinite(chars) && chars >= 0 ? chars : null;
  }

  function carrierOriginalTextForUi(room) {
    if (room?.pending) return String(room.pending.originalText || '');
    const preview = state.carrierCapacityPreview;
    if (!preview || String(preview.roomId || '') !== String(room?.chatId || '') || preview.loading || preview.error || typeof preview.originalText !== 'string') return null;
    return preview.originalText;
  }

  function carrierCapacityForUi(room, contextChars = 0, contextBlock = '') {
    const max = Number(room?.maxChars) || APP.defaultMaxChars;
    const context = Math.max(0, Number(contextChars) || 0);
    const original = carrierOriginalCharsForUi(room);
    const known = original !== null;
    const separator = context > 0 ? 2 : 0;
    const originalText = carrierOriginalTextForUi(room);
    const payloadMetrics = originalText !== null && String(contextBlock || '')
      ? carrierRequestMetrics(buildInjectedMessage(originalText, String(contextBlock || '')),room)
      : null;
    const stored=room?.pending,storedBytes=Number(stored?.carrierPayloadBytes)||0;
    const verifiedStorage=!!stored?.verified&&['utf-8','utf-16le'].includes(stored?.carrierEncoding)&&storedBytes>0;
    return {
      max,
      context,
      original:known ? original : 0,
      separator:known ? separator : 0,
      total:known ? original + separator + context : context,
      availableContext:known ? Math.max(0, max - original - separator) : max,
      payloadBytes:storedBytes||payloadMetrics?.payloadBytes||0,
      messageBytes:Number(stored?.carrierMessageBytes)||payloadMetrics?.messageBytes||0,
      encoding:verifiedStorage?stored.carrierEncoding:payloadMetrics?.encoding||'',
      byteSource:verifiedStorage?'verified':storedBytes?'legacy':payloadMetrics?'estimate':'unknown',
      estimatedPayloadBytes:payloadMetrics?.payloadBytes??null,
      estimatedEncoding:payloadMetrics?.encoding||'',
      byteLimit:APP.safeCarrierPayloadBytes,
      byteKnown:!!storedBytes||!!payloadMetrics,
      known,
      loading:!room?.pending && !!state.carrierCapacityPreview?.loading && String(state.carrierCapacityPreview?.roomId || '') === String(room?.chatId || ''),
      error:!room?.pending && String(state.carrierCapacityPreview?.roomId || '') === String(room?.chatId || '') ? String(state.carrierCapacityPreview?.error || '') : '',
    };
  }

  function carrierCapacityDetailText(room, capacity) {
    if (capacity.known) {
      const answerLabel = room?.pending ? '현재 AI 답변' : '최신 AI 답변';
      const encoding=capacity.encoding==='utf-16le'?'UTF-16LE':'UTF-8';
      const estimate=capacity.estimatedEncoding==='utf-16le'?'UTF-16LE':'UTF-8';
      const byteText = !capacity.byteKnown?'':capacity.byteSource==='verified'
        ? ` · 검증된 저장본 ${encoding} 요청 ${formatCount(capacity.payloadBytes)} / ${formatCount(capacity.byteLimit)}B 안전선${capacity.estimatedPayloadBytes!==null&&(capacity.estimatedPayloadBytes!==capacity.payloadBytes||capacity.estimatedEncoding!==capacity.encoding)?` · 현재 설정 예상 ${estimate} ${formatCount(capacity.estimatedPayloadBytes)}B`:''}`
        : capacity.byteSource==='legacy'
          ? ` · 기존 요청 기록 ${formatCount(capacity.payloadBytes)}B (인코딩 미확인)${capacity.estimatedPayloadBytes!==null?` · 현재 설정 예상 ${estimate} ${formatCount(capacity.estimatedPayloadBytes)} / ${formatCount(capacity.byteLimit)}B`:''}`
          : ` · 다음 주입 예상 ${estimate} 요청 ${formatCount(capacity.payloadBytes)} / ${formatCount(capacity.byteLimit)}B 안전선`;
      return `주입 자료 ${formatCount(capacity.context)}자 + ${answerLabel} ${formatCount(capacity.original)}자 + 연결 ${capacity.separator}자 = 총 ${formatCount(capacity.total)}자${byteText}`;
    }
    if (capacity.loading) return `주입 자료 ${formatCount(capacity.context)}자 · 최신 AI 답변 길이 확인 중…`;
    if (capacity.error) return `주입 자료 ${formatCount(capacity.context)}자 · 최신 AI 답변 길이를 확인하지 못했습니다.`;
    return `주입 자료 ${formatCount(capacity.context)}자 · 실제 한도에는 최신 AI 답변 본문도 포함됩니다.`;
  }

  function fitLogItemsToBudget(room, baseItems, logItems, contextBudget = null, appendBudgetInfo = false) {
