  function fullRebuildCurrentOutputSizes(room) {
    const snapshot=structuredClone(room),rows=[];
    const slot=id=>String((snapshot.slots||[]).find(item=>item.id===id)?.content||'');
    rows.push({field:'currentStateText',label:'현재상태',chars:slot('currentState').length});
