  function fullRebuildOutputLimitWarning(room) {
    const near=fullRebuildCurrentOutputSizes(room).filter(row=>row.chars>=FULL_REBUILD_OUTPUT_TEXT_WARN).sort((a,b)=>b.chars-a.chars);
    if(!near.length)return '';
    const lines=near.map(row=>`- ${row.label} (${row.field}): ${Number(row.chars).toLocaleString('ko-KR')}자${row.chars>FULL_REBUILD_OUTPUT_TEXT_MAX?' · 현재 상한 초과':' · 상한 근접'}`).join('\n');
