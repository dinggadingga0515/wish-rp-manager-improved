  // 임시24: 기존 자료/지침이 TXT 한 장을 초과하면 텍스트를 버리지 않고
  // RP source PART와 분리된 AUX TXT로 나눕니다. source/parts/hash/가져오기 계약은 그대로 둡니다.
  function fullRebuildSplitAuxiliaryText(raw,maxChars=410000) {
    const text=String(raw),pieces=[];
    for(let start=0;start<text.length;){
      let end=Math.min(text.length,start+maxChars);
      if(end<text.length){
        const lastNewline=text.lastIndexOf('\n',end-1);
        if(lastNewline>start+Math.floor(maxChars*0.75))end=lastNewline+1;
        // surrogate 쌍(이모지 등)을 파일 경계에서 분리하면 UTF-8 저장 시 손실됩니다.
        if(end<text.length&&end>start){
          const code=text.charCodeAt(end-1),next=text.charCodeAt(end);
          if(code>=0xD800&&code<=0xDBFF&&next>=0xDC00&&next<=0xDFFF)end--;
        }
      }
      if(end<=start)throw new Error('보조 자료 분할 위치를 확정하지 못했습니다.');
      pieces.push(text.slice(start,end));start=end;
    }
    if(pieces.join('')!==text)throw new Error('지침·기존 자료 분할 후 원문 검증에 실패했습니다.');
    return pieces;
  }

  function fullRebuildAuxiliaryFileText(jobId,source,master,fullHash,partHash,piece,index,total) {
    return `[RP_MANAGER_FULL_REBUILD_AUX]\nREBUILD_JOB_ID=${jobId}\nAUX_INDEX=${index}\nAUX_TOTAL=${total}\nSOURCE_SHA256=${source.sha256}\nMASTER_GUIDE_HASH=${master.hash}\nAUX_FULL_SHA256=${fullHash}\nAUX_PART_SHA256=${partHash}\nAUX_CHAR_LENGTH=${piece.length}\n[/RP_MANAGER_FULL_REBUILD_AUX]\n\n보조 자료는 RP PART_TOTAL에 포함되지 않습니다. 모든 AUX를 AUX_INDEX 순서대로 합쳐 원래의 지침·사용자 메모·기존 기억자료를 복원한 다음 RP PART 1..N과 함께 읽으세요. 아래 [AUX_PAYLOAD_BEGIN] 다음 문자를 정확히 AUX_CHAR_LENGTH개 읽은 것이 페이로드입니다. 표시용 개행과 [AUX_PAYLOAD_END]는 제외합니다. 조각 경계에 걸친 태그도 결합 후 해석하세요. 한 조각 또는 RP PART라도 누락되면 성공 JSON을 만들지 마세요.\n\n[AUX_PAYLOAD_BEGIN]\n${piece}\n[AUX_PAYLOAD_END]\n[END_REBUILD_AUX index=${index} total=${total}]`;
  }

  async function createFullRebuildFiles(room) {
    if (state.currentRoom !== room || fullRebuildRuntime.busy || state.saveStatus === 'saving' || state.saveStatus === 'error' || state.autoSaveTimers.has(String(room.chatId || ''))) throw new Error('현재 방의 로컬 저장이 끝난 뒤 전체 재구축 파일을 만들어 주세요.');
    fullRebuildRuntime.busy = true;
    const control=fullRebuildRuntime.control||null;
    try {
      // 전체 RP 조회는 오래 걸릴 수 있으므로 생성 시작 시점의 room 전체 JSON을 끝까지
      // 동결 조건으로 사용하지 않습니다. 먼저 현재 편집을 저장하고, 원문 조회가 끝난 뒤
      // 다시 한 번 정상 로컬 변경을 합친 최신 저장본을 snapshot으로 채택합니다.
      await saveRoom(room,'full-rebuild-export-sync');
      if (state.currentRoom !== room) throw new Error('전체 재구축 준비 중 다른 방으로 이동했습니다.');
      const turns = (await loadManualCompletedTurns(room,{finalFresh:true,control})).map(turn => ({ key:String(turn.key), text:String(turn.text) }));
      if (state.currentRoom !== room) throw new Error('RP 조회 중 다른 방으로 이동했습니다.');
      if (!turns.length) throw new Error('완료된 RP 턴이 없습니다.');
      // 조회 중 자동감지·주기 갱신·사용자 편집이 정상적으로 저장됐더라도 새 파일을
      // 폐기하지 않고, 조회 완료 시점의 최신 room을 이번 재구축 snapshot으로 사용합니다.
      await saveRoom(room,'full-rebuild-export-snapshot');
      if (state.currentRoom !== room) throw new Error('재구축 snapshot 저장 중 다른 방으로 이동했습니다.');
      const snapshotRoom = structuredClone(room);
      const guides = fullRebuildGuides(snapshotRoom), master = fullRebuildMasterMeta();
      const memoBlock = userCanonMemoBlock(snapshotRoom);
      const memoHash = await fullRebuildSha256(memoBlock);
      const source = { roomId:String(room.chatId || ''), chatId:String(apiChatIdOf(snapshotRoom)), firstTurnKey:turns[0].key, lastTurnKey:turns.at(-1).key, turnCount:turns.length, sha256:await manualFullHistoryHash(turns) };
      const loreRefs = manualLoreRefs(snapshotRoom);
      const timelineRun = createStoryTimelineRun(snapshotRoom,activeLogTimelineLabel(snapshotRoom),'update','FULL');
      const guideBodies = `[MASTER_GUIDE]\n${FULL_REBUILD_MASTER_GUIDE_V1}\n[/MASTER_GUIDE]\n\n` +
        Object.entries({currentItems:'CURRENT_ITEMS_GUIDE',dateLogs:'DATE_LOG_GUIDE',personInfo:'PERSON_INFO_GUIDE',timeline:'TIMELINE_GUIDE',lore:'LORE_GUIDE'})
          .map(([key,tag]) => `[${tag}]\n${guides.texts[key]}\n[/${tag}]`).join('\n\n');
      const reference = fullRebuildReferenceText(snapshotRoom,loreRefs,timelineRun);
      const outputSafetyBlock = fullRebuildOutputSafetyText();
      const fixedOverhead = JSON.stringify({source,guides:guides.manifest,master}).length + memoBlock.length + outputSafetyBlock.length + 6200;
      const firstExtra = `${guideBodies}\n\n${reference}`+rpcmDateHintBlock(snapshotRoom,turns,Math.max(0,FULL_REBUILD_PART_TARGET-guideBodies.length-reference.length-fixedOverhead));
      // 첫 PART의 지침·활성 메모·기존 기억자료 등이 기존 목표를 초과할 때만
      // 고정 자료 포함 첫 PART의 크기 허용량을 높입니다. RP 턴/후속 PART 한도는 불변.
      const expandFirstStatic = firstExtra.length + fixedOverhead > FULL_REBUILD_PART_TARGET;
      const firstPartTarget = expandFirstStatic ? FULL_REBUILD_FIRST_STATIC_TARGET : FULL_REBUILD_PART_TARGET;
      const firstTurnLength = fullRebuildTurnText(turns[0]).length + 2;
      const initialSeparateAux = firstExtra.length + fixedOverhead + firstTurnLength > firstPartTarget;
      const jobId = `rebuild-${Date.now().toString(36)}-${Math.random().toString(36).slice(2,9)}`;
      const turnItemLength = turn => `[RP_TURN sourceTurnKey=${JSON.stringify(String(turn.key))}]\n`.length + String(turn.text).length + '\n[/RP_TURN]'.length;

      const planSourceFiles = useAux => {
        const partOverhead = useAux ? JSON.stringify({source,guides:guides.manifest,master}).length + outputSafetyBlock.length + 8500 : fixedOverhead;
        // USER_CANON_MEMO는 비-AUX 모드에서 모든 RP PART에 실제로 반복 수록되므로
        // 후속 PART 예산도 첫 PART와 같은 memoBlock 길이를 포함해야 합니다.
        const laterPartOverhead = partOverhead;
        let firstReserve=0,laterReserve=0;

        const splitTurns = () => {
          const firstTarget = (useAux ? FULL_REBUILD_PART_TARGET : firstPartTarget) - firstReserve;
          const laterTarget = FULL_REBUILD_PART_TARGET - laterReserve;
          if(firstTarget<=0||laterTarget<=0||laterPartOverhead>=laterTarget){
            const error=new Error('PART 공통 manifest가 파일 목표 크기를 넘습니다. 불완전한 자료는 출력하지 않습니다.');
            error.code='RPCM_FULL_REBUILD_PACKING_LIMIT';throw error;
          }
          const chunks=[];
          let current=[],size=(useAux?0:firstExtra.length)+partOverhead,partTarget=firstTarget;
          for(const turn of turns){
            const itemLength=turnItemLength(turn);
            if(current.length&&size+itemLength+2>partTarget){
              chunks.push(current);current=[];size=laterPartOverhead;partTarget=laterTarget;
            }
            if(size+itemLength+2>partTarget){
              const error=new Error(`RP 턴 ${turn.key} 하나가 TXT 안전 크기를 넘습니다. 원문을 훼손하거나 턴을 잘라 저장하지 않았습니다.`);
              error.code='RPCM_FULL_REBUILD_PACKING_LIMIT';throw error;
            }
            current.push(turn);size+=itemLength+2;
          }
          if(current.length)chunks.push(current);
          return chunks;
        };

        const provisionalParts = chunks => chunks.map((part,index)=>({
          index:index+1,total:chunks.length,firstTurnKey:part[0].key,lastTurnKey:part.at(-1).key,turnCount:part.length,sha256:'0'.repeat(64)
        }));

        const sourceFileParts = (part,info,parts,materialize=false) => {
          const header = `[RP_MANAGER_FULL_REBUILD]\nREBUILD_JOB_ID=${jobId}\nPART_INDEX=${info.index}\nPART_TOTAL=${info.total}\nSOURCE_FIRST_TURN=${source.firstTurnKey}\nSOURCE_LAST_TURN=${source.lastTurnKey}\nSOURCE_TURN_COUNT=${source.turnCount}\nSOURCE_SHA256=${source.sha256}\nPART_FIRST_TURN=${info.firstTurnKey}\nPART_LAST_TURN=${info.lastTurnKey}\nPART_TURN_COUNT=${info.turnCount}\nPART_SHA256=${info.sha256}\nMASTER_GUIDE_NAME=${master.name}\nMASTER_GUIDE_VERSION=${master.version}\nMASTER_GUIDE_HASH=${master.hash}\nUSER_CANON_MEMO_SHA256=${memoHash}\n[/RP_MANAGER_FULL_REBUILD]\n\n[SOURCE_MANIFEST]\n${JSON.stringify(source,null,2)}\n[/SOURCE_MANIFEST]\n\n[PARTS_MANIFEST]\n${JSON.stringify(parts,null,2)}\n[/PARTS_MANIFEST]\n\n[GUIDE_MANIFEST]\n${JSON.stringify(guides.manifest,null,2)}\n[/GUIDE_MANIFEST]\n\n${outputSafetyBlock}`;
          const auxNote = useAux
            ? '\n\n지침·사용자 메모·기존 기억자료는 00-보조자료 AUX TXT들에 있습니다. 보조자료 전체를 번호순으로 결합하여 읽으세요. AUX 파일은 RP PART_TOTAL에 포함되지 않습니다.'
            : (info.index === 1 ? `\n\n${firstExtra}` : '\n\n전문 지침과 기존 자료는 1ofN 파일에 있습니다. 같은 작업의 모든 파일을 번호순으로 읽으세요.');
          const prefix = `${externalChatTitleInstruction("rebuild")}\n\n${header}${!useAux&&memoBlock ? `\n\n${memoBlock}` : ''}${auxNote}\n\n[RP_SOURCE_PART]\n`;
          const suffix = `\n[/RP_SOURCE_PART]\n\n[END_REBUILD_PART index=${info.index} total=${info.total}]`;
          if(materialize)return prefix+part.map(fullRebuildTurnText).join('\n\n')+suffix;
          const bodyLength=part.reduce((sum,turn)=>sum+turnItemLength(turn),0)+Math.max(0,part.length-1)*2;
          return prefix.length+bodyLength+suffix.length;
        };

        for(let attempt=0;attempt<12;attempt++){
          const chunks=splitTurns(),parts=provisionalParts(chunks);
          let firstOverflow=0,laterOverflow=0;
          for(let index=0;index<chunks.length;index++){
            const info=parts[index],length=sourceFileParts(chunks[index],info,parts,false);
            const finalLimit=info.index===1&&!useAux&&expandFirstStatic?FULL_REBUILD_FIRST_STATIC_MAX:500000;
            const overflow=length-finalLimit;
            if(overflow>0){
              if(info.index===1)firstOverflow=Math.max(firstOverflow,overflow);
              else laterOverflow=Math.max(laterOverflow,overflow);
            }
          }
          if(!firstOverflow&&!laterOverflow)return {chunks,sourceFileParts};
          if(firstOverflow)firstReserve+=firstOverflow+1024;
          if(laterOverflow)laterReserve+=laterOverflow+1024;
        }
        const error=new Error('PART manifest 증가를 반영한 안전 재분할이 수렴하지 않았습니다. 원문을 자르지 않았습니다.');
        error.code='RPCM_FULL_REBUILD_PACKING_LIMIT';throw error;
      };

      let separateAux=initialSeparateAux,plan;
      try{plan=planSourceFiles(separateAux);}
      catch(error){
        // 첫 PART 확장 모드가 manifest/메모 반복까지 포함하면 안전 크기에 들어가지 않는 경우
        // 원문을 줄이지 않고 기존 AUX 안전 분할로 한 번만 후퇴합니다.
        if(!separateAux&&error?.code==='RPCM_FULL_REBUILD_PACKING_LIMIT'){separateAux=true;plan=planSourceFiles(true);}
        else throw error;
      }
      const chunks=plan.chunks;
      const parts = await Promise.all(chunks.map(async (part,index) => ({ index:index+1, total:chunks.length, firstTurnKey:part[0].key, lastTurnKey:part.at(-1).key, turnCount:part.length, sha256:await manualFullHistoryHash(part) })));
      const sourceFiles = chunks.map((part,index) => {
        const info=parts[index],text=plan.sourceFileParts(part,info,parts,true);
        const finalLimit=info.index===1&&!separateAux&&expandFirstStatic?FULL_REBUILD_FIRST_STATIC_MAX:500000;
        if(text.length>finalLimit)throw new Error(`${info.index}구간이 최종 안전 크기를 넘었습니다. 원문을 자르지 않았습니다.`);
        return {name:`Wish-전체재구축-${info.index}of${info.total}.txt`,text,kind:'rp',turnCount:info.turnCount};
      });

      let auxFiles=[];
      if(separateAux){
        const auxiliaryFullText=`${memoBlock}${memoBlock ? '\n\n' : ''}${firstExtra}`;
        const auxPieces=fullRebuildSplitAuxiliaryText(auxiliaryFullText);
        const auxFullHash=await fullRebuildSha256(auxiliaryFullText);
        auxFiles=await Promise.all(auxPieces.map(async (piece,index)=>{
          const sha=await fullRebuildSha256(piece);
          const text=fullRebuildAuxiliaryFileText(jobId,source,master,auxFullHash,sha,piece,index+1,auxPieces.length);
          if(text.length>500000)throw new Error(`보조자료 ${index+1}구간이 안전 크기를 넘습니다.`);
          return {name:`Wish-전체재구축-00-보조자료-${String(index+1).padStart(3,'0')}of${String(auxPieces.length).padStart(3,'0')}.txt`,text,kind:'aux',turnCount:0};
        }));
        if(auxPieces.join('')!==auxiliaryFullText)throw new Error('지침·메모·기존 자료의 전체 결합 검증 실패');
      }
      const files=[...auxFiles,...sourceFiles];
      const dataSha256 = await fullRebuildSha256(JSON.stringify(fullRebuildDataView(snapshotRoom)));
      if (state.currentRoom !== room) throw new Error('파일 생성 중 다른 방으로 이동했습니다.');
      const job = { jobId, createdAt:nowIso(), sourceKeys:turns.map(turn=>String(turn.key)),source, parts, guides:guides.manifest, master, memoHash, dataSha256, loreRefs, timelineRun };
      if(control?.cancelled)throw rpcmHistoryUserAbort('전체 재구축 파일 생성을 중단했습니다.');
      if(control)control.commitStarted=true;
      // job 기록은 실제 room 객체에 추가한 뒤 saveRoom의 revision/rebase 경로로 저장합니다.
      // 별도 clone을 저장한 뒤 room을 통째로 덮어쓰지 않으므로 생성 막바지의 정상 편집을 잃지 않습니다.
      const previousJob = room.fullRebuildJob ? structuredClone(room.fullRebuildJob) : null;
      room.fullRebuildJob = job;
      try { await saveRoom(room,'full-rebuild-export-job'); }
      catch (error) { if (room.fullRebuildJob?.jobId === jobId) { if (previousJob) room.fullRebuildJob=previousJob; else delete room.fullRebuildJob; } throw error; }
      if (state.currentRoom !== room || room.fullRebuildJob?.jobId !== jobId) throw new Error('파일 준비 기록을 저장하는 동안 방 또는 재구축 작업이 변경됐습니다.');
      // Large TXT payloads are owned by the download dialog only; do not retain
      // a duplicate permanently in fullRebuildRuntime.files.
      return { job, files };
    } finally { fullRebuildRuntime.busy = false; if(fullRebuildRuntime.control===control)fullRebuildRuntime.control=null; }
  }

  async function assertFullRebuildSource(room,job) {
    if(job.stale)throw new Error(job.staleReason||'재구축 source에 포함된 과거 RP 원문이 교정되었습니다. 새 source로 다시 작업해 주세요.');
    if (state.currentRoom !== room || room.fullRebuildJob?.jobId !== job.jobId) throw new Error('다른 방 또는 다른 전체 재구축 작업입니다.');
    const turns = await loadManualCompletedTurns(room,{finalFresh:true});
    if (turns.length < job.source.turnCount) throw new Error('재구축 파일 생성 후 RP 원문이 줄었습니다. 결과를 적용하지 않았습니다.');
    const prefix = turns.slice(0,job.source.turnCount);
    if (String(prefix[0]?.key) !== job.source.firstTurnKey || String(prefix.at(-1)?.key) !== job.source.lastTurnKey || await manualFullHistoryHash(prefix) !== job.source.sha256) throw new Error('재구축 파일 생성 후 RP 원문/분기가 변경됐습니다. 파일을 다시 만들어 주세요.');
    return { sourceTurns:prefix.map(turn => [String(turn.key),String(turn.text)]), newerTurns:turns.length-job.source.turnCount, currentTurns:turns };
  }


  function assertFullRebuildPartsManifest(data) {
    const parts = data?.parts, source = data?.source;
    const exactKeys = (value, keys) => value && typeof value === 'object' && !Array.isArray(value) && Object.keys(value).sort().join('|') === [...keys].sort().join('|');
    if (!Array.isArray(parts) || !parts.length) throw new Error('part manifest가 비어 있습니다.');
    let turnCount = 0;
    for (const [index, part] of parts.entries()) {
      if (!exactKeys(part,['index','total','firstTurnKey','lastTurnKey','turnCount','sha256']) || part.index !== index + 1 || part.total !== parts.length || !Number.isInteger(part.turnCount) || part.turnCount < 1 || typeof part.firstTurnKey !== 'string' || !part.firstTurnKey || typeof part.lastTurnKey !== 'string' || !part.lastTurnKey || typeof part.sha256 !== 'string' || !/^[a-f0-9]{64}$/i.test(part.sha256)) throw new Error('part가 누락·중복되었거나 순서/범위/hash 형식이 다릅니다.');
      turnCount += part.turnCount;
    }
    if (!source || parts[0].firstTurnKey !== source.firstTurnKey || parts.at(-1).lastTurnKey !== source.lastTurnKey || turnCount !== source.turnCount) throw new Error('part manifest의 전체 범위 또는 턴 수가 source와 다릅니다.');
    return parts;
  }

  async function assertFullRebuildPartsAgainstSource(data, sourceTurns) {
    const parts = assertFullRebuildPartsManifest(data);
    let cursor = 0;
    for (const part of parts) {
      const rows = sourceTurns.slice(cursor,cursor + part.turnCount).map(row => [String(row[0]),String(row[1])]);
      if (rows.length !== part.turnCount || rows[0]?.[0] !== part.firstTurnKey || rows.at(-1)?.[0] !== part.lastTurnKey || await fullRebuildSha256(JSON.stringify(rows)) !== part.sha256) throw new Error(`${part.index}번 part가 현재 RP 원문의 해당 범위/hash와 다릅니다.`);
      cursor += part.turnCount;
    }
    if (cursor !== sourceTurns.length) throw new Error('part manifest가 현재 RP 원문 전체를 정확히 덮지 않습니다.');
    return true;
  }

  function parseFullRebuildJson(raw,job,room) {
    let data;
    try { data = JSON.parse(String(raw || '').replace(/^\uFEFF/,'').trim()); }
    catch (_) { throw new Error('최종 결과는 설명이나 코드블록이 없는 UTF-8 JSON 객체여야 합니다.'); }
    const exact = (value,keys) => value && typeof value === 'object' && !Array.isArray(value) && Object.keys(value).sort().join('|') === [...keys].sort().join('|');
    const canonical = value => Array.isArray(value) ? value.map(canonical) : value && typeof value === 'object' ? Object.fromEntries(Object.keys(value).sort().map(key => [key,canonical(value[key])])) : value;
