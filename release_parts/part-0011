  // Exact-source, one-entry memo prevents repeatedly scanning a 150K+ dated log
  // during a single Manager rerender. Store only one room source at a time.
  // Clone each record on return: existing callers may annotate/reorder their copies.
  let rpcmDatedLogMemo = null;
  function parseDatedLogBlocks(text) {
    const src = normalizeLineBreaks(text);
    if (rpcmDatedLogMemo?.source === src)
      return rpcmDatedLogMemo.blocks.map(block => ({...block}));
    // 기본 양력형 외에 작품 고유 표기인 BC206·기원전 206년·AD714도 날짜 블록으로 인식합니다.
    // 제목 전체를 먼저 읽고 날짜 부분만 검증해, 일반 [소제목]은 날짜로 잘못 잡지 않습니다.
    const re = /^[ \t]*\[([^\]\n]+)\][ \t]*$/gm;
    const hits = [];
    let m;
    while ((m = re.exec(src))) {
      const inner = String(m[1] || '').trim();
      const standard = inner.match(/^((?:(\d{1,6})년[ \t]*)?(\d{1,2})월[ \t]*(\d{1,2})일)(?:[ \t]*·[ \t]*([^\-–—|｜]+?))?(?:[ \t]*[-–—|｜][ \t]*(.+))?$/);
      const unknown = inner.match(/^(날짜[ \t]*(미상|미정|불명|없음))(?:[ \t]*·[ \t]*([^\-–—|｜]+?))?(?:[ \t]*[-–—|｜][ \t]*(.+))?$/);
      const eraNamePattern = 'B\\.?[ \\t]*C\\.?(?:[ \\t]*E\\.?)?|A\\.?[ \\t]*D\\.?|C\\.?[ \\t]*E\\.?|기원전|서기';
      const eraRe = new RegExp(`^((${eraNamePattern})[ \\t]*(\\d{1,6})(?:년)?(?:[ \\t]*(\\d{1,2})월[ \\t]*(\\d{1,2})일)?(?:[ \\t]*[~～](?:[ \\t]*(?:${eraNamePattern}[ \\t]*)?\\d{1,6}(?:년)?(?:[ \\t]*\\d{1,2}월[ \\t]*\\d{1,2}일)?)?)?)(?:[ \\t]*·[ \\t]*([^\\-–—|｜]+?))?(?:[ \\t]*[-–—|｜][ \\t]*(.+))?$`, 'i');
      const era = inner.match(eraRe);
      let clockDate = null;
      if (!standard && !unknown && !era) {
        const civil='(?:(?:\\d{1,6}년[ \\t]*)?\\d{1,2}월[ \\t]*\\d{1,2}일|\\d{4,6}[-/.]\\d{1,2}[-/.]\\d{1,2})';
        const period='(?:오전|오후|새벽|아침|낮|저녁|밤|정오|자정)';
        const clock='(?:'+period+'[ \\t]*)?(?:\\d{1,2}[:：]\\d{2}(?:[:：]\\d{2})?|\\d{1,2}[ \\t]*시(?:[ \\t]*\\d{1,2}[ \\t]*분|[ \\t]*반)?)(?:[ \\t]*(?:AM|PM))?';
        const weekday='[ \\t]*[（(](?:[월화수목금토일](?:요일)?|Mon(?:day)?|Tue(?:sday)?|Wed(?:nesday)?|Thu(?:rsday)?|Fri(?:day)?|Sat(?:urday)?|Sun(?:day)?)[)）]';
        const suffix='(?:'+weekday+')?(?:[ \\t]*(?:T[ \\t]*)?'+clock+'(?:[ \\t]*[~～–—-][ \\t]*'+clock+')?|[ \\t]*'+period+')?';
        const clockMatch=String(inner).match(new RegExp('^('+civil+')('+suffix+')(?:[ \\t]*·[ \\t]*([^\\-–—|｜]+?))?(?:[ \\t]*[-–—|｜][ \\t]*(.+))?$','i'));
        if(clockMatch&&clockMatch[2].trim()){
          const koreanDate=clockMatch[1].match(/^(?:(\d{1,6})년[ \t]*)?(\d{1,2})월[ \t]*(\d{1,2})일$/),isoDate=koreanDate?null:clockMatch[1].match(/^(\d{4,6})([-/.])(\d{1,2})\2(\d{1,2})$/);
          if(koreanDate||isoDate){
            const year=Number(koreanDate?koreanDate[1]:isoDate[1])||null,month=Number(koreanDate?koreanDate[2]:isoDate[3]),day=Number(koreanDate?koreanDate[3]:isoDate[4]);
            const y=year||2000,leap=y%4===0&&(y%100!==0||y%400===0),days=[31,leap?29:28,31,30,31,30,31,31,30,31,30,31];
            let valid=(!(koreanDate?.[1]||isoDate)||!!year)&&month>=1&&month<=12&&day>=1&&day<=days[month-1];
            for(const t of clockMatch[2].matchAll(/(\d{1,2})[:：](\d{2})(?:[:：](\d{2}))?/g))if(Number(t[1])>23||Number(t[2])>59||Number(t[3]||0)>59){valid=false;break;}
            if(valid)for(const t of clockMatch[2].matchAll(/(\d{1,2})[ \t]*시(?:[ \t]*(\d{1,2})[ \t]*분)?/g))if(Number(t[1])>23||Number(t[2]||0)>59){valid=false;break;}
            if(valid)clockDate={fullDate:clockMatch[1]+clockMatch[2],calendarDate:(year?year+'년 ':'')+month+'월 '+day+'일',timeLabel:clockMatch[2].trim(),year,month,day,events:String(clockMatch[4]||'').trim(),sourceTimelineLabel:sanitizeLogTimelineLabel(clockMatch[3])};
          }
        }
      }
      if (!standard && !unknown && !era && !clockDate) continue;

      const isUnknown = !!unknown;
      const isSpecialDate = !!era;
      let fullDate = '';
      let year = null;
      let month = null;
      let day = null;
      let sortYear = null;
      let unknownLabel = '';
      let timelineLabel = '';
      let sourceTimelineLabel = '';
      let events = '';
      if (clockDate) {
        ({fullDate,year,month,day,events,sourceTimelineLabel} = clockDate);
        sortYear = year;
        timelineLabel = cleanLogTimelineLabel(sourceTimelineLabel);
      } else if (standard) {
        fullDate = standard[1];
        year = standard[2] ? Number(standard[2]) : null;
        month = Number(standard[3]);
        day = Number(standard[4]);
        sortYear = year;
        sourceTimelineLabel = sanitizeLogTimelineLabel(standard[5]);
        timelineLabel = cleanLogTimelineLabel(sourceTimelineLabel);
        events = String(standard[6] || '').trim();
      } else if (unknown) {
        fullDate = `날짜 ${unknown[2]}`;
        unknownLabel = fullDate;
        sourceTimelineLabel = sanitizeLogTimelineLabel(unknown[3]);
        timelineLabel = cleanLogTimelineLabel(sourceTimelineLabel);
        events = String(unknown[4] || '').trim();
      } else {
        fullDate = String(era[1] || '').trim();
        const eraName = String(era[2] || '').replace(/[.\s]/g, '').toUpperCase();
        const eraYear = Number(era[3]);
        const isBeforeCommonEra = eraName === 'BC' || eraName === 'BCE' || eraName === '기원전';
        sortYear = isBeforeCommonEra ? -eraYear : eraYear;
        month = era[4] ? Number(era[4]) : null;
        day = era[5] ? Number(era[5]) : null;
        sourceTimelineLabel = sanitizeLogTimelineLabel(era[6]);
        timelineLabel = cleanLogTimelineLabel(sourceTimelineLabel);
        events = String(era[7] || '').trim();
      }
      hits.push({
        index: m.index,
        endTitle: re.lastIndex,
        headingEnd: re.lastIndex,
        fullDate,
        year,
        sortYear,
        month,
        day,
        unknownLabel,
        timelineLabel,
        sourceTimelineLabel,
        isUnknown,
        isSpecialDate,
        events,
        heading: m[0].trim(),
        headingRaw: m[0],
        ...(clockDate ? { calendarDate:clockDate.calendarDate, timeLabel:clockDate.timeLabel } : {}),
      });
    }
    if (!hits.length) {
      rpcmDatedLogMemo = src.length <= 2000000 ? {source:src, blocks:[]} : null;
      return [];
    }
    const parsed = hits.map((h, i) => {
      const end = i + 1 < hits.length ? hits[i + 1].index : src.length;
      const body = src.slice(h.endTitle, end).trim();
      const raw = `${h.heading}${body ? `\n${body}` : ''}`;
      const calendarDateKey = h.isUnknown
        ? `unknown-${i}-${simpleHash(h.heading)}`
        : h.isSpecialDate
          ? `era-${String(h.fullDate || '').toLowerCase().replace(/\s+/g, '')}`
          : `${h.year || 'x'}-${String(h.month).padStart(2,'0')}-${String(h.day).padStart(2,'0')}`;
      const timelineKey = normalizedLogTimelineKey(h.timelineLabel);
      const dateKey = h.isUnknown ? calendarDateKey : `${calendarDateKey}::${timelineKey}`;
      const key = `${dateKey}-${simpleHash(h.heading)}`;
      const yearPrefix = h.year ? `${h.year}.` : '';
      return {
        ...h,
        key,
        dateKey,
        calendarDateKey,
        timelineKey,
        raw,
        body,
        index: i,
        weekOfMonth: h.isUnknown || !h.day ? null : Math.min(5, Math.floor((h.day - 1) / 7) + 1),
        titleText: h.isUnknown
          ? `${h.unknownLabel}${h.events ? ` ${h.events}` : ''}`
          : h.isSpecialDate
            ? `${h.fullDate}${h.timelineLabel && h.timelineLabel !== DEFAULT_LOG_TIMELINE ? ` · ${h.timelineLabel}` : ''}${h.events ? ` ${h.events}` : ''}`
            : `${yearPrefix}${h.month}/${h.day}${h.timeLabel ? ` ${h.timeLabel}` : ''}${h.timelineLabel && h.timelineLabel !== DEFAULT_LOG_TIMELINE ? ` · ${h.timelineLabel}` : ''}${h.events ? ` ${h.events}` : ''}`,
        sourceStart: h.index,
        sourceEnd: end,
      };
    });
    rpcmDatedLogMemo = src.length <= 2000000 ? {source:src, blocks:parsed} : null;
    return parsed.map(block => ({...block}));
  }

  const CURRENT_STATE_SECTION_RULE = '━━━━━━━━━━━━━━━━━━━━';

  function parseCurrentStateSections(text) {
    const src = normalizeLineBreaks(String(text || '')).trim();
    if (!src) return [];
    const lines = src.split('\n');
    const sections = [];
    let i = 0;
    while (i < lines.length) {
      while (i < lines.length && !String(lines[i] || '').trim()) i++;
      if (i >= lines.length) break;
      const titleLine = lines[i + 1] || '';
      const titleMatch = titleLine.match(/^(\d+)\.\s+(.+?)\s*$/);
      if (lines[i] !== CURRENT_STATE_SECTION_RULE || !titleMatch || lines[i + 2] !== CURRENT_STATE_SECTION_RULE) return [];
      const bodyStartLine = i + 3;
      let j = bodyStartLine;
      while (j < lines.length) {
        const nextTitle = lines[j + 1] || '';
        if (lines[j] === CURRENT_STATE_SECTION_RULE && /^(\d+)\.\s+(.+?)\s*$/.test(nextTitle) && lines[j + 2] === CURRENT_STATE_SECTION_RULE) break;
        j++;
      }
      const body = lines.slice(bodyStartLine, j).join('\n').trim();
      sections.push({
        number: Number(titleMatch[1]),
        title: String(titleMatch[2] || '').trim(),
        body,
        index: sections.length,
      });
      i = j;
    }
    return sections;
  }

  function parseCurrentStateSubblocks(body) {
    const src = normalizeLineBreaks(String(body || '')).trim();
    if (!src) return { intro:'', blocks:[] };
    const lines = src.split('\n');
    const hits = [];
    for (let i = 0; i < lines.length; i++) {
      const m = String(lines[i] || '').match(/^\[([^\[\]\n]+)\]$/);
      if (m) hits.push({ line:i, title:String(m[1] || '').trim() });
    }
    if (!hits.length) return { intro:src, blocks:[] };
    const intro = lines.slice(0, hits[0].line).join('\n').trim();
    const blocks = hits.map((hit, idx) => {
      const end = idx + 1 < hits.length ? hits[idx + 1].line : lines.length;
      return { title:hit.title, body:lines.slice(hit.line + 1, end).join('\n').trim(), index:idx };
    });
    return { intro, blocks };
  }

  function buildCurrentStateText(sections) {
    return (sections || []).map((section, index) => {
      const title = String(section?.title || `섹션 ${index + 1}`).trim();
      const body = String(section?.body || '').trim();
      return `${CURRENT_STATE_SECTION_RULE}\n${index + 1}. ${title}\n${CURRENT_STATE_SECTION_RULE}${body ? `\n${body}` : ''}`;
    }).join('\n\n').trim();
  }

  function buildCurrentStateSubblockBody(model) {
    const parts = [];
    const intro = String(model?.intro || '').trim();
    if (intro) parts.push(intro);
    for (const block of (model?.blocks || [])) {
      const title = String(block?.title || '').trim();
      const body = String(block?.body || '').trim();
      if (!title) continue;
      parts.push(`[${title}]${body ? `\n${body}` : ''}`);
    }
    return parts.join('\n\n').trim();
  }

  // 최신 로그는 저장소에서 뒤에 붙은 순서가 아니라 확정된 실제 날짜를 우선해 고릅니다.
  // 연도가 없는 [M월 D일-...] 블록은 연도를 추측하지 않습니다.
  // 연도 없는 블록만 있는 경우에는 기존 저장소 순서를 유지하고,
  // 연도가 확정된 로그 뒤에 연도 없는 블록이 새로 붙은 경우에만 그 뒤쪽 블록을 안전한 후보로 봅니다.
  function selectRecentLogBlocks(blocks, count) {
    const n = Math.max(0, Number(count) || 0);
    if (!n) return [];
    const dated = (blocks || []).filter(b => b && !b.isUnknown);
    if (!dated.length) return [];

    // BC가 기원전이 아니라 작품 고유 시대 코드일 수도 있으므로 숫자의 증감 방향을 임의 해석하지 않습니다.
    // 특수 연호가 섞인 저장소에서는 사용자가 정리해 둔 블록 순서를 최신 기준으로 사용합니다.
    if (dated.some(b => b.isSpecialDate)) return dated.slice(-n);

    const withYear = dated.filter(b => Number.isInteger(b.sortYear));
    if (!withYear.length) return dated.slice(-n);

    const knownSorted = [...withYear].sort((a, b) =>
      Number(a.sortYear) - Number(b.sortYear) ||
      Number(a.month || 0) - Number(b.month || 0) ||
      Number(a.day || 0) - Number(b.day || 0) ||
      Number(a.index) - Number(b.index)
    );
    const latestKnown = knownSorted[knownSorted.length - 1];

    // 연도 없는 로그가 '실제 날짜 기준 최신 로그'보다 저장소 뒤쪽에 새로 붙어 있다면
    // 연도를 임의 추정하지 않고 그 뒤쪽 순서를 보조 안전장치로 사용합니다.
    const trailingNoYear = dated.filter(b => b.sortYear == null && Number(b.index) > Number(latestKnown.index));
    if (!trailingNoYear.length) return knownSorted.slice(-n);

    const unknownTail = trailingNoYear.slice(-n);
    const remaining = Math.max(0, n - unknownTail.length);
    return [...(remaining ? knownSorted.slice(-remaining) : []), ...unknownTail];
  }

  // Keep the two latest eligible blocks on the active timeline, independent of relevance.
  function recentContinuityLogBlocks(room, blocks, excludedKeys = new Set()) {
    const active = normalizedLogTimelineKey(activeLogTimelineLabel(room));
    const eligible = (blocks || []).filter(block => {
      if (!block?.key || !String(block.raw || '').trim() || block.isUnknown || excludedKeys.has(String(block.key))) return false;
      if (normalizedLogTimelineKey(logTimelineLabelOfBlock(block)) !== active) return false;
      if (block.month != null && (!Number.isInteger(Number(block.month)) || Number(block.month) < 1 || Number(block.month) > 12)) return false;
      if (block.day != null && (!Number.isInteger(Number(block.day)) || Number(block.day) < 1 || Number(block.day) > 31)) return false;
      return true;
    });
    return selectRecentLogBlocks(eligible, recentLogInjectionCount(room)).reverse();
  }

  function logTimelineLabelsVisibleFromActive(room) {
    const labels = normalizeRoomLogTimelines(room).slice();
    const active = activeLogTimelineLabel(room);
    const activeIndex = labels.findIndex(label => normalizedLogTimelineKey(label) === normalizedLogTimelineKey(active));
    return activeIndex < 0 ? [DEFAULT_LOG_TIMELINE] : labels.slice(0, activeIndex + 1);
  }

  function autoRecallVisibleLogBlocks(blocks, room) {
    const visible = new Set(logTimelineLabelsVisibleFromActive(room).map(label => normalizedLogTimelineKey(label)));
    return (blocks || []).filter(block => visible.has(normalizedLogTimelineKey(logTimelineLabelOfBlock(block))));
  }

  // 날짜 정렬과 과거 시간선 탐색에 쓰이는 호환 helper입니다.
  // 자동 회수는 이제 최근 N개를 강제 포함하지 않고 관련도 판정을 먼저 거칩니다.
  function selectTimelineAwareRecentLogBlocks(blocks, room, count) {
    const limit = Math.max(0, Number(count) || 0);
    if (!limit) return [];
    const active = activeLogTimelineLabel(room);
    const visibleLabels = logTimelineLabelsVisibleFromActive(room);
    const activeRecent = selectRecentLogBlocks((blocks || []).filter(block => blockBelongsToTimeline(block, active)), limit);
    const selected = activeRecent.length ? [activeRecent[activeRecent.length - 1]] : [];
    const selectedKeys = new Set(selected.map(block => String(block.key)));
    for (const label of [...visibleLabels].reverse()) {
      if (selected.length >= limit) break;
      if (normalizedLogTimelineKey(label) === normalizedLogTimelineKey(active)) continue;
      const previousLatest = selectRecentLogBlocks((blocks || []).filter(block => blockBelongsToTimeline(block, label)), 1)[0];
      if (previousLatest && !selectedKeys.has(String(previousLatest.key))) {
        selected.push(previousLatest);
        selectedKeys.add(String(previousLatest.key));
      }
    }
    for (let index = activeRecent.length - 2; index >= 0 && selected.length < limit; index--) {
      const block = activeRecent[index];
      if (!selectedKeys.has(String(block.key))) {
        selected.push(block);
        selectedKeys.add(String(block.key));
      }
    }
    return selected.slice(0, limit);
  }

  function formatNormalizedLogHeading(block, year = null, month = null, day = null, timelineLabel = block?.timelineLabel || '') {
    const timeline = cleanLogTimelineLabel(timelineLabel);
    const timelineSuffix = timeline && timeline !== DEFAULT_LOG_TIMELINE ? `·${timeline}` : '';
    const suffix = block.events ? `-${block.events}` : '';
    const timeSuffix = block.timeLabel ? ` ${block.timeLabel}` : '';
    if (year && month && day) return `[${Number(year)}년 ${Number(month)}월 ${Number(day)}일${timeSuffix}${timelineSuffix}${suffix}]`;
    if (!block.isUnknown && month && day) return `[${Number(month)}월 ${Number(day)}일${timeSuffix}${timelineSuffix}${suffix}]`;
    return `[${block.unknownLabel || '날짜 미상'}${timelineSuffix}${suffix}]`;
  }

  function formatLogHeadingForTimeline(block, timelineLabel) {
    const timeline = cleanLogTimelineLabel(timelineLabel);
    const storedTimeline = timeline && timeline !== DEFAULT_LOG_TIMELINE ? timeline : '';
    if (block.isSpecialDate) {
      return `[${block.fullDate}${storedTimeline ? `·${storedTimeline}` : ''}${block.events ? `-${block.events}` : ''}]`;
    }
    return formatNormalizedLogHeading(block, block.year, block.month, block.day, storedTimeline);
  }

  function compareLogBlocksChronologically(a, b) {
    // 사용자가 날짜 미상으로 확정해 둔 사건은 시간상 가장 오래된 보관 구역에 둡니다.
    // 실제 날짜를 창작하지 않으며, 미상 블록끼리는 원문 순서를 유지합니다.
    const rank = block => block?.isUnknown ? 0 : Number.isInteger(block?.sortYear) ? 1 : 2;
    const rankDiff = rank(a) - rank(b);
    if (rankDiff) return rankDiff;
    if (rank(a) === 1) {
      const yearDiff = Number(a.sortYear) - Number(b.sortYear);
      if (yearDiff) return yearDiff;
    }
    if (rank(a) > 0) {
      const monthDiff = Number(a.month || 0) - Number(b.month || 0);
      if (monthDiff) return monthDiff;
      const dayDiff = Number(a.day || 0) - Number(b.day || 0);
      if (dayDiff) return dayDiff;
    }
    return Number(a.index || 0) - Number(b.index || 0);
  }

  function sortDatedLogTextByTimeline(value, room) {
    const text = normalizeLineBreaks(String(value || '')).trim();
    const blocks = parseDatedLogBlocks(text);
    if (!blocks.length) return text;
    const prefix = text.slice(0, blocks[0].sourceStart).trim();
    const labels = normalizeRoomLogTimelines(room).slice();
    blocks.forEach(block => {
      const label = logTimelineLabelOfBlock(block);
      if (!labels.some(item => normalizedLogTimelineKey(item) === normalizedLogTimelineKey(label))) labels.push(label);
    });
    const ordered = labels.flatMap(label => blocks
      .filter(block => blockBelongsToTimeline(block, label))
      .sort(compareLogBlocksChronologically));
    return [prefix, ...ordered.map(block => String(block.raw || '').trim())].filter(Boolean).join('\n\n').trim();
  }

  // 활성 시간선은 API 결과뿐 아니라 로그요약 칸에 새로 붙이거나 추가한
  // 무표식 날짜 블록의 저장 위치도 정합니다. 기존 기본 시간선 블록은 그대로 둡니다.
  function alignNewManualLogBlocksToActiveTimeline(previousValue, nextValue, room) {
    const previousText = normalizeLineBreaks(String(previousValue || '')).trim();
    let nextText = normalizeLineBreaks(String(nextValue || '')).trim();
    const active = activeLogTimelineLabel(room);
    const nextBlocks = parseDatedLogBlocks(nextText);
    if (!nextBlocks.length || active === DEFAULT_LOG_TIMELINE) return sortDatedLogTextByTimeline(nextText, room);
    const oldCounts = new Map();
    parseDatedLogBlocks(previousText).forEach(block => {
      const signature = `${block.heading}\n${block.body}`;
      oldCounts.set(signature, (oldCounts.get(signature) || 0) + 1);
    });
    const replacements = [];
    nextBlocks.forEach(block => {
      const signature = `${block.heading}\n${block.body}`;
      const oldCount = oldCounts.get(signature) || 0;
      if (oldCount > 0) {
        oldCounts.set(signature, oldCount - 1);
        return;
      }
      if (logTimelineLabelOfBlock(block) !== DEFAULT_LOG_TIMELINE) return;
      replacements.push({ start:block.sourceStart, end:block.headingEnd, text:formatLogHeadingForTimeline(block, active) });
    });
    replacements.sort((a, b) => b.start - a.start).forEach(replacement => {
      nextText = nextText.slice(0, replacement.start) + replacement.text + nextText.slice(replacement.end);
    });
    return sortDatedLogTextByTimeline(nextText, room);
  }

  function alignGeneratedLogTimeline(room, value) {
    const text = stripAiOutputWrapper(value);
    const blocks = parseDatedLogBlocks(text);
    if (!blocks.length) return text;
    const active = activeLogTimelineLabel(room);
    const replacements = blocks.map(block => ({
      start:block.sourceStart,
      end:block.headingEnd,
      text:formatLogHeadingForTimeline(block, active),
    })).sort((a,b) => b.start - a.start);
    let next = text;
    replacements.forEach(replacement => {
      next = next.slice(0, replacement.start) + replacement.text + next.slice(replacement.end);
    });
    return next;
  }

  function remapLogSelectionKeys(room, byOldKey, newBlocks) {
    const valid = new Set(newBlocks.map(b => String(b.key)));
    const remap = arr => [...new Set((arr || []).map(String).map(k => byOldKey.get(k) || k).filter(k => valid.has(k)))];
    room.autoLogPinnedKeys = remap(room.autoLogPinnedKeys);
    room.autoLogExcludedKeys = remap(room.autoLogExcludedKeys);
    room.manualLogSelectedKeys = remap(room.manualLogSelectedKeys);
    room.favoriteLogKeys = remap(room.favoriteLogKeys);
    room.acceptedUnknownLogKeys = remap(room.acceptedUnknownLogKeys);

    const nextByKey = new Map(newBlocks.map(block => [String(block.key), block]));

    // 제목의 키워드가 바뀌면 로그 key도 달라집니다. 현재 주입 항목과 간편 패널에서
    // 잠시 꺼둔 항목까지 같은 새 key·제목·본문으로 옮겨 선택 상태가 풀리지 않게 합니다.
    const remapPendingItem = item => {
      const oldKey = String(item?.sourceKey || item?.slotId || '').replace(/^auto-log:/, '');
      const nextBlock = nextByKey.get(String(byOldKey.get(oldKey) || oldKey));
      if (!nextBlock) {
        const isLogItem = String(item?.slotId || '').startsWith('auto-log:') || String(item?.autoType || '').endsWith('-log');
        return isLogItem ? null : item;
      }
      const prefix = item.autoType === 'pinned-log' ? '고정로그'
        : item.autoType === 'manual-log' ? '직접로그'
        : item.autoType === 'recent-log' ? '최근 연속성'
        : item.autoType === 'related-log' ? '관련로그'
        : '로그요약';
      return {
        ...item,
        slotId:`auto-log:${nextBlock.key}`,
        sourceKey:nextBlock.key,
        title:`${prefix} [${logTimelineLabelOfBlock(nextBlock)}] ${nextBlock.titleText}`,
        content:nextBlock.raw,
        logIndex:nextBlock.index,
      };
    };
    if (room.pending) {
      room.pending.items = (room.pending.items || []).map(remapPendingItem).filter(Boolean);
      room.pending.quickRemovedItems = (room.pending.quickRemovedItems || []).map(remapPendingItem).filter(Boolean);
    }
  }

  function remapLogSelectionKeysByIndex(room, oldBlocks, newBlocks) {
    const byOldKey = new Map();
    oldBlocks.forEach((b, i) => {
      if (newBlocks[i]) byOldKey.set(String(b.key), String(newBlocks[i].key));
    });
    remapLogSelectionKeys(room, byOldKey, newBlocks);
  }

  function duplicateLogDateGroups(room) {
    const log = (room?.slots || []).find(s => s.id === 'logSummary');
    const blocks = parseDatedLogBlocks(log?.content || '');
    const byDate = new Map();
    for (const block of blocks) {
      if (block.isUnknown) continue;
      if (!byDate.has(block.dateKey)) byDate.set(block.dateKey, []);
      byDate.get(block.dateKey).push(block);
    }
    return [...byDate.entries()]
      .filter(([, arr]) => arr.length > 1)
      .map(([dateKey, arr]) => ({ dateKey, label: `${arr[0]?.fullDate || dateKey.replace(/^x-/, '').split('::')[0]} · ${logTimelineLabelOfBlock(arr[0])}`, blocks: arr }));
  }

  function pruneLogSelectionKeys(room, blocks = null) {
    const log = (room?.slots || []).find(s => s.id === 'logSummary');
    const validBlocks = blocks || parseDatedLogBlocks(log?.content || '');
    const valid = new Set(validBlocks.map(b => String(b.key)));
    room.autoLogPinnedKeys = (room.autoLogPinnedKeys || []).map(String).filter(k => valid.has(k));
    room.autoLogExcludedKeys = (room.autoLogExcludedKeys || []).map(String).filter(k => valid.has(k));
    room.manualLogSelectedKeys = (room.manualLogSelectedKeys || []).map(String).filter(k => valid.has(k));
    room.favoriteLogKeys = (room.favoriteLogKeys || []).map(String).filter(k => valid.has(k));
    room.acceptedUnknownLogKeys = (room.acceptedUnknownLogKeys || []).map(String).filter(k => valid.has(k));
  }

  // 기본 관련로그 검색은 로컬 키워드 점수화이며, 사용자가 옵션을 켠 경우에만
  // 이 후보군을 저장된 API가 현재 RP 맥락으로 한 번 더 재선정합니다.
  // 사건명/장소/물건/희귀 키워드(=비인물 핵심어)를 인물명보다 우선합니다.
  // 인물명은 같은 등장인물이 반복되는 장기방에서 오탐이 많으므로 보조점수로만 사용합니다.
  const LOG_RECALL_DOC_CACHE = new Map();

  function normalizedRecallTerm(value) {
    return String(value || '').trim().toLowerCase().replace(/\s+/g, ' ');
  }

  function characterRecallTermSet(room = state.currentRoom) {
    const out = new Set();
    for (const slot of (room?.slots || []).filter(s => s.group === 'character')) {
      for (const term of characterDetectionTerms(slot)) {
        const normalized = normalizedRecallTerm(term);
        if (!normalized) continue;
        out.add(normalized);
        for (const token of tokenizeRecallText(normalized)) out.add(token);
      }
    }
    return out;
  }

  function recallDocForBlock(block, profile = null) {
    const signature = `recall-v2|${block.key}|${block.raw.length}|${simpleHash(block.raw)}`;
    const cached = LOG_RECALL_DOC_CACHE.get(signature);
    if (cached) { if(profile) profile.docCacheHits=(profile.docCacheHits||0)+1; return cached; }
    if(profile) profile.docCacheMisses=(profile.docCacheMisses||0)+1;
    const merged = `${block.events} ${block.body}`.toLowerCase();
    const tokens = tokenizeRecallText(merged);
    const doc = {
      block,
      text: merged,
      tokens: new Set(tokens),
