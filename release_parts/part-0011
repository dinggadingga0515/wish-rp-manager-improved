  function splitStoryTimelineTurns(turns, maxChars = 90000) {
    const chunks = [];
    let current = [];
    let chars = 0;
    for (const turn of (turns || [])) {
      const length = String(turn?.text || '').length + 40;
      if (current.length && chars + length > maxChars) { chunks.push(current); current = []; chars = 0; }
      current.push(turn); chars += length;
    }
    if (current.length) chunks.push(current);
    return chunks;
  }

  function storyTimelineReviewScopeFromSnapshot(snapshot, selectedLogs, updateMode, reviewedTailKeys = []) {
    return {
      mode:updateMode,
      createdAt:nowIso(),
      startMessageId:String(snapshot?.startKey || ''),
      endMessageId:String(snapshot?.endKey || snapshot?.latestKey || ''),
      turnCount:updateMode === 'rebuild' ? Number(snapshot?.totalHistoryTurns || 0) : Number(snapshot?.turns?.length || 0),
