  async function loadStoryTimelineReviewSnapshot(room, requireFullHistory = false) {
    const anchor = String(room.storyTimelineLastReviewedMessageId || '');
    // 일반 갱신은 기존 기준점 직전 문맥까지만, 전체 근거 점검은 기준점과 무관하게 처음부터 요청합니다.
    const recent=await fetchRecentMessages(apiChatIdOf(room),30),signature=semanticSourceHash(JSON.stringify(recent.map(message=>[messageIdOf(message),messageTextOf(message),message.status,message.generationStatus]))),cacheKey=String(room.chatId),cached=storyReviewSnapshotCache.get(cacheKey);
    const certain=recent.length&&!recent.some(isIncompleteAiSourceMessage);
    const reusable=!requireFullHistory&&certain&&cached&&cached.anchor===anchor&&cached.chatId===String(apiChatIdOf(room))&&cached.signature===signature&&Date.now()-cached.at<120000;
    const turns=reusable?cached.turns:await loadRpcmCompletedRange(room,requireFullHistory||!anchor?[]:[anchor],{allowMissingAnchor:true,lookbackTurns:40});
    if(!requireFullHistory&&certain){storyReviewSnapshotCache.clear();storyReviewSnapshotCache.set(cacheKey,{anchor,signature,chatId:String(apiChatIdOf(room)),at:Date.now(),turns});}
    let effectiveAnchor = anchor;
    let anchorIndex = anchor ? rpcmFindTurnIndex(turns,anchor) : -1;
    let anchorRecovered = false;
    // 업데이트·리롤·분기 뒤 기존 기준 메시지 하나가 사라졌더라도, 검토 완료 때 함께
    // 저장한 최근 40개 키 중 가장 최신으로 남아 있는 지점을 찾아 이어서 갱신합니다.
    if (!requireFullHistory && anchor && anchorIndex < 0) {
      const carryoverKeys = [...(Array.isArray(room.storyTimelineCarryoverTurnKeys) ? room.storyTimelineCarryoverTurnKeys : [])].map(String).reverse();
      for (const key of carryoverKeys) {
        const recoveredIndex = rpcmFindTurnIndex(turns,key);
        if (recoveredIndex < 0) continue;
        effectiveAnchor = key;
        anchorIndex = recoveredIndex;
        anchorRecovered = true;
        break;
      }
    }
    const anchorInvalid = !requireFullHistory && !!anchor && anchorIndex < 0;
    // 기준을 잃은 상태에서 전체 RP를 '새 RP'로 오인하지 않도록 이어서 갱신 범위는 비웁니다.
    // 사용자가 현재를 새 기준으로 잡거나 전체 다시 읽기를 선택해야만 생성할 수 있습니다.
    const fresh = anchorInvalid ? [] : anchorIndex >= 0 ? turns.slice(anchorIndex + 1) : turns;
    return {
      turns:fresh,
      allTurns:turns,
      historyLimitReached:false,
      anchorIndex,
      anchorInvalid,
      anchorRecovered,
      requestedAnchor:anchor,
      effectiveAnchor,
      // 직전 40턴은 새 RP의 시작 문맥 보강용이며, fresh 범위를 줄이지 않습니다.
      lookbackTurns:anchorIndex >= 0 ? turns.slice(Math.max(0, anchorIndex - 39), anchorIndex + 1) : [],
      totalHistoryTurns:turns.length,
      anchorMissing:!anchor,
      startKey:String(fresh[0]?.key || ''),
      endKey:String(fresh[fresh.length - 1]?.key || effectiveAnchor || ''),
      latestKey:String(turns[turns.length - 1]?.key || ''),
    };
  }

  const storyReviewCountLoads = new Map(),storyReviewSnapshotCache=new Map(),storyReviewCountTimers=new Map();
  function scheduleStoryReviewCountRefresh(room) {
    const key = String(room?.chatId || '');
    if (!key || storyReviewCountLoads.has(key)) return;
    const last = Number(room.storyTimelineCountCheckedAt || 0);
    if (Date.now() - last < 12000){if(!storyReviewCountTimers.has(key)){storyReviewCountTimers.set(key,setTimeout(()=>{storyReviewCountTimers.delete(key);if(state.currentRoom===room)scheduleStoryReviewCountRefresh(room);},12000-(Date.now()-last)+50));}return;}
    const task = loadStoryTimelineReviewSnapshot(room).then(async snapshot => {
      if (snapshot.anchorInvalid || state.currentRoom !== room) return;
      const anchorChanged = !!(snapshot.anchorRecovered && snapshot.effectiveAnchor &&
        String(room.storyTimelineLastReviewedMessageId || '') !== String(snapshot.effectiveAnchor));
      if (anchorChanged) {
        room.storyTimelineLastReviewedMessageId = String(snapshot.effectiveAnchor);
        room.storyTimelineAnchorRecoveredAt = nowIso();
      }
      const before = Number(room.storyTimelineUnreviewedTurnCount || 0);
      const after = snapshot.turns.length;
      room.storyTimelineUnreviewedTurnCount = after;
      room.storyTimelineCountCheckedAt = Date.now();
      const settings = room.storyTimelineReviewSettings || {};
      const threshold = Number(settings.threshold || 50);
      if (settings.popup && before < threshold && after >= threshold) notify(`타임라인 검토 권장 · 마지막 검토 이후 ${after}턴`, 'warn', 6000);
      // A background count check must not replace the user's reading/editing surface.
      // The checked timestamp stays in memory; only a changed count/anchor needs a write.
      if (before !== after || anchorChanged) {
        try { await saveRoom(room); } catch (_) {}
      }
      if (state.currentRoom === room && (before !== after || anchorChanged)) refreshStoryReviewCountUi(room);
    }).catch(() => {}).finally(() => storyReviewCountLoads.delete(key));
    storyReviewCountLoads.set(key, task);
  }

  function refreshStoryReviewCountUi(room) {
