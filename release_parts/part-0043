    const tick=()=>{
      refinerReloadTimer=null;
      if(scheduleRefinerReload.pending!==reservation)return;
      if(chatStateKey()!==scope){scheduleRefinerReload.pending=null;return;}
      if(refinerReloadActivity()){
        if(!announced){announced=true;showReviewNotice('교정 저장 완료 · 새로고침 대기','응답 생성 또는 기본 수정창이 끝날 때까지 새로고침을 보류합니다.',kind,7000);}
        if(attempts++<20){refinerReloadTimer=setTimeout(tick,750);return;}
