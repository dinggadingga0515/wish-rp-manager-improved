  function clearDeferredRefinerReload(messageId = '') {
    const id=String(messageId||''),pending=scheduleRefinerReload.pending,scope=chatStateKey(),reservations=scheduleRefinerReload.reservations;
    if(reservations)for(const [key,row] of reservations)if(row.scope===scope&&(!id||row.messageId===id))reservations.delete(key);
    if(pending&&(!id||pending.messageId===id)&&pending.scope===chatStateKey()){
      if(refinerReloadTimer!==null)clearTimeout(refinerReloadTimer);refinerReloadTimer=null;scheduleRefinerReload.pending=null;
      const other=reservations&&[...reservations.values()].find(row=>row.scope===scope);if(other)scheduleRefinerReload(350,other.detail,other.kind,{messageId:other.messageId,fingerprint:other.fingerprint});
