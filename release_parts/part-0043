    const reservations=scheduleRefinerReload.reservations ||= new Map();for(const [key,row] of reservations)if(row.scope!==scope)reservations.delete(key);reservations.set(JSON.stringify([scope,reservation.messageId]),reservation);scheduleRefinerReload.pending=reservation;
