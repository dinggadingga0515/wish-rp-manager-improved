      catch(_){showRefinerRefreshPrompt('자동 새로고침을 실행하지 못했습니다. 아래 버튼으로 새로고침해 주세요.');}
    };
    showReviewNotice('교정 저장 완료 · 화면 다시 불러오기',String(detail||'저장된 최신 응답을 다시 불러옵니다.'),kind,Math.max(4500,delay+500));
    refinerReloadTimer=setTimeout(tick,Math.max(150,Number(delay)||650));
