    const globalOnly=!roomIds.size&&!libraryIds.size&&choice.includeOptions&&!choice.recoveryOnly&&wrpmFullBackupV2.hasGlobalOptions(payload);
    if(!roomIds.size&&!libraryIds.size&&!globalOnly)throw new Error('복원 대상을 선택해 주세요.');
    if([...roomIds].some(id=>!payload.rooms.some(row=>row.chatId===id))||[...libraryIds].some(id=>!payload.characterLibraries.some(row=>row.scopeId===id)))throw new Error('선택 범위가 백업과 다릅니다.');
    const preimage=await rpcmCreateRestorePreimage(),epoch=state.routeEpoch,completed=[],committed=[];
    for(const row of preimage.rooms)if(roomIds.has(row.chatId)&&row.pending)throw new Error('복원 대상 방의 현재 주입을 먼저 해제해 주세요.');
    for(const row of preimage.rooms)if(roomIds.has(row.chatId)&&rpcmStoredCarrierRestoreLock(row))throw new Error('복원 대상 방의 AI 원문 복원 확인을 먼저 끝내 주세요.');
    for(const id of roomIds)if(rpcmStoredCarrierRestoreLock(loadPendingBackup(id)))throw new Error('복원 대상 방의 AI 원문 복원 확인을 먼저 끝내 주세요.');
    downloadText(wrpmFullBackupV2.fileText(preimage),(preimage.format==='WRPM_RESTORE_PREIMAGE_RAW_V1'?'RP_복원전_원형퇴피_':'RP_복원전_전체퇴피_')+new Date().toISOString().slice(0,10)+'.json');
    const originalRooms=new Map(preimage.rooms.map(row=>[row.chatId,row])),originalLibraries=new Map(preimage.characterLibraries.map(row=>[row.scopeId,row]));
    const scope=()=>{if(epoch!==state.routeEpoch)throw new Error('복원 중 방이 바뀌었습니다. 완료한 항목은 진행 기록에 남겼습니다.');};
    const sourceHash=await wrpmFullBackupV2.digest(payload.storageSnapshot.manifest);
    wrpmFullBackupV2.journal({phase:'prepared',sourceHash,roomIds:[...roomIds],libraryIds:[...libraryIds],completed});
    const recordCommitted=row=>{committed.push({...row,status:'committed-unverified'});wrpmFullBackupV2.journal({phase:'committed-unverified',sourceHash,completed,committed,globalOnly});};
    state.fullBackupRestoreBusy=true;
    try{
      for(const source of payload.rooms){
        if(!roomIds.has(source.chatId))continue;scope();
        const current=(await rpcmStrictCoreBackup()).rooms.find(row=>row.chatId===source.chatId);
        if(await wrpmFullBackupV2.digest(current||null)!==await wrpmFullBackupV2.digest(originalRooms.get(source.chatId)||null))throw new Error('복원 준비 후 방 자료가 바뀌었습니다: '+source.chatId);
        const restored=rpcmStampImportReview(rpcmPreserveIncomingPending(structuredClone(source),payload),choice,source.chatId);
        if(!Array.isArray(restored.lorePacks))restored.lorePacks=[];normalizeRoomSlots(restored);
        restored._rpcmRevision=Number(current?._rpcmRevision||0);
        await saveRestoredRoom(restored,current||null,()=>recordCommitted({store:'rooms',id:source.chatId}));completed.push({store:'rooms',id:source.chatId});
        wrpmFullBackupV2.journal({phase:'data',sourceHash,completed,committed});
      }
      for(const source of payload.characterLibraries){
        if(!libraryIds.has(source.scopeId))continue;scope();
        const current=(await rpcmStrictCoreBackup()).characterLibraries.find(row=>row.scopeId===source.scopeId);
        if(await wrpmFullBackupV2.digest(current||null)!==await wrpmFullBackupV2.digest(originalLibraries.get(source.scopeId)||null))throw new Error('복원 준비 후 자료실이 바뀌었습니다: '+source.scopeId);
        await rpcmWriteRestoredLibrary(structuredClone(source),current||null,()=>recordCommitted({store:'characterLibraries',id:source.scopeId}));
        const saved=(await rpcmStrictCoreBackup()).characterLibraries.find(row=>row.scopeId===source.scopeId);
        if(!saved)throw new Error('자료실 복원 재읽기 실패');completed.push({store:'characterLibraries',id:source.scopeId});
        wrpmFullBackupV2.journal({phase:'data',sourceHash,completed,committed});
      }
      scope();if(!globalOnly){if(!choice.recoveryOnly)await wrpmStorageMaintenanceV11.importExtension(payload.storageMaintenance,choice);completed.push({store:'managed',selection:choice.roomIds.length+choice.libraryIds.length});wrpmFullBackupV2.journal({phase:'managed',sourceHash,completed,committed});}
      scope();const options=choice.recoveryOnly?{completed:[]}:await wrpmFullBackupV2.importOptions(payload,{...choice,globalOnly},recordCommitted);completed.push(...options.completed);
      scope();const recovery=choice.recoveryOnly||globalOnly?{retained:0}:await wrpmFullBackupV2.retainRecovery(payload,choice);
      wrpmFullBackupV2.journal({phase:'complete',sourceHash,completed,committed:committed.map(row=>({...row,status:'verified'})),recovery,globalOnly});
      return {completed,options,recovery,globalOnly,pendingActivation:false};
    }catch(error){
      const partial=[...completed,...error.completed||[]];try{wrpmFullBackupV2.journal({phase:'partial',sourceHash,completed:partial,committed,globalOnly,error:String(error.message||error)});}catch(_){}
      error.code='WRPM_RESTORE_PARTIAL';error.message='복원 미완료 · 쓰기 '+committed.length+'개 / 재읽기 완료 '+partial.length+'개 · 진행 기록과 복원 전 퇴피 JSON을 확인해 주세요. '+error.message;throw error;
    }finally{
      state.fullBackupRestoreBusy=false;
      state.roomResetEpochs||=new Map();
      for(const row of new Map([...completed,...committed].filter(row=>row.store==='rooms').map(row=>[row.id,row])).values())state.roomResetEpochs.set(row.id,Number(state.roomResetEpochs.get(row.id)||0)+1);
      state.libraryResetEpochs||=new Map();
      for(const row of new Map([...completed,...committed].filter(row=>row.store==='characterLibraries').map(row=>[row.id,row])).values())state.libraryResetEpochs.set(row.id,Number(state.libraryResetEpochs.get(row.id)||0)+1);
      if(epoch===state.routeEpoch&&roomIds.has(String(state.currentRoom?.chatId))){
        try{await ensureCurrentRoom(getChatIdFromPath(),true);renderModalIfOpen();}
        catch(error){state.fullBackupRestoreNeedsReload=true;notify('복원 후 화면 재읽기 실패 · 추가 편집 전 사이트를 새로고침해 주세요: '+error.message,'error',9000);}
      }
    }
  }


  async function rpcmInitializeGlobalCarrierEncoding(){
    if(GM_getValue('RPCM_carrier_encoding_global_v1',null)!==null){rpcmCarrierEncoding();return;}
    const rooms=await getAllRooms();
    const encoding=rooms.some(room=>room.carrierEncoding==='utf-16le')?'utf-16le':'utf-8';
    // Another tab may have completed migration while this tab was reading IndexedDB.
    if(GM_getValue('RPCM_carrier_encoding_global_v1',null)!==null){rpcmCarrierEncoding();return;}
    await GM_setValue('RPCM_carrier_encoding_global_v1',{version:1,encoding,source:'legacy-room-migration'});
    if(rpcmCarrierEncoding()!==encoding)throw new Error('전역 인코딩 초기 설정이 바뀌었습니다. 현재 선택을 확인해 주세요.');
  }

  function rpcmStorageAmount(value){
    if(value===null||value===undefined||!Number.isFinite(Number(value)))return '미확인';
    const n=Number(value),unit=n>=1e9?'GB':n>=1e6?'MB':n>=1e3?'KB':'B',div=unit==='GB'?1e9:unit==='MB'?1e6:unit==='KB'?1e3:1;
    return unit==='B'?formatCount(n)+' B':(n/div).toLocaleString('ko-KR',{maximumFractionDigits:2})+' '+unit+' ('+formatCount(n)+' B)';
  }

  function rpcmStorageUsageRows(value){
    const c=value.gm.categories,rows=[
      ['최근 비상 사본',c.rescueCurrent,'확장 저장소'],['직전 비상 사본',c.rescuePrevious,'확장 저장소'],
      ['압축 비상 사본 · 최근',c.rescuePackedCurrent,'확장 저장소'],['압축 비상 사본 · 직전',c.rescuePackedPrevious,'확장 저장소'],
      ['복구 목록·삭제 표시',c.rescueMetadata,'확장 저장소'],['교정 전후 기록',c.correctionArchive,'확장 저장소'],
      ['처리 이력',c.processHistory,'확장 저장소'],['이전 정책 사본',c.legacyPolicies,'확장 저장소'],
      ['저장 경로 표지',c.maintenanceControls,'확장 저장소'],['설정·기타',c.settingsAndOther,'확장 저장소']];
    for(const [name,row]of Object.entries(value.original))rows.push([name===APP.storeName?'RP 원본':'설정집 원본',row.logicalBytes,'사이트 IndexedDB']);
    if(value.maintenance)rows.push(['보조 보관 기록',value.maintenance.auxiliary.logicalBytes,'사이트 IndexedDB']);
    if(value.local)rows.push(['설정·작업 복구 기록',value.local.logicalBytes,'사이트 localStorage']);
    return rows.map(([label,bytes,store])=>({label,bytes,store}));
  }

  function renderRpcmStorageUsage(value){
    const rows=rpcmStorageUsageRows(value),total=rows.reduce((n,row)=>n+(Number(row.bytes)||0),0),partial=value.errors.length||rows.some(row=>row.bytes===null||row.bytes===undefined);
    const colors=['#5aa2f8','#ad8cff','#e4a5c9','#3bccab','#f7c755','#92a1b8','#eb7bb9','#67cbd1','#d4b783','#acb9cc','#f29766','#8495ed','#80bb8c','#c6ad75'];
    const known=rows.filter(row=>Number(row.bytes)>0),segment=row=>Math.max(0,Number(row.bytes)||0)/Math.max(total,1)*100;
    return `<section data-storage-chart aria-label="저장공간 구성별 사용량"><style>.rpcm-storage-usage-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 20px;margin-top:12px}@media(max-width:650px){.rpcm-storage-usage-grid{grid-template-columns:1fr}}</style><h3>구성별 사용량 · ${partial?'확인된 내용 합계':'내용 크기 합계'} ${rpcmStorageAmount(total)}</h3><div style="display:flex;height:12px;border-radius:6px;overflow:hidden;background:#596174" aria-label="구성별 비율">${known.map(row=>`<span title="${esc(row.label+' · '+rpcmStorageAmount(row.bytes))}" style="width:${segment(row)}%;background:${colors[rows.indexOf(row)%colors.length]}"></span>`).join('')}</div><div class="rpcm-storage-usage-grid">${rows.filter(row=>Number(row.bytes)>0||row.bytes===null||row.bytes===undefined).map((row)=>`<div style="display:flex;gap:8px;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid #596174"><span><span aria-hidden="true" style="color:${colors[rows.indexOf(row)%colors.length]}">●</span> ${esc(row.label)}<small style="display:block;opacity:.75">${esc(row.store)}</small></span><strong style="text-align:right;font-size:13px;max-width:58%;flex-shrink:0">${rpcmStorageAmount(row.bytes)}${row.bytes===null||row.bytes===undefined?'':` · ${segment(row)<0.1?'&lt;0.1':segment(row).toFixed(1)}%`}</strong></div>`).join('')}</div><p style="font-size:13px">원본과 복구 사본은 실제로 각각 저장되어 각각 표시됩니다. 기존 사본 보존량은 이미 해당 GM 항목에 포함되어 합계에 다시 더하지 않습니다. 수치는 UTF-8 내용 크기이며 실제 디스크 점유량과 다릅니다. KB/MB는 1,000 기준입니다.</p>${value.siteEstimate?`<p style="font-size:13px">사이트 전체 사용량 추정: ${rpcmStorageAmount(value.siteEstimate.usage)} · WRPM 외 자료 포함, 위 합계에 더하지 않음</p>`:''}${partial?`<p role="status">일부 영역 미확인: ${esc(value.errors.join(' · ')||'저장값을 확인하지 못했습니다.')}</p>`:''}<details><summary>자세한 수치</summary><pre style="white-space:pre-wrap">${esc(formatRpcmStorageUsage(value))}</pre></details></section>`;
  }

  async function getAllRooms() {
    return new Promise((resolve, reject) => {
      const tx = state.db.transaction(APP.storeName, 'readonly');
      const req = tx.objectStore(APP.storeName).getAll();
      req.onsuccess = () => wishResolveStorageRecord(req,[],resolve,reject);
      req.onerror = () => reject(req.error);
      tx.onabort = () => reject(tx.error || new Error('IndexedDB 조회가 취소되었습니다.'));
      tx.onerror = () => reject(tx.error || new Error('IndexedDB 조회 실패'));
    });
  }

  function rpcmRoomDisplayName(room, override = null) {
    const base = String(room?.label || '').trim();
    const chatTitle = String(override?.chatTitle ?? room?.chatTitle ?? '').trim();
    const status = String(override?.status || '').trim();
    const fallback = base || chatTitle || ('RP ' + shortId(room?.chatId));
    if (status) return (base || ('RP ' + shortId(room?.chatId))) + '[' + status + ']';
    if (base && chatTitle && normalizedLibraryLabel(base) !== normalizedLibraryLabel(chatTitle)) return base + '[' + chatTitle + ']';
    return fallback;
  }

  async function rpcmBuildBackupRoomDisplayMeta(rooms, concurrency = 4) {
    const result = new Map();
    const targets = (rooms || []).filter(room => room?.chatId && !String(room.chatTitle || '').trim());
    if (!targets.length) return result;
    let cursor = 0;
    const worker = async () => {
      for (;;) {
        const index = cursor++;
        if (index >= targets.length) return;
        const room = targets[index], key = String(room.chatId || ''), apiId = String(apiChatIdOf(room) || '');
        if (!apiId) { result.set(key, { status:'조회 실패' }); continue; }
        try {
          const meta = await fetchRoomMeta(apiId, { throwOnError:true });
          const chatTitle = String(meta?.chatTitle || '').trim();
          if (chatTitle) result.set(key, { chatTitle });
        } catch (error) {
          const status = rpcmNetStatus(error);
          result.set(key, { status:[404,410].includes(status) ? '삭제되어 조회불가' : [401,403].includes(status) ? '조회 권한 없음' : '조회 실패' });
        }
      }
    };
    const workers = Math.min(4, Math.max(1, Number(concurrency) || 4), targets.length);
    await Promise.all(Array.from({ length:workers }, () => worker()));
    return result;
  }

  function rpcmInjectedRoomRows(rooms, currentChatId = state.currentChatId) {
    return (rooms || []).filter(room => room?.pending).map(room => ({
      chatId: String(room.chatId || ''),
      label: rpcmRoomDisplayName(room),
      current: String(room.chatId) === String(currentChatId),
      status: room.pending.reanchorRetry ? '복구 대기' : room.pending.verified ? '주입 중' : '서버 확인 필요',
    }));
  }

