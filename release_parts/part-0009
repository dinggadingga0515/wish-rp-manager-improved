  function rpcmKnowledgeGroupedChips(fact,vm) {
    const groups=new Map();
    for(const actor of vm.actors){
      const status=vm.statusFor(fact,actor);
      const cards=fact.byActor.get(manualPersonName(actor.name))||[];
      const c=cards.length===1?cards[0]:null;
      const signature=c?JSON.stringify([status.kind,status.label,c.status,c.knownPart,c.actualFact,c.evidence,c.category,c.inject,c.hiddenFrom,c.concealmentNote,c.concealments]):'single:'+actor.name;
      if(!groups.has(signature))groups.set(signature,[]);
      groups.get(signature).push({name:actor.name,status});
    }
    return [...groups.values()].map(entries=>{
      const first=entries[0],names=entries.map(row=>row.name);
      if(names.length===1)return rpcmKnowledgeStatusControl(fact,first.name,first.status,true);
      const theme=rpcmKnowledgeStatusTheme(first.status);
      return `<button type="button" class="m3-chip ${theme.chip} rpcm-knowledge-status-trigger rpcm-knowledge-status-split" data-status="${esc(theme.reader)}" data-rpcm-knowledge-quick="1" data-rpcm-fact-id="${esc(fact.id)}" data-rpcm-members="${esc(JSON.stringify(names))}" title="각 인물의 상태는 개별 변경됩니다"><span class="rpcm-knowledge-person-badge">${esc(names.join(', '))}</span><span class="rpcm-knowledge-state-badge ${esc(theme.chip)}" data-status="${esc(theme.reader)}">${esc(first.status.label)}</span></button>`;
    }).join('');
  }
