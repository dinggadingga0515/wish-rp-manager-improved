  // Directly adapted from Core's keyed patcher. Used by high-frequency view regions.
  const rpcmPatchKey = node => node.nodeType === 1 ? node.getAttribute('data-key') : null;
  function rpcmPatchNode(current, next) {
    if (current.nodeType !== 1) { if (current.nodeValue !== next.nodeValue) current.nodeValue = next.nodeValue; return; }
    const preserveOpen = current.tagName === 'DETAILS' && current.hasAttribute('data-key') && !current.matches('.rpcm-lore-pack,.rpcm-lore-card') ? current.open : null;
    if (current.tagName === 'TEXTAREA' && current.style.height && !next.style.height) next.style.height = current.style.height;
    for (const attr of [...current.attributes]) if (!next.hasAttribute(attr.name)) current.removeAttribute(attr.name);
    for (const attr of next.attributes) if (current.getAttribute(attr.name) !== attr.value) current.setAttribute(attr.name, attr.value);
    if (preserveOpen !== null) current.open = preserveOpen;
    if (current.tagName === 'INPUT') {
      if (current.type === 'checkbox' || current.type === 'radio') current.checked = next.checked;
      else if (document.activeElement !== current) current.value = next.getAttribute('value') ?? '';
      return;
    }
    if (current.tagName === 'TEXTAREA') { if (document.activeElement !== current && current.value !== next.value) current.value = next.value; return; }
    rpcmPatchKids(current, next);
    if (current.tagName === 'SELECT' && document.activeElement !== current) current.value = next.value;
  }
  function rpcmPatchKids(host, template) {
    const old = [...host.childNodes], keyed = new Map(), free = [];
    for (const node of old) { const key = rpcmPatchKey(node); if (key) keyed.set(key, node); else free.push(node); }
    let freeIndex = 0; const result = [];
    for (const next of [...template.childNodes]) {
      const key = rpcmPatchKey(next), current = key ? keyed.get(key) : free[freeIndex++];
      if (current && current.nodeType === next.nodeType && current.nodeName === next.nodeName) { rpcmPatchNode(current, next); result.push(current); }
