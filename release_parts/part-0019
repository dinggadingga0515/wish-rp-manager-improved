  function rerollControlFromEventTarget(target) {
    const control = target?.closest?.('button,[role="button"],[role="menuitem"],a');
    if (!control || control.closest?.('#rpcm-overlay,#rpcm-toast-wrap,#rpcm-notice-popups,#rpcm-lib-dialog-backdrop,[data-rpcm-settings-entry="1"]')) return null;
    const label = [
      control.getAttribute?.('aria-label'),
      control.getAttribute?.('title'),
      control.getAttribute?.('data-testid'),
      control.getAttribute?.('data-action'),
      control.textContent,
    ].filter(Boolean).join(' ').replace(/\s+/g, ' ').trim().toLowerCase();
    if (!label) return null;
    return /(?:리롤|다시\s*생성|재생성|reroll|regenerate|retry\s*(?:response|answer))/.test(label) ? control : null;
  }

  function replayRerollControl(control) {
    if (!control?.isConnected || typeof control.click !== 'function') return;
    state.rerollBypassElement = control;
    try { control.click(); }
    finally {
      queueMicrotask(() => {
        if (state.rerollBypassElement === control) state.rerollBypassElement = null;
      });
    }
  }

  function activeItemsFittedForCarrier(room, pending, originalText) {
    return fitItemsToCarrierLimits(room, originalText, activePendingItems(pending));
  }

  function rpcmRerollEarlierCarrier(recent,pending){
    if(!pending||!Array.isArray(recent))return null;
    const sourceIndex=recent.findIndex(message=>messageRoleOf(message)==='assistant');
    if(sourceIndex<0)return null;
    const source=recent[sourceIndex],sourceId=String(messageIdOf(source)||'');
    const userIndex=recent.findIndex((message,index)=>index>sourceIndex&&messageRoleOf(message)==='user');
    if(!sourceId||userIndex<0)return null;
    const carrierIndex=recent.findIndex(message=>String(messageIdOf(message)||'')===String(pending.messageId||''));
    if(carrierIndex<=userIndex||messageRoleOf(recent[carrierIndex])!=='assistant')return null;
    const originUserMessageId=String(messageIdOf(recent[userIndex])||recent[userIndex]?.turnId||'');
    if(!originUserMessageId)return null;
    return {source,sourceId,originUserMessageId,carrierId:String(pending.messageId)};
  }

  async function prepareEarlierRerollCarrierNow(room,earlier){
    const p=room.pending,epoch=state.routeEpoch,before=rpcmRoomClone(p);let expectedTarget=rpcmCarrierTargetSignature(p);
    const assertCurrent=()=>{if(!rpcmCarrierScopeCurrent(room,epoch)||rpcmCarrierTargetSignature(room.pending)!==expectedTarget)throw rpcmHistoryStale('리롤 준비 중 방이나 주입 대상이 바뀌었습니다.');};
    if(p.rerollRecovery)throw new Error('이전 리롤의 원문 복구 확인이 남아 있습니다. 복구 자료를 보존했습니다.');
    assertCurrent();
    const source=await fetchMessage(apiChatIdOf(room),earlier.sourceId);
    assertCurrent();
    if(!source||messageRoleOf(source)!=='assistant'||String(messageIdOf(source))!==earlier.sourceId)throw new Error('리롤 대상 AI 답변을 서버에서 확인하지 못했습니다.');
    if(rpcmResponseIsGenerating(source))throw new Error('리롤 대상 답변이 아직 생성 중입니다.');
    const sourceRaw=messageTextOf(source),sourceParts=stripOurContextBlock(sourceRaw);
    if(!sourceParts.found&&(sourceRaw.includes(APP.markerStart)||sourceRaw.includes(APP.legacyMarkerStart)))throw new Error('리롤 대상의 숨김 주입 구획이 손상되어 원문을 보존했습니다.');
    const sourceOriginal=sourceParts.found?sourceParts.text:sourceRaw;
    const live=await carrierOriginalFromServer(room,p);assertCurrent();
    if(!live.currentText)throw new Error('리롤에 사용할 이전 AI 답변 원문을 확인하지 못했습니다.');
    let active=clonePendingItems(activeItemsFittedForCarrier(room,p,live.original)),block=buildContextBlockFromItems(active);
    if(!block)throw new Error('리롤에 사용할 활성 주입 항목이 없습니다.');
    let injected=buildInjectedMessage(live.original,block);
    const reuseVerified=!!p.verified&&normalizeLineBreaks(live.currentText)===normalizeLineBreaks(injected)
      &&normalizeLineBreaks(String(p.lastVerifiedContextBlock||p.contextBlock||''))===normalizeLineBreaks(block);
    let storedEncoding=reuseVerified?String(p.carrierEncoding||''):'';
    let metrics=reuseVerified&&storedEncoding&&Number(p.carrierPayloadBytes)>0
      ? {...carrierRequestMetrics(injected),encoding:storedEncoding,payloadBytes:Number(p.carrierPayloadBytes),messageBytes:Number(p.carrierMessageBytes)||utf8ByteLength(injected)}
      : assertCarrierRequestWithinLimits(room,injected,'리롤 이전 carrier 총 길이');
    let carrierWriteAttempted=false,sourceRestoreAttempted=false;
    try{
      // The existing carrier is already before the USER input. It need not
      // visit the answer being discarded, even when that answer is empty.
      if(normalizeLineBreaks(live.currentText)!==normalizeLineBreaks(injected)){
        assertCurrent();carrierWriteAttempted=true;
        const wire=await rpcmWriteOptionalMemos(room,p.messageId,live.original,active,{expectedText:live.currentText,epoch});active=wire.items;block=wire.block;injected=wire.text;metrics=wire.metrics;storedEncoding=wire.writeReceipt?.carrierEncoding||'';
      }
      const next={...p,originalText:live.original,contextBlock:block,items:clonePendingItems(active),injectedChars:block.length,
        originalChars:live.original.length,carrierChars:injected.length,carrierMessageBytes:metrics.messageBytes,carrierPayloadBytes:metrics.payloadBytes,carrierEncoding:storedEncoding,
        baselineAssistantId:earlier.sourceId,armedAt:Date.now(),carrierArmedAt:Date.now(),verified:false,verifiedAt:null,
        reroll:{sourceMessageId:earlier.sourceId,sourceOriginalText:sourceOriginal,originUserMessageId:earlier.originUserMessageId,bridgeMessageId:earlier.carrierId,startedAt:Date.now()}};
      const verification=await verifyInjectedCarrier(room,next,injected);assertCurrent();
      if(!verification.verified)throw new Error('이전 AI 답변의 리롤용 주입을 서버에서 확인하지 못했습니다.');
      // A failed/empty source contains no context and is never overwritten.
      if(sourceParts.found){
        const sourceNow=await fetchMessage(apiChatIdOf(room),earlier.sourceId);assertCurrent();
        if(normalizeLineBreaks(messageTextOf(sourceNow))!==normalizeLineBreaks(sourceRaw))throw rpcmHistoryStale('리롤 대상 원문이 준비 중 수정되어 최신 원문을 보존했습니다.');
        sourceRestoreAttempted=true;await restoreCarrierOnly(room,{...p,messageId:earlier.sourceId,originalText:sourceOriginal});assertCurrent();
      }
      const currentEarlier=rpcmRerollEarlierCarrier(await fetchRecentMessages(apiChatIdOf(room),50),room.pending);assertCurrent();
      if(!currentEarlier||currentEarlier.sourceId!==earlier.sourceId||currentEarlier.originUserMessageId!==earlier.originUserMessageId||rpcmResponseIsGenerating(currentEarlier.source))throw rpcmHistoryStale('리롤 준비 중 대상 답변이나 USER 입력이 바뀌었습니다.');
      if(normalizeLineBreaks(stripOurContextBlock(messageTextOf(currentEarlier.source)).text)!==normalizeLineBreaks(sourceOriginal))throw rpcmHistoryStale('리롤 준비 중 대상 답변 본문이 바뀌어 최신 원문을 보존했습니다.');
      next.verified=true;next.verifiedAt=Date.now();next.serverChars=verification.serverChars;
      delete next.reanchorRetry;
      const needsResync=rpcmMergeVerifiedCarrierPending(room,p,before,next,active,block);
      expectedTarget=rpcmCarrierTargetSignature(room.pending);
      savePendingBackup(room.chatId,room.pending);await saveRoom(room);
      if(needsResync)await syncPendingCarrierNow(room,'reroll-earlier-late-edits');
      assertCurrent();sanitizeRenderedContextSoon();
      return {prepared:true,bridgeId:earlier.carrierId,sourceId:earlier.sourceId,reusedEarlierCarrier:true};
    }catch(error){
      const errors=[];
      if(rpcmCarrierScopeCurrent(room,epoch)&&rpcmCarrierTargetSignature(room.pending)===expectedTarget){
        if(carrierWriteAttempted){try{
          const current=messageTextOf(await fetchMessage(apiChatIdOf(room),earlier.carrierId));
          if(normalizeLineBreaks(current)!==normalizeLineBreaks(live.currentText)){
            if(normalizeLineBreaks(current)!==normalizeLineBreaks(injected))throw new Error('이전 carrier가 외부에서 수정되어 롤백 덮어쓰기를 보류했습니다.');
            await patchMessage(apiChatIdOf(room),earlier.carrierId,live.currentText,{rollback:true,expectedText:current});
          }
          const restored=await fetchMessage(apiChatIdOf(room),earlier.carrierId);if(normalizeLineBreaks(messageTextOf(restored))!==normalizeLineBreaks(live.currentText))throw new Error('이전 carrier 롤백 확인 실패');
        }catch(e){errors.push(e.message);}}
        if(sourceRestoreAttempted){try{
          const current=messageTextOf(await fetchMessage(apiChatIdOf(room),earlier.sourceId));
          if(normalizeLineBreaks(current)!==normalizeLineBreaks(sourceRaw)){
            if(normalizeLineBreaks(current)!==normalizeLineBreaks(sourceOriginal))throw new Error('리롤 대상이 외부에서 수정되어 롤백 덮어쓰기를 보류했습니다.');
            await patchMessage(apiChatIdOf(room),earlier.sourceId,sourceRaw,{rollback:true,expectedText:current});
          }
          const restored=await fetchMessage(apiChatIdOf(room),earlier.sourceId);if(normalizeLineBreaks(messageTextOf(restored))!==normalizeLineBreaks(sourceRaw))throw new Error('리롤 대상 원문 롤백 확인 실패');
        }catch(e){errors.push(e.message);}}
        const rolled=rpcmKeepLateEdits(before,room.pending,before);
        rolled.messageId=before.messageId;rolled.originalText=before.originalText;rolled.baselineAssistantId=before.baselineAssistantId;
        for(const key of ['contextBlock','injectedChars','originalChars','carrierChars','carrierMessageBytes','carrierPayloadBytes','carrierEncoding','serverChars','armedAt','carrierArmedAt']){
          if(Object.hasOwn(before,key))rolled[key]=rpcmRoomClone(before[key]);else delete rolled[key];
        }
        stampVerifiedPendingSnapshot(rolled,before.lastVerifiedItems||before.items,before.lastVerifiedContextBlock||before.contextBlock||'');
        if(before.reroll)rolled.reroll=rpcmRoomClone(before.reroll);else delete rolled.reroll;
        if(before.reanchorRetry)rolled.reanchorRetry=rpcmRoomClone(before.reanchorRetry);else delete rolled.reanchorRetry;
        rolled.verified=errors.length===0&&normalizeLineBreaks(live.currentText)===normalizeLineBreaks(injected)&&rpcmCarrierItemsSignature(activePendingItems(rolled))===rpcmCarrierItemsSignature(active);
        if(!rolled.verified)rolled.verifiedAt=null;
        if(errors.length)rolled.rerollRecovery={bridgeId:earlier.carrierId,bridgeOriginal:live.original,sourceMessageId:earlier.sourceId,sourceOriginal,errors,at:Date.now()};
        room.pending=rolled;const persistenceError=await rpcmPersistRerollRecovery(room,rolled);if(persistenceError)error.message+=' · '+persistenceError
      }
      if(errors.length){error.message+=' · 복구 재검증 미완료: '+errors.join(' · ');error.rpcmCarrierNeedsRollback=true;}
      throw error;
    }
  }

  async function settleCarrierBeforeReroll(room, maxWaitMs = 9000) {
    const deadline = Date.now() + Math.max(2000, Number(maxWaitMs) || 9000);
    let lastError = null;
    while (Date.now() < deadline) {
      if (!room?.pending) return { active:false };
      if (state.recovering) {
        await sleep(250);
        continue;
      }
      // Reuse a carrier before the latest USER input; do not force a move
      // into a failed/empty answer which is about to be discarded.
      const rerollRecent=await fetchRecentMessages(apiChatIdOf(room),50);
      if(rpcmRerollEarlierCarrier(rerollRecent,room.pending))return {active:true,messageId:String(room.pending.messageId),earlierCarrier:true};
      if (room.pending.reroll) {
        try { await checkPendingRoom(room); }
        catch (error) { lastError = error; }
        if (room.pending?.reroll) {
          await sleep(450);
          continue;
        }
      }

      const recent = await fetchRecentMessages(apiChatIdOf(room), 50);
      const latestAssistant = recent.find(message => messageRoleOf(message) === 'assistant');
      const latestId = messageIdOf(latestAssistant);
      if (!latestId) throw new Error('최근 AI 답변을 찾지 못했습니다.');
      if (String(latestId) !== String(room.pending.messageId || '')) {
        try {
          await reanchorAfterResponse(room, latestAssistant, { countTurn:false, reason:'reroll-sync' });
        } catch (error) {
          lastError = error;
          await sleep(450);
          continue;
        }
      }
      if (!room.pending) return { active:false };
      if (!room.pending.reroll && String(room.pending.messageId || '') === String(latestId)) {
        return { active:true, messageId:String(latestId) };
      }
      await sleep(350);
    }
    throw new Error(`이전 리롤의 주입 이동이 아직 끝나지 않았습니다.${lastError?.message ? ` · ${lastError.message}` : ''}`);
  }

  async function prepareRerollBridgeNow(room) {
    const p = room?.pending;
    if (!p) return { prepared: false, reason: 'inactive' };

    const recent = await fetchRecentMessages(apiChatIdOf(room), 50);
    const latestForReroll=recent.find(message=>messageRoleOf(message)==='assistant');
    if(p.reroll||String(messageIdOf(latestForReroll)||'')!==String(p.messageId||'')){
      const earlier=rpcmRerollEarlierCarrier(recent,p);
      if(earlier)return prepareEarlierRerollCarrierNow(room,earlier);
      if(p.reroll)throw new Error('이전 리롤을 처리 중입니다. 잠시 뒤 다시 눌러 주세요.');
    }
    const sourceIndex = recent.findIndex(m => String(messageIdOf(m) || '') === String(p.messageId || ''));
    if (sourceIndex < 0 || messageRoleOf(recent[sourceIndex]) !== 'assistant') {
      throw new Error('리롤할 최신 AI 답변을 서버에서 찾지 못했습니다.');
    }
    const latestAssistant = recent.find(m => messageRoleOf(m) === 'assistant');
    if (String(messageIdOf(latestAssistant) || '') !== String(p.messageId || '')) {
      throw new Error('주입 위치가 최신 답변과 달라 먼저 자동 이동을 기다려야 합니다.');
    }

    const sourceLive = await carrierOriginalFromServer(room, p);
    if (!sourceLive.currentText) throw new Error('리롤할 AI 답변 원문을 읽지 못했습니다.');
    const sourceOriginal = sourceLive.original;
    const maxChars = Number(room.maxChars) || APP.defaultMaxChars;
    const originUserIndex = recent.findIndex((message, index) => index > sourceIndex && messageRoleOf(message) === 'user');
    if (originUserIndex < 0) throw new Error('리롤 대상 USER 입력을 서버 기록에서 찾지 못했습니다.');
    const originUserMessageId = String(messageIdOf(recent[originUserIndex]) || recent[originUserIndex]?.turnId || '');
    let bridgeMessage = null;
    let bridgeOriginal = '';
    let bridgeItems = [];
    let contextBlock = '';
    let injectedText = '';

    // 같은 USER 입력에서 갈라진 이전 리롤 답변은 새 답변의 생성 문맥에 포함되지 않습니다.
    // 따라서 반드시 리롤 대상 USER 입력보다 앞에 있는 AI 답변을 임시 carrier로 사용합니다.
    // 길이 제한에 걸리면 한 단계 더 오래된 AI 답변을 찾습니다.
    for (const candidate of recent.slice(originUserIndex + 1)) {
      if (messageRoleOf(candidate) !== 'assistant' || !messageIdOf(candidate)) continue;
      const raw = messageTextOf(candidate);
      if (!raw) continue;
      const candidateContext=stripOurContextBlock(raw);
      if(!candidateContext.found&&(raw.includes(APP.markerStart)||raw.includes(APP.legacyMarkerStart)))continue;
      const clean=candidateContext.text||raw;
      const items = activeItemsFittedForCarrier(room, p, clean);
      const block = buildContextBlockFromItems(items);
      const injected = block ? buildInjectedMessage(clean, block) : '';
      if (!block || injected.length > maxChars || !carrierRequestWithinLimits(room, injected)) continue;
      bridgeMessage = candidate;
      bridgeOriginal = clean;
      bridgeItems = items;
      contextBlock = block;
      injectedText = injected;
      break;
    }
    if (!bridgeMessage) throw new Error('리롤용 컨텍스트를 옮길 이전 AI 답변을 찾지 못했습니다.');

    const bridgeId = messageIdOf(bridgeMessage);
    const previousPending=rpcmRoomClone(p);bridgeItems=clonePendingItems(bridgeItems);
    const rerollEpoch=state.routeEpoch;
    const assertRerollCurrent=()=>{if(!rpcmCarrierScopeCurrent(room,rerollEpoch)||room.pending!==p)throw rpcmHistoryStale('리롤 준비 중 방이나 주입 대상이 바뀌었습니다. 다시 확인해 주세요.');};
    let bridgeWriteAttempted=false,sourceRestoreAttempted=false;
    let bridgeInjected = false;
    let sourceRestored = false;
    try {
      assertRerollCurrent();bridgeWriteAttempted=true;
      const wire=await rpcmWriteOptionalMemos(room,bridgeId,bridgeOriginal,bridgeItems,{expectedText:messageTextOf(bridgeMessage),epoch:rerollEpoch});bridgeItems=wire.items;contextBlock=wire.block;injectedText=wire.text;
      const bridgePending = { ...p, messageId: bridgeId, originalText: bridgeOriginal };
      const verification = await verifyInjectedCarrier(room, bridgePending, injectedText);
      if (!verification.verified) throw new Error('리롤용 이전 답변에 숨김 컨텍스트를 붙이지 못했습니다.');
      bridgeInjected = true;

      assertRerollCurrent();sourceRestoreAttempted=true;await restoreCarrierOnly(room,p);
      sourceRestored = true;

      const nextPending = {
        ...p,
        messageId: bridgeId,
        originalText: bridgeOriginal,
        baselineAssistantId: String(p.messageId),
        armedAt: Date.now(),
        carrierArmedAt: Date.now(),
        contextBlock,
        injectedChars: contextBlock.length,
        originalChars: bridgeOriginal.length,
        carrierChars: injectedText.length,
        carrierMessageBytes: wire.metrics.messageBytes,
        carrierPayloadBytes: wire.metrics.payloadBytes,
        carrierEncoding:wire.writeReceipt?.carrierEncoding||'',
        serverChars: verification.serverChars,
        verified: true,
        verifiedAt: Date.now(),
        reroll: {
          sourceMessageId: String(p.messageId),
          sourceOriginalText: sourceOriginal,
          originUserMessageId,
          bridgeMessageId: String(bridgeId),
          startedAt: Date.now(),
        },
      };
      // 예산에 맞춰 임시 carrier에 들어간 항목만 유지합니다. 유지 횟수 값은 그대로입니다.
      nextPending.items = clonePendingItems(bridgeItems);
      stampVerifiedPendingSnapshot(nextPending, bridgeItems, contextBlock);
      const needsResync=rpcmMergeVerifiedCarrierPending(room,p,previousPending,nextPending,bridgeItems,contextBlock);
      savePendingBackup(room.chatId,room.pending);
      await saveRoom(room);
      if (room.chatId === state.currentChatId) state.currentRoom = room;
      if(needsResync)await syncPendingCarrierNow(room,'reroll-late-edits');
      sanitizeRenderedContextSoon();
      return { prepared: true, bridgeId, sourceId: p.messageId };
    } catch (error) {
      const recoveryErrors=[];
      if(bridgeWriteAttempted){
        try{
          await patchMessage(apiChatIdOf(room),bridgeId,bridgeOriginal,{rollback:true});
          if(!(await verifyCarrierClean(room,bridgeId,bridgeOriginal)).clean)throw new Error('임시 리롤 carrier 원문 복원 재검증 실패');
        }catch(recoveryError){recoveryErrors.push(recoveryError.message);}
      }
      let sourceVerified=!sourceRestoreAttempted&&!!previousPending.verified;
      if(sourceRestoreAttempted){
        try{
          const block=String(previousPending.lastVerifiedContextBlock||previousPending.contextBlock||buildContextBlockFromItems(activePendingItems(previousPending)));
          const text=buildInjectedMessage(sourceOriginal,block);
          await patchMessage(apiChatIdOf(room),previousPending.messageId,text,{rollback:true});
          sourceVerified=!!(await verifyInjectedCarrier(room,{...previousPending,originalText:sourceOriginal},text)).verified;
          if(!sourceVerified)throw new Error('기존 리롤 carrier 복원 재검증 실패');
        }catch(recoveryError){sourceVerified=false;recoveryErrors.push(recoveryError.message);}
      }
      const live=room.pending;
      if(live&&(String(live.messageId)===String(p.messageId)||String(live.messageId)===String(bridgeId))){
        const rolled=rpcmKeepLateEdits(previousPending,live,previousPending);
        rolled.messageId=previousPending.messageId;rolled.originalText=previousPending.originalText;
        rolled.reroll=previousPending.reroll;
        const actual=previousPending.lastVerifiedItems||previousPending.items;
        stampVerifiedPendingSnapshot(rolled,actual,previousPending.lastVerifiedContextBlock||previousPending.contextBlock||'');
        rolled.verified=sourceVerified&&JSON.stringify(activePendingItems(rolled))===JSON.stringify(actual);
        if(!rolled.verified)rolled.verifiedAt=null;
        if(recoveryErrors.length)rolled.rerollRecovery={bridgeId,bridgeOriginal,sourceMessageId:p.messageId,sourceOriginal,errors:recoveryErrors,at:Date.now()};
        room.pending=rolled;const persistenceError=await rpcmPersistRerollRecovery(room,rolled);
        if(persistenceError)error.message+=' · '+persistenceError
      }
      if(recoveryErrors.length){error.message+=' · 복구 재검증 미완료: '+recoveryErrors.join(' · ');error.rpcmCarrierNeedsRollback=true;}
      throw error;
    }
  }

  function prepareRerollBridge(room) {
    const target=rpcmCarrierTargetSignature(room?.pending);
    return queuePendingCarrierOperation(room, () => {
      if(rpcmCarrierTargetSignature(room?.pending)!==target)throw rpcmHistoryStale('대기 중 리롤 대상이 바뀌었습니다. 최신 답변에서 다시 눌러 주세요.');
      return prepareRerollBridgeNow(room);
    },{label:'리롤 준비'});
  }

  function bindRerollBridge() {
    if (state.rerollClickBound) return;
    state.rerollClickBound = true;
    document.addEventListener('click', event => {
      const control = rerollControlFromEventTarget(event.target);
      if (!control) return;
      if (state.rerollBypassElement === control) {
        state.rerollBypassElement = null;
        return;
      }
      const room = state.currentRoom;
      if (!room?.pending) return;

      event.preventDefault();
      event.stopPropagation();
      event.stopImmediatePropagation();
      if (state.rerollPreparing) {
        notify('리롤용 컨텍스트를 준비 중입니다. 잠시 뒤 다시 눌러 주세요.', 'warn', 4200);
        return;
      }

      state.rerollPreparing = true;
      (async () => {
        let prepared = false;
        let replay = false;
        try {
          const settled = await settleCarrierBeforeReroll(room);
          if (!settled.active) {
            replay = true;
            return;
          }
          const result = await prepareRerollBridge(room);
          prepared = !!result.prepared;
          replay = prepared;
        } catch (e) {
          console.warn('[RP매니저] reroll bridge preparation failed:', e);
          notify(`리롤을 잠시 멈췄습니다 · 주입문 없이 재생성하지 않도록 보호했습니다. 다시 눌러 주세요: ${e.message}`, 'warn', 7000);
        } finally {
          state.rerollPreparing = false;
          if (replay) replayRerollControl(control);
          if (prepared) scheduleRecovery(800);
        }
      })();
    }, true);
  }

  function rpcmCarrierWriteRead(room,messageId,expectedText,receipt) {
    const saved=receipt&&typeof receipt==='object'?rpcmCarrierWriteProofs.get(receipt):null;
    if(!saved)return null;
    rpcmCarrierWriteProofs.delete(receipt);
    if(saved.room!==room||saved.chatId!==String(apiChatIdOf(room))||saved.messageId!==String(messageId)||saved.text!==String(expectedText)||receipt.text!==saved.text||saved.epoch!==state.routeEpoch||saved.revision!==rpcmCarrierRevision(room))return null;
    return {content:saved.text};
  }

  function rpcmDeferCarrierCleanup(room) {
    room.carrierCleanup=(room.carrierCleanup||[]).filter(x=>String(x.messageId)!==String(room.pending?.messageId||''));
    if(room.carrierCleanup.length)room.carrierCleanupRetryAt=Date.now()+APP.activePollMs;
  }

  function rpcmStampCarrierTiming(room,operation,startedAt,preparedAt,receipt) {
    room.carrierTiming={operation,at:nowIso(),startedAt,outcome:operation==='해제'?'stopped':'verified',prepareMs:Math.max(0,preparedAt-startedAt),writeMs:Math.max(0,Date.now()-preparedAt),cleanupMs:0,writeGET:Number(receipt?.timing?.GET||0),writePATCH:Number(receipt?.timing?.PATCH||0),cleanupGET:0,cleanupPATCH:0,cleanupState:room.carrierCleanup?.length?'pending':'clean'};
  }

  async function verifyInjectedCarrier(room, pending, expectedText, attempts = 4, writeReceipt = null) {
    const reused=rpcmCarrierWriteRead(room,pending.messageId,expectedText,writeReceipt);
    let lastText = '';
    for (let i = 0; i < attempts; i++) {
      if (i) await sleep([300, 650, 1100, 1600][Math.min(i - 1, 3)]);
      const current = i===0&&reused?reused:await fetchMessage(apiChatIdOf(room), pending.messageId);
      if (!current) continue;
      const text = messageTextOf(current);
      lastText = text;
      const hasMarkers = text.includes(APP.markerStart) && text.includes(APP.markerEnd);
      const stripped = stripOurContextBlock(text);
      const originalMatches = stripped.found && normalizeLineBreaks(stripped.text) === normalizeLineBreaks(String(pending.originalText || '').replace(/\s+$/, ''));
      const exactMatches = normalizeLineBreaks(text) === normalizeLineBreaks(expectedText);
      if (hasMarkers && originalMatches && exactMatches) {
        return { verified: true, serverChars: text.length, text };
      }
    }
    return { verified: false, serverChars: lastText.length, text: lastText };
  }

  async function reverifyPending(room, options = {}) {
    if (options.recoverLatest === true) await checkPendingRoom(room, {manual:true,expectedLatestId:options.expectedLatestId});
    return queuePendingCarrierOperation(room,async()=>{
      const p = room.pending;
      if (!p) throw new Error('현재 예약된 임시 주입이 없습니다.');
      const verifyEpoch=state.routeEpoch,target=rpcmCarrierTargetSignature(p);
      const assertCurrent=(samePending=true)=>{if(!rpcmCarrierScopeCurrent(room,verifyEpoch)||rpcmCarrierTargetSignature(room.pending)!==target||(samePending&&room.pending!==p))throw rpcmHistoryStale('주입 확인 중 방·주입 대상이 바뀌었습니다.');};
      const current = await fetchMessage(apiChatIdOf(room), p.messageId);
      assertCurrent();
