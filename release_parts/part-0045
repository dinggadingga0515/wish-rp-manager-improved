    markProcessed(target);
    setReviewGate(target,'skipped');
    rememberAutoObservedId(target);
    const key=messageAutoKey(target);
    if(autoFailureKey===key){autoReviewRetryPermit=false;autoFailureKey='';autoFailureCount=0;}
    if(lastAutoAssistantKey===key||autoObservedStableId===messageStableId(target)||!autoObservedStableId)lastAutoAssistantKey=key;
    // Hiding the badge does not dismiss its persisted error receipt.
    // Match the displayed failure so a different response's notice survives.
    const receipt=loadReviewReceipt();
    if(failureReceipt&&receipt&&!receipt.dismissedAt&&receipt.kind==='error'
      &&(!receipt.messageId||String(receipt.messageId)===String(target.id))
      &&receipt.title===failureReceipt.title&&receipt.detail===failureReceipt.detail) dismissReviewReceipt();
    const keys=new Set(['proposal','error','stale','ambiguous'].map(kind=>`refiner:${kind}:${target.id}`));
    for(const node of document.querySelectorAll?.('#rpcm-notice-popups [data-popup-key]')||[]){
      if(scope.startsWith('chat:')&&node.dataset.room===scope.slice(5)&&keys.has(node.dataset.popupKey))node.remove();
    }
    addProcessHistory('검토 종료','사용자가 닫기 또는 교정 없이 계속을 선택하여 이 응답의 자동 검토를 종료했습니다.',{target});
    return true;
  }

