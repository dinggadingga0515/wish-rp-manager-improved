      console.log(`[위시RPManager] ${APP.name} v${APP.version} loaded`);
    } catch (e) {
      wrpmStartup.fail(e);
      console.error('[RP매니저] init failed', e);
      notify(`🪽위시 RP Manager 초기화 실패: ${e.message}`, 'error', 7000);
    }
  }

