  async function primeBaseline(){
    if(!settings.enabled){autoPrimeEpoch++;autoBaselineReady=true;autoCheckQueued=false;clearTimeout(debounceTimer);debounceTimer=null;return;}
    if(rpcmRefinerReadGate()){autoBaselineReady=false;autoBaselineReadSucceeded=false;return;}
    const epoch=++autoPrimeEpoch,readScope=rpcmRefinerReadContext();
    autoBaselineReady=false;autoBaselineReadSucceeded=false;autoGenerationEvidence=null;autoReviewRetryPermit=false;
    let authMissing=false;
    try{
      if(!getAuthToken()){authMissing=true;setStatus('Crack 인증정보 대기');return;}
      const last=await findLastAssistant();
      if(epoch!==autoPrimeEpoch)return;
      autoBaselineReadSucceeded=true;
      const pending=!!last&&isPendingResponse(last);
      baselineFingerprint=pending?'':messageFingerprint(last);
      autoObservedStableId=messageStableId(last);
      if(last)rememberAutoObservedId(last);
      lastAutoAssistantKey=messageAutoKey(last);
      // An in-flight generation is the one exception: wait for its completion.
      // Pre-existing unreviewed responses are not billed merely due to refresh/navigation.
      if(pending){signalAutoGeneration('server-pending',autoObservedStableId);autoCheckQueued=true;}
      else autoCheckQueued=false;
      autoCheckWaits=0;
      if(last&&!pending&&!isProcessed(last))setReviewGate(last,'skipped');
    }catch(error){
      if(!rpcmRefinerReadCurrent(readScope))return;
      baselineFingerprint='';lastAutoAssistantKey='';autoObservedStableId='';autoBaselineReadSucceeded=false;
      const policy=rpcmRefinerReadPolicy(error);rpcmRefinerHoldRead(policy,readScope);
      if(policy.kind==='auth'){
        authMissing=true;setStatus('Crack 인증정보 대기');
      }else{
        setStatus('응답 조회 실패 · 수동 검수에서 확인','error');
        showReviewNotice('응답 조회 실패',String(error.message||error)+' · 수동 검수 버튼으로 다시 확인해 주세요.','error',6000);
      }
    }finally{
      if(epoch===autoPrimeEpoch){autoBaselineReady=rpcmRefinerReadCurrent(readScope)&&!authMissing;if(autoCheckQueued&&autoBaselineReady)scheduleAutoCheck(250);}
    }
  }

  function handleRouteBaselineChange() {
    lastKnownPath = location.href;
    if(rpcmAutoReadHolds.get(chatStateKey())?.kind==='stop')rpcmAutoReadHolds.delete(chatStateKey());
    if(deferredRefinerReload&&deferredRefinerReload.scope!==chatStateKey())clearDeferredRefinerReload();
    clearTimeout(debounceTimer);autoCheckQueued=false;autoCheckWaits=0;lastAutoHeartbeatAt=0;autoGenerationEvidence=null;autoReviewRetryPermit=false;
    autoBaselineReady = false;
    void primeBaseline();
  }

  function startObserver() {
    document.addEventListener('click',observeCrackGenerationAction,true);
    mutationObserver?.disconnect();
    mutationObserver = new MutationObserver(mutations => {
      if(document.hidden)return;
      if (location.href !== lastKnownPath) {
        handleRouteBaselineChange();
        return;
      }
      const own=node=>{const el=node?.nodeType===Node.ELEMENT_NODE?node:node?.parentElement;return !!el?.closest?.('[id^="rpcm-"],[id^="wish-rpcore-"],.wish-rpcore-refiner-ui,.rpcm-ltm-backdrop,script,style');};
      if(mutations.every(m=>own(m.target)||(m.type==='childList'&&[...m.addedNodes,...m.removedNodes].every(own))))return;
      scheduleAutoCheck();
    });
    mutationObserver.observe(document.body, { childList: true, subtree: true, characterData: true });
    setInterval(() => {
      if (location.href !== lastKnownPath) { handleRouteBaselineChange(); return; }
      if(document.hidden||!settings.enabled)return;
      // TEMP25: a missing cookie is recoverable. Poll locally, without an API
      // request, then establish a fresh baseline (never auto-bill older turns).
      if(!autoBaselineReady){
        if(getAuthToken()&&!autoBaselineRecovering){
          autoBaselineRecovering=true;
          void primeBaseline().finally(()=>{autoBaselineRecovering=false;});
        }
        return;
      }
      if(!getAuthToken()){autoBaselineReady=false;autoBaselineReadSucceeded=false;return;}
      // Mutation-driven completion checks; idle heartbeat only recovers missed SPA events.
      if(workerBusy||confirmOverlay)return;
      const heartbeatDue=Date.now()-lastAutoHeartbeatAt>=(autoCheckQueued?6000:30000);
      if((autoCheckQueued||heartbeatDue)&&!debounceTimer&&!autoScanBusy){lastAutoHeartbeatAt=Date.now();scheduleAutoCheck(autoCheckQueued?0:120);}
    }, 3000);
    // 백그라운드 탭에서 응답 생성이 끝나면 MutationObserver 콜백이 의도적으로 건너뛰어집니다.
    // 다시 탭을 열 때 큐 플래그가 없더라도 최신 응답을 한 번 확인해 누락을 복구합니다.
    document.addEventListener('visibilitychange',()=>{
      if(document.hidden||!settings.enabled)return;
      if(!autoBaselineReady){
        if(getAuthToken()&&!autoBaselineRecovering){autoBaselineRecovering=true;void primeBaseline().finally(()=>{autoBaselineRecovering=false;});}
      }else if(getAuthToken()){lastAutoHeartbeatAt=Date.now();scheduleAutoCheck(0);}
    });
  }

