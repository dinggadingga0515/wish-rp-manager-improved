  function displayPreferences(){return {showButton:settings.showButton!==false,showBadge:settings.showBadge!==false,showQuickReview:settings.showQuickReview!==false};}
  window.__WISH_RP_MANAGER_REFINER__ = { isGenerating:refinerKnownGeneration, connectionInfo:()=>({model:currentModelId(),thinkingLevel:selectedThinkingLevel(),enabled:settings.enabled,refreshAfterCorrection:true}), openSettings, openFromNotice, canUseTurn:canUseReviewTurn, reviewGateSnapshot, reviewLatest: () => runRefiner({ force:true }), setDisplayPreference, displayPreferences };

