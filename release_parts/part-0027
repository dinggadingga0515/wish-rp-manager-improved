    const labels = [...document.querySelectorAll('p,span,button,[role="button"],[role="menuitem"]')].filter(node => !node.closest?.('[id^="rpcm-"],[id^="wish-rpcore-"],[data-rpcm-settings-entry="1"]') && isElementVisible(node));
