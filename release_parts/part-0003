  function rpcmMigrateSplitPalettePresets() {
    const accentKey = `${APP.palettePresetsKey}:accent:v2`;
    const surfaceKey = `${APP.palettePresetsKey}:surface:v2`;
    try {
      const accentExists = localStorage.getItem(accentKey) !== null;
      const surfaceExists = localStorage.getItem(surfaceKey) !== null;
      if (accentExists && surfaceExists) return true;
      const legacyRaw = localStorage.getItem(APP.palettePresetsKey);
      const legacy = legacyRaw === null ? [] : JSON.parse(legacyRaw);
      if (!Array.isArray(legacy)) return false;
      const defaultAccent = rpcmCurrentAccentForPicker();
      const defaultSurface = rpcmCurrentSurfaceForPicker();
      const oldRows = legacy.filter(row => row && typeof row.name === 'string').slice(0, 12);
      if (!accentExists) {
        const accents = oldRows.map(row => ({name:row.name.slice(0,32),hex:normalizeRpcmAccentHex(row.accent) || defaultAccent}));
        localStorage.setItem(accentKey, JSON.stringify(accents));
