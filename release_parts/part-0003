    if (!rpcmMigrateSplitPalettePresets()) return false;
    try {
      const sanitized = rows.slice(0,12).filter(row => row && typeof row.name === 'string' && normalizeRpcmAccentHex(row.hex))
        .map(row => kind === 'accent'
          ? {name:row.name.slice(0,32),hex:normalizeRpcmAccentHex(row.hex)}
          : {name:row.name.slice(0,32),hex:normalizeRpcmAccentHex(row.hex),intensity:normalizeRpcmSurfaceIntensity(row.intensity ?? 24)});
      localStorage.setItem(`${APP.palettePresetsKey}:${kind}:v2`, JSON.stringify(sanitized));
      return true;
    } catch (_) { return false; }
  }

  function applyRpcmPalettePreset(kind, row) {
    if (!row || !normalizeRpcmAccentHex(row.hex)) return false;
    if (kind === 'accent') {
      saveRpcmAccentTheme(row.hex);
      state.quickThemeDraftHex = '';
    } else if (kind === 'surface') {
      saveRpcmSurfaceTheme(row.hex);
      saveRpcmSurfaceIntensity(row.intensity ?? 24);
      state.quickSurfaceDraftHex = '';
    } else return false;
    return true;
  }

  function rpcmCurrentAccentForPicker() {
    const saved = loadRpcmAccentTheme();
    if (saved) return saved;
    const host = document.body || document.documentElement;
    const computed = host ? getComputedStyle(host).getPropertyValue('--wish-accent').trim() : '';
    return normalizeRpcmAccentHex(computed) || '#DF78AA';
  }

  function rpcmCurrentSurfaceForPicker() {
    const saved = loadRpcmSurfaceTheme();
    if (saved) return saved;
    const host = document.body || document.documentElement;
    const computed = host ? getComputedStyle(host).getPropertyValue('--wish-sheet').trim() : '';
    return normalizeRpcmAccentHex(computed) || '#6B4057';
